        <Item class="ModuleScript" referent="RBX00004">
          <Properties>
            <string name="Name">Actions</string>
            <ProtectedString name="Source">-- A closed action vocabulary prevents arbitrary remote names from allocating state.
return table.freeze({
    Pack = false, Sell = false, StartFold = false, FinishFold = false,
    Sync = false, Return = false,
    Upgrade = true, Equip = true, Roll = true,
})
</ProtectedString>
