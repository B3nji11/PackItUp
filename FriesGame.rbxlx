          <string name="Name">storage</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00034">
          <Properties>
            <string name="Name">ProfileStore</string>
            <ProtectedString name="Source">-- Persistence transaction rules. No Roblox globals; the store/clock are injected.
local ProfileStore = {}
ProfileStore.__index = ProfileStore
function ProfileStore.new(store, options)
    return setmetatable({ store = store, options = options, serial = 0 }, ProfileStore)
end
function ProfileStore:load(key, token)
    local o = self.options
    local lastError = "Could not load saved progress."
    for attempt = 1, o.attempts do
        local reason = nil
        local ok, result = pcall(function()
            return self.store:UpdateAsync(key, function(old)
                reason = nil
                local now = o.now()
                if old ~= nil and (type(old) ~= "table" or not o.validate(old.data)) then
                    reason = "Saved profile is invalid or uses a newer version."
                    return nil
                end
                if old and old.lease then
                    if type(old.lease) ~= "table" or type(old.lease.expires) ~= "number"
                        or old.lease.expires ~= old.lease.expires or old.lease.expires == math.huge
                        or old.lease.expires &lt; 0 or type(old.lease.token) ~= "string" then
                        reason = "Invalid saved session lock."
                        return nil
                    end
                    if old.lease.token ~= token and old.lease.expires &gt; now then
                        reason = "Your previous session is still saving. Please rejoin shortly."
                        return nil
                    end
                end
                return { data = if old then o.copy(old.data) else o.newProfile(),
                    lease = { token = token, expires = now + o.leaseSeconds }, writeId = "load:" .. token }
            end)
        end)
        if ok and result and result.lease and result.lease.token == token then
            return o.copy(result.data), result.lease.expires
        end
        lastError = reason or (if ok then "Session acquisition was cancelled." else tostring(result))
        if reason and string.find(reason, "invalid") then break end
        if attempt &lt; o.attempts then o.wait(2 ^ (attempt - 1)) end
    end
    return nil, lastError
end
function ProfileStore:save(key, token, data, release)
    local o = self.options
    if not o.validate(data) then return false, "Refusing to save invalid profile." end
    local snapshot = o.copy(data)
    self.serial += 1
    local writeId = token .. ":" .. tostring(self.serial)
    local lastError = "Could not save progress."
    for attempt = 1, o.attempts do
        local reason = nil
        local ok, result = pcall(function()
            return self.store:UpdateAsync(key, function(old)
                reason = nil
                -- A request may have committed even if its response was lost.
                if type(old) == "table" and old.writeId == writeId then return old end
                if type(old) ~= "table" or type(old.lease) ~= "table"
                    or old.lease.token ~= token or type(old.lease.expires) ~= "number"
                    or old.lease.expires &lt;= o.now() then
                    reason = "Lost session lock."
                    return nil
                end
                return { data = o.copy(snapshot), writeId = writeId,
                    lease = if release then nil else { token = token, expires = o.now() + o.leaseSeconds } }
            end)
        end)
        if ok and result and result.writeId == writeId then
            return true, if result.lease then result.lease.expires else 0
        end
        lastError = reason or tostring(result)
        if reason then break end
        if attempt &lt; o.attempts then o.wait(2 ^ (attempt - 1)) end
    end
    return false, lastError
end
return ProfileStore
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="RBX00035">
        <Properties>
          <string name="Name">world</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00036">
          <Properties>
            <string name="Name">Primitives</string>
            <ProtectedString name="Source">local Primitives = {}
function Primitives.part(parent, name, size, position, color, material)
    local part = Instance.new("Part")
    part.Name, part.Size, part.Position = name, size, position
    part.Anchored = true
    part.Color = color
    -- Smooth, untextured surfaces are the default art direction for new world pieces.
    part.Material = material or Enum.Material.SmoothPlastic
    part.Reflectance = 0
    part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    part.Parent = parent
    return part
end
function Primitives.surfaceLabel(parent, text, face, color)
    local gui = Instance.new("SurfaceGui")
    gui.Name, gui.Face = "WallArt", face
    gui.SizingMode, gui.PixelsPerStud = Enum.SurfaceGuiSizingMode.PixelsPerStud, 40
    gui.AlwaysOnTop, gui.LightInfluence = false, 0.5
    gui.Parent = parent
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.TextWrapped = true
    label.Text = text
    label.Parent = gui
    return label
end
return Primitives
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00037">
          <Properties>
            <string name="Name">StationBuilder</string>
            <ProtectedString name="Source">local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Runtime = require(Shared.config.Runtime)
local P = require(script.Parent.Primitives)
return function(parent, index, origin, yaw)
    local model = Instance.new("Model")
    model.Name, model.Parent = "Station" .. index, parent
    model:SetAttribute("OwnerUserId", 0)
    local transform = CFrame.new(origin) * CFrame.Angles(0, yaw or 0, 0)
    local function part(name, size, offset, color)
        local object = P.part(model, name, size, transform:PointToWorldSpace(offset), color)
        object.CFrame = transform * CFrame.new(offset)
        return object
    end
    local cream, coral = Color3.fromRGB(255, 247, 226), Color3.fromRGB(245, 112, 113)
    local accent = if index % 2 == 0 then Color3.fromRGB(81, 193, 181) else coral
    local wallHeight, wallBottom = 18, 0.5
    local wallCenter = wallBottom + wallHeight / 2
    local ceilingBottom = wallBottom + wallHeight
    part("Plot", Vector3.new(52, 0.4, 52), Vector3.new(0, 0.05, 0), Color3.fromRGB(141, 217, 111))
    part("RestaurantFloor", Vector3.new(42, 0.5, 34), Vector3.new(0, 0.35, -3), cream)
    part("EntrancePath", Vector3.new(12, 0.25, 12), Vector3.new(0, 0.25, 20), Color3.fromRGB(190, 137, 88))
    part("BackWall", Vector3.new(42, wallHeight, 0.8), Vector3.new(0, wallCenter, -20), cream)
    part("LeftWall", Vector3.new(0.8, wallHeight, 34), Vector3.new(-21, wallCenter, -3), cream)
    part("RightWall", Vector3.new(0.8, wallHeight, 34), Vector3.new(21, wallCenter, -3), cream)
    -- A high ceiling meets the walls while leaving the frontage open for entry.
    part("Ceiling", Vector3.new(44, 1, 36), Vector3.new(0, ceilingBottom + 0.5, -3), cream)
    part("RoofCap", Vector3.new(44.5, 0.4, 36.5), Vector3.new(0, ceilingBottom + 1.2, -3), accent)
    part("Fascia", Vector3.new(43, 3.25, 1.2), Vector3.new(0, ceilingBottom - 1.625, 14), accent)
    for _, x in ipairs({-20, 20}) do
        part("FrontPost", Vector3.new(1, wallHeight, 1), Vector3.new(x, wallCenter, 14), accent)
        part("Hedge", Vector3.new(1.5, 2, 50), Vector3.new(x / 20 * 25, 1.3, 0), Color3.fromRGB(73, 178, 51))
    end
    for n = 1, 10 do
        part("AwningStripe" .. n, Vector3.new(4.2, 0.3, 4), Vector3.new(-23.1 + n * 4.2, ceilingBottom - 0.7, 13),
            if n % 2 == 0 then cream else accent)
    end
    local plaque = part("RestaurantPlaque", Vector3.new(15, 2, 0.2), Vector3.new(0, ceilingBottom - 2, 14.7), accent)
    local sign = P.surfaceLabel(plaque, "RESTAURANT " .. index .. "\nAVAILABLE", Enum.NormalId.Back, cream)
    local claimPart = part("ClaimPoint", Vector3.new(0.5, 0.5, 0.5), Vector3.new(0, 3, 18), accent)
    claimPart.Transparency, claimPart.CanCollide = 1, false
    local prompt = Instance.new("ProximityPrompt")
    prompt.Name, prompt.ActionText, prompt.ObjectText = "ClaimRestaurant", "Claim restaurant", "Restaurant " .. index
    prompt.KeyboardKeyCode, prompt.GamepadKeyCode = Enum.KeyCode.E, Enum.KeyCode.ButtonX
    prompt.HoldDuration, prompt.MaxActivationDistance = 0, Runtime.ClaimDistance
    prompt.RequiresLineOfSight, prompt.ClickablePrompt, prompt.Enabled = false, true, true
    prompt.Parent = claimPart

    -- Four broad downward lights cover the work area, dining tables, and entrance.
    -- Unshadowed local lighting keeps the cartoon interior soft and limits rendering cost.
    local fixtureIndex = 0
    for _, x in ipairs({-10, 10}) do
        for _, z in ipairs({-11, 6}) do
            fixtureIndex += 1
            local trim = part("LightTrim" .. fixtureIndex, Vector3.new(6.8, 0.3, 3.8),
                Vector3.new(x, ceilingBottom - 0.15, z), Color3.fromRGB(189, 212, 230))
            local panel = part("LightPanel" .. fixtureIndex, Vector3.new(6, 0.15, 3),
                Vector3.new(x, ceilingBottom - 0.375, z), Color3.fromRGB(255, 251, 235))
            for _, piece in ipairs({trim, panel}) do
                piece.CanCollide, piece.CanTouch, piece.CanQuery, piece.CastShadow = false, false, false, false
            end
            local light = Instance.new("SurfaceLight")
            light.Name, light.Face = "InteriorLight", Enum.NormalId.Bottom
            light.Color = Color3.fromRGB(255, 244, 225)
            light.Brightness, light.Range, light.Angle = 0.8, 28, 140
            light.Shadows, light.Enabled, light.Parent = false, true, panel
        end
    end

    part("Counter", Vector3.new(16, 3, 3), Vector3.new(0, 2, -1), accent)
    part("Worktop", Vector3.new(16.5, 0.3, 3.5), Vector3.new(0, 3.65, -1), cream)
    local machine = part("Machine", Vector3.new(3, 2.2, 2.4), Vector3.new(-3.5, 4.9, -1), Color3.fromRGB(189, 212, 230))
    part("MachineScreen", Vector3.new(1.8, 0.7, 0.1), Vector3.new(-3.5, 5.1, 0.25), Color3.fromRGB(126, 245, 215))
    part("FryerBasket", Vector3.new(2.3, 0.15, 1.6), Vector3.new(-3.5, 6.1, -1), Color3.fromRGB(103, 137, 163))
    local bag = part("Bag", Vector3.new(1.8, 1.7, 1.3), Vector3.new(1, 4.65, -1), Color3.fromRGB(245, 195, 106))
    local fries = {}
    for n = 1, 10 do
        local fry = part("Fry" .. n, Vector3.new(0.22, 1.2 + n % 3 * 0.15, 0.22),
            Vector3.new(0.4 + (n - 1) % 5 * 0.29, 5.35, -1.3 + math.floor((n - 1) / 5) * 0.5),
            Color3.fromRGB(255, 208, 63))
        fry.CanCollide, fry.Transparency = false, 1
        table.insert(fries, fry)
    end
    -- No floating equipment labels, including on future fryers.
    part("CustomerBody", Vector3.new(1.8, 2.4, 1), Vector3.new(3.5, 2.8, -5), Color3.fromRGB(96, 190, 239))
    local head = part("CustomerHead", Vector3.new(1.4, 1.4, 1.4), Vector3.new(3.5, 4.7, -5), Color3.fromRGB(255, 205, 163))
    head.Shape = Enum.PartType.Ball
    for _, x in ipairs({3, 4}) do
        part("CustomerLeg", Vector3.new(0.7, 1.4, 0.8), Vector3.new(x, 1.2, -5), Color3.fromRGB(71, 94, 139))
    end
    for _, x in ipairs({-14, 14}) do
        part("DiningTable", Vector3.new(6, 0.4, 5), Vector3.new(x, 3, -11), Color3.fromRGB(255, 221, 158))
        part("TableBase", Vector3.new(1, 2.5, 1), Vector3.new(x, 1.6, -11), accent)
        for _, z in ipairs({-15, -7}) do
            part("DiningBench", Vector3.new(6, 1.6, 1.5), Vector3.new(x, 1.3, z), accent)
        end
    end
    return { model = model, index = index, origin = origin, spawn = transform * CFrame.new(Vector3.new(0, 4, 4)),
        machine = machine, bag = bag, fries = fries, sign = sign, claimPart = claimPart, prompt = prompt }
end
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00038">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <ProtectedString name="Source">local Lighting = game:GetService("Lighting")
local P = require(script.Parent.Primitives)
local StationBuilder = require(script.Parent.StationBuilder)
return function(count)
    assert(count &lt;= 6, "Expand the plot layout before adding more restaurants.")
    local previous = workspace:FindFirstChild("FriesRestaurant")
    if previous then previous:Destroy() end
    local model = Instance.new("Model")
    model.Name, model.Parent = "FriesRestaurant", workspace
    P.part(model, "Ground", Vector3.new(220, 1, 192), Vector3.new(0, -0.5, 0), Color3.fromRGB(112, 198, 91))
    P.part(model, "CentralPlaza", Vector3.new(198, 0.25, 48), Vector3.new(0, 0.1, 0), Color3.fromRGB(166, 113, 73))
    local pathBrown = Color3.fromRGB(190, 137, 88)
    P.part(model, "Promenade", Vector3.new(198, 0.05, 12), Vector3.new(0, 0.25, 0), pathBrown)
    -- Continuous solid hedges sit at the ground edges, outside all six plots.
    local boundary = Instance.new("Model")
    boundary.Name, boundary.Parent = "Boundary", model
    for _, edge in ipairs({
        {"North", Vector3.new(220, 12, 2), Vector3.new(0, 6, -95)},
        {"South", Vector3.new(220, 12, 2), Vector3.new(0, 6, 95)},
        {"West", Vector3.new(2, 12, 192), Vector3.new(-109, 6, 0)},
        {"East", Vector3.new(2, 12, 192), Vector3.new(109, 6, 0)},
    }) do
        local wall = P.part(boundary, edge[1], edge[2], edge[3], Color3.fromRGB(73, 156, 83))
        wall.CanCollide = true
        P.part(boundary, edge[1] .. "Cap", Vector3.new(edge[2].X, 1, edge[2].Z),
            Vector3.new(edge[3].X, 12.5, edge[3].Z), Color3.fromRGB(101, 186, 92))
    end
    for _, x in ipairs({-109, 109}) do
        for _, z in ipairs({-95, 95}) do
            P.part(boundary, "CornerPost", Vector3.new(2, 14, 2), Vector3.new(x, 7, z), Color3.fromRGB(255, 218, 147))
        end
    end
    -- The title belongs to a physical wall and follows its perspective.
    local muralWall = P.part(model, "MuralWall", Vector3.new(1.2, 14, 38), Vector3.new(-104, 7, 0), Color3.fromRGB(245, 112, 113))
    P.surfaceLabel(muralWall, "PUT THE FRIES\nIN THE BAG", Enum.NormalId.Right, Color3.fromRGB(255, 235, 181))
    local spawn = Instance.new("SpawnLocation")
    spawn.Name, spawn.Anchored, spawn.Neutral = "PlazaEntrance", true, true
    spawn.Size, spawn.Position = Vector3.new(8, 0.3, 8), Vector3.new(0, 0.35, 0)
    spawn.Color, spawn.Duration, spawn.Transparency = pathBrown, 0, 1
    spawn.Parent = model
    local stations = {}
    for index = 1, count do
        local column = (index - 1) % 3
        local south = index &gt; 3
        stations[index] = StationBuilder(model, index, Vector3.new((column - 1) * 64, 0, if south then 60 else -60),
            if south then math.pi else 0)
        P.part(model, "PlotPath" .. index, Vector3.new(12, 0.2, 12),
            Vector3.new((column - 1) * 64, 0.2, if south then 30 else -30), pathBrown)
    end
    -- Central space stays open for meeting and future, separately agreed features.
    for _, x in ipairs({-84, -32, 32, 84}) do
        for _, z in ipairs({-17, 17}) do
            P.part(model, "Planter", Vector3.new(7, 1.1, 5), Vector3.new(x, 0.8, z), Color3.fromRGB(255, 218, 147))
            local greenery = P.part(model, "Greenery", Vector3.new(6, 2, 4), Vector3.new(x, 2.1, z), Color3.fromRGB(86, 196, 73))
            greenery.Shape = Enum.PartType.Ball
        end
    end
    for _, x in ipairs({-48, 48}) do
        P.part(model, "PlazaBench", Vector3.new(8, 1.5, 2.5), Vector3.new(x, 1, 12), Color3.fromRGB(250, 183, 101))
    end
    -- Broad, soft lighting keeps the solid cartoon colors readable indoors and out.
    -- Dimmed on owner review (8 Oct 2026): the earlier values washed out the colors.
    -- LightingStyle is saved by the place builder/Rojo; runtime writes stop startup.
    Lighting.ClockTime, Lighting.Brightness = 13.5, 1.5
    Lighting.Ambient = Color3.fromRGB(136, 146, 162)
    Lighting.OutdoorAmbient = Color3.fromRGB(148, 159, 176)
    Lighting.EnvironmentDiffuseScale, Lighting.EnvironmentSpecularScale = 0.3, 0.12
    Lighting.GlobalShadows, Lighting.ShadowSoftness = true, 1
    Lighting.ExposureCompensation = -0.25
    return stations
end
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX00039">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX00040">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX00041">
        <Properties>
          <string name="Name">FriesClient</string>
        </Properties>
        <Item class="LocalScript" referent="RBX00042">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source">-- Client composition root. Cash and sales are determined by the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local AppView = require(script.Parent.ui.AppView)
local RestaurantMarkers = require(script.Parent.ui.RestaurantMarkers)
local PetFollower = require(script.Parent.ui.PetFollower)
local InputController = require(script.Parent.controllers.InputController)
local remotes = ReplicatedStorage:WaitForChild("FriesRemotes")
local action = remotes:WaitForChild("Action")
local stateRemote = remotes:WaitForChild("State")
local noticeRemote = remotes:WaitForChild("Notice")
local state = nil
local function send(name, argument) action:FireServer(name, argument) end
local app = AppView.new(Players.LocalPlayer:WaitForChild("PlayerGui"), send)
local markers = RestaurantMarkers.new(Players.LocalPlayer.PlayerGui, Players.LocalPlayer.UserId)
local pets = PetFollower.new(Players.LocalPlayer)
stateRemote.OnClientEvent:Connect(function(snapshot)
    state = snapshot
    app:update(snapshot)
    markers:update(snapshot.hasStation)
    pets:setShowOthers(snapshot.settings == nil or snapshot.settings.ShowOtherPets)
end)
noticeRemote.OnClientEvent:Connect(function(text, success) app:notice(text, success) end)
InputController(app.hud, send, function() return state end)
RunService.RenderStepped:Connect(function(dt)
    markers.guides:step(Players.LocalPlayer.Character, dt)
    pets:step(dt)
    local camera = workspace.CurrentCamera
    if camera then app:resize(camera.ViewportSize) end
end)
task.spawn(function()
    while not state do
        send("Sync")
        task.wait(2)
    end
end)
</ProtectedString>
          </Properties>
        </Item>
        <Item class="Folder" referent="RBX00043">
          <Properties>
            <string name="Name">controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX00044">
            <Properties>
              <string name="Name">InputController</string>
              <ProtectedString name="Source">local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Economy = require(Shared.config.Economy)
-- Holding and tapping both use the same rate-limited Pack request on the server.
return function(hud, send, getState)
    local heldInput = nil
    local holdingKey = false
    local nextPack = 0
    local function pack()
        local state = getState()
        if not state or not state.hasStation or not state.nearStation or state.profile.bag.fries &gt;= state.stats.capacity then return end
        local now = os.clock()
        if now &lt; nextPack then return end
        nextPack = now + 1 / Economy.ClicksPerSecond + 0.02
        send("Pack")
    end
    hud.pack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            heldInput = input
            pack()
        end
    end)
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or UserInputService:GetFocusedTextBox() then return end
        if input.KeyCode == Enum.KeyCode.F then holdingKey = true; pack()
        elseif input.KeyCode == Enum.KeyCode.R then hud:sellBag()
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input == heldInput or input.UserInputType == Enum.UserInputType.MouseButton1 then heldInput = nil end
        if input.KeyCode == Enum.KeyCode.F then holdingKey = false end
    end)
    UserInputService.WindowFocusReleased:Connect(function() heldInput = nil; holdingKey = false end)
    RunService.RenderStepped:Connect(function()
        if heldInput and not hud.frame.Visible then heldInput = nil end
        if heldInput or holdingKey then pack() end
    end)
end
</ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="RBX00045">
          <Properties>
            <string name="Name">ui</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX00046">
            <Properties>
              <string name="Name">AppView</string>
              <ProtectedString name="Source">local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local HudView = require(script.Parent.HudView)
local ShopView = require(script.Parent.ShopView)
local RebirthView = require(script.Parent.RebirthView)
local GachaView = require(script.Parent.GachaView)
local PetsView = require(script.Parent.PetsView)
local SettingsView = require(script.Parent.SettingsView)
local AppView = {}
AppView.__index = AppView
-- The wallet card holds Cash (top) and Gems (bottom row).
local CardHeight, ButtonGap, ButtonHeight = 112, 10, 44
local function scaledText(label, max)
    label.TextScaled, label.TextWrapped = true, false
    local fit = Instance.new("UITextSizeConstraint")
    fit.MinTextSize, fit.MaxTextSize, fit.Parent = 10, max, label
end
function AppView.new(playerGui, send)
    local self = setmetatable({}, AppView)
    local gui = Instance.new("ScreenGui")
    gui.Name, gui.ResetOnSpawn, gui.ZIndexBehavior = "FriesInterface", false, Enum.ZIndexBehavior.Sibling
    gui.Parent = playerGui
    self.cashCard = E.box(gui, "CashCard", UDim2.fromOffset(16, 16), UDim2.fromOffset(218, CardHeight), Theme.Background, 18)
    self.cashCard.AnchorPoint = Vector2.new(0, 0.5)
    E.stroke(self.cashCard, Theme.Gold, 2, 0.12)
    local coin = E.box(self.cashCard, "Coin", UDim2.fromOffset(12, 17), UDim2.fromOffset(42, 42), Theme.Gold, 21)
    local symbol = E.label(coin, "$", 42, Theme.Ink)
    symbol.Size, symbol.TextSize, symbol.Font = UDim2.fromScale(1, 1), 29, Enum.Font.GothamBold
    symbol.TextXAlignment = Enum.TextXAlignment.Center
    local caption = E.label(self.cashCard, "CASH", 18, Theme.Muted)
    caption.Position, caption.Size, caption.TextSize = UDim2.fromOffset(65, 10), UDim2.fromOffset(140, 18), 11
    self.wallet = E.label(self.cashCard, "$0", 36, Theme.Text)
    self.wallet.Name, self.wallet.Position, self.wallet.Size = "Cash", UDim2.fromOffset(65, 29), UDim2.fromOffset(142, 36)
    self.wallet.Font, self.wallet.TextSize = Enum.Font.GothamBold, 27
    scaledText(self.wallet, 27)
    local divider = E.box(self.cashCard, "Divider", UDim2.fromOffset(12, 74), UDim2.new(1, -24, 0, 1), Theme.Muted, 0)
    divider.BackgroundTransparency = 0.7
    -- A code-built gem: a small rotated square, no texture assets.
    local gem = E.box(self.cashCard, "GemIcon", UDim2.fromOffset(24, 84), UDim2.fromOffset(18, 18), Theme.Gem, 3)
    gem.Rotation = 45
    self.gems = E.label(self.cashCard, "0", 26, Theme.Text)
    self.gems.Name, self.gems.Position, self.gems.Size = "Gems", UDim2.fromOffset(65, 80), UDim2.new(1, -125, 0, 26)
    self.gems.Font, self.gems.TextSize = Enum.Font.GothamBold, 20
    scaledText(self.gems, 20)
    local gemCaption = E.label(self.cashCard, "GEMS", 18, Theme.Gem)
    gemCaption.Name, gemCaption.AnchorPoint = "GemCaption", Vector2.new(1, 0)
    gemCaption.Position, gemCaption.Size, gemCaption.TextSize = UDim2.new(1, -14, 0, 84), UDim2.fromOffset(50, 18), 11
    gemCaption.TextXAlignment = Enum.TextXAlignment.Right
    self.mode = E.label(gui, "", 20, Theme.Text)
    -- Studio-only label in the bottom-left corner, below every control.
    self.mode.Name, self.mode.Position, self.mode.Size, self.mode.TextSize = "Mode", UDim2.new(0, 16, 1, -18), UDim2.fromOffset(220, 16), 10
    self.teleport = E.button(gui, "RETURN TO COUNTER", function()
        if self.hasStation then send("Return") end
    end, Theme.Background)
    self.teleport.TextColor3 = Theme.Text
    self.teleport.Name, self.teleport.AnchorPoint = "Teleport", Vector2.new(0.5, 0)
    self.teleport.Size, self.teleport.TextSize = UDim2.fromOffset(212, 44), 12
    E.stroke(self.teleport, Theme.Gold, 1.5, 0.3)
    self.guidance = E.label(gui, "", 44, Theme.Text)
    self.guidance.Name, self.guidance.AnchorPoint = "Guidance", Vector2.new(0.5, 0)
    self.guidance.TextXAlignment, self.guidance.TextSize = Enum.TextXAlignment.Center, 13
    self.guidance.BackgroundColor3, self.guidance.BackgroundTransparency = Theme.Background, 0.08
    E.corner(self.guidance, 12)
    self.hud = HudView.new(gui, send)
    self.shop = ShopView.new(gui, send)
    self.rebirth = RebirthView.new(gui, send)
    self.gacha = GachaView.new(gui, send)
    self.pets = PetsView.new(gui, send)
    -- Grid order: UPGRADES | REBIRTH on the first row, SPIN | PETS on the second.
    self.menus = { self.shop, self.rebirth, self.gacha, self.pets }
    self.settings = SettingsView.new(gui, send)
    -- Opening one panel closes the others so they never stack.
    self.panels = { self.shop, self.rebirth, self.gacha, self.pets, self.settings }
    for _, menu in ipairs(self.panels) do
        menu.button.Activated:Connect(function()
            if not menu.panel.Visible then return end
            for _, other in ipairs(self.panels) do if other ~= menu then other:setOpen(false) end end
        end)
    end
    self:resize(Vector2.new(1280, 720))
    return self
end
function AppView:update(state)
    self.hasStation = state.hasStation
    self.wallet.Text = E.money(state.profile.cash)
    self.gems.Text = E.count(state.profile.gems or 0)
    self.mode.Text = if state.volatile then "STUDIO TEST / resets on stop" else ""
    self.teleport.Active, self.teleport.Selectable = state.hasStation, state.hasStation
    self.teleport.Text = if state.hasStation then "RETURN TO COUNTER" else "CHOOSE A RESTAURANT"
    self.teleport.AutoButtonColor = state.hasStation
    if not self.errorUntil or os.clock() &gt;= self.errorUntil then
        self.guidance.Visible = not state.hasStation
        self.guidance.Text = "Follow an AVAILABLE arrow. Press E or tap the entrance prompt to claim."
        self.guidance.TextColor3 = Theme.Text
    end
    self.hud:update(state)
    for _, menu in ipairs(self.panels) do menu:update(state) end
end
function AppView:notice(text, success)
    -- Sales are acknowledged by the wallet and bag reset, without a bottom toast.
    if success then return end
    self.errorUntil = os.clock() + 4
    self.guidance.Visible, self.guidance.Text, self.guidance.TextColor3 = true, text, Theme.Red
end
function AppView:resize(viewport)
    if self.viewportX == viewport.X and self.viewportY == viewport.Y then return end
    self.viewportX, self.viewportY = viewport.X, viewport.Y
    local portrait = viewport.X &lt; 760 and viewport.Y &gt;= 500
    local compact = viewport.X &lt; 760 and not portrait
    local hudScale = math.min(1, (viewport.X - 24) / 392)
    local height = viewport.Y - 60
    local actionTop = height - 22 - 104 * hudScale
    local cardWidth = if compact then 172 else 218
    -- Centre the wallet on the left; lift it only when a short screen needs room for actions.
    -- Tall screens put the 2x2 menu grid below it, which needs room too. Short screens
    -- (under 500 px high) put the grid at the top right instead.
    local side = viewport.Y &lt; 500
    local below = if side then 0 else ButtonGap + ButtonHeight * 2 + 8
    local cashOffset = math.min(0, actionTop - 12 - below - CardHeight / 2 - height / 2)
    self.cashCard.Position = UDim2.new(0, 16, 0.5, cashOffset)
    self.cashCard.Size = UDim2.fromOffset(cardWidth, CardHeight)
    self.wallet.Size = UDim2.fromOffset(if compact then 105 else 142, 36)
    self.wallet.Position = UDim2.fromOffset(if compact then 58 else 65, 29)
    self.gems.Position = UDim2.fromOffset(if compact then 58 else 65, 80)
    -- Return to Counter and the settings gear are centred together; compact screens narrow it.
    local teleportWidth = if compact then 160 else 212
    local teleportX = if compact then 0 else -26
    local teleportY = if portrait then 36 else 16
    self.teleport.Size = UDim2.fromOffset(teleportWidth, 44)
    self.teleport.Position = UDim2.new(0.5, teleportX, 0, teleportY)
    self.settings.button.AnchorPoint = Vector2.new(0, 0)
    self.settings.button.Position = UDim2.new(0.5, teleportX + teleportWidth / 2 + 8, 0, teleportY)
    self.guidance.Position = UDim2.new(0.5, if compact then 22 else 0, 0, if portrait then 88 else 68)
    self.guidance.Size = UDim2.fromOffset(if compact then 230 else math.min(460, viewport.X - 32), 44)
    local gridLeft = viewport.X
    for index, menu in ipairs(self.menus) do
        local column, row = (index - 1) % 2, math.floor((index - 1) / 2)
        local button = menu.button
        if side then
            -- Top right, clear of Return to Counter and the guidance strip.
            local width = if compact then 60 else 96
            button.AnchorPoint = Vector2.new(1, 0)
            button.Position = UDim2.new(1, -16 - (1 - column) * (width + 8), 0, 16 + row * (ButtonHeight + 8))
            button.Size = UDim2.fromOffset(width, ButtonHeight)
            gridLeft = viewport.X - 16 - width * 2 - 8
        else
            local half = (cardWidth - 8) / 2
            button.AnchorPoint = Vector2.new(0, 0)
            button.Position = UDim2.new(0, 16 + column * (half + 8), 0.5, cashOffset + CardHeight / 2 + ButtonGap + row * (ButtonHeight + 8))
            button.Size = UDim2.fromOffset(half, ButtonHeight)
        end
    end
    if side and not compact then
        -- Keep the centred guidance strip clear of the top-right grid.
        self.guidance.Size = UDim2.fromOffset(math.min(460, 2 * (gridLeft - 12 - viewport.X / 2)), 44)
    end
    for _, menu in ipairs(self.panels) do menu:resize(viewport) end
    self.hud.scale.Scale = hudScale
end
return AppView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00047">
            <Properties>
              <string name="Name">Elements</string>
              <ProtectedString name="Source">local Theme = require(script.Parent.Theme)
local Elements = {}
function Elements.count(value)
    local grouped = string.reverse(string.format("%.0f", value)):gsub("(%d%d%d)", "%1,")
    local result = string.reverse(grouped):gsub("^,", "")
    return result
end
function Elements.money(value) return "$" .. Elements.count(value) end
-- Whole numbers stay whole; pet bonuses can make stats fractional (1.05 fries per click).
function Elements.number(value)
    if math.abs(value - math.floor(value + 0.5)) &lt; 1e-6 then return Elements.count(math.floor(value + 0.5)) end
    local text = string.format("%.2f", value):gsub("0+$", ""):gsub("%.$", "")
    return text
end
-- Shrinks text to fit on one line, between min and max sizes.
function Elements.fit(label, min, max)
    label.TextScaled, label.TextWrapped = true, false
    local constraint = Instance.new("UITextSizeConstraint")
    constraint.Name, constraint.MinTextSize, constraint.MaxTextSize, constraint.Parent = "Fit", min, max, label
    return constraint
end
function Elements.stroke(parent, color, thickness, transparency)
    local stroke = Instance.new("UIStroke")
    stroke.Color, stroke.Thickness, stroke.Transparency = color, thickness, transparency or 0
    stroke.ApplyStrokeMode, stroke.Parent = Enum.ApplyStrokeMode.Border, parent
    return stroke
end
function Elements.box(parent, name, position, size, color, radius)
    local frame = Instance.new("Frame")
    frame.Name, frame.Position, frame.Size = name, position, size
    frame.BackgroundColor3, frame.BorderSizePixel, frame.Parent = color, 0, parent
    Elements.corner(frame, radius)
    return frame
end
function Elements.corner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius, corner.Parent = UDim.new(0, radius or 10), parent
end
function Elements.label(parent, text, height, color)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, height or 42)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 15
    label.TextColor3 = color or Theme.Text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextWrapped = true
    label.Text = text
    label.Parent = parent
    return label
end
function Elements.button(parent, text, callback, color)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 43)
    button.BackgroundColor3 = color or Theme.Gold
    button.TextColor3 = Theme.Background
    button.Font = Enum.Font.GothamBold
    button.TextSize = 15
    button.TextWrapped = true
    button.Text = text
    button.BorderSizePixel = 0
    button.Parent = parent
    Elements.corner(button)
    if callback then button.Activated:Connect(callback) end
    return button
end
function Elements.column(parent, name)
    local frame = Instance.new("ScrollingFrame")
    frame.Name = name
    frame.Size = UDim2.fromScale(1, 1)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.ScrollBarThickness = 4
    frame.ScrollBarImageColor3 = Theme.Muted
    frame.CanvasSize = UDim2.new()
    frame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    frame.Parent = parent
    local padding = Instance.new("UIPadding")
    padding.PaddingRight = UDim.new(0, 9)
    padding.PaddingBottom = UDim.new(0, 12)
    padding.Parent = frame
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = frame
    return frame
end
function Elements.bar(parent, color, height)
    local outer = Instance.new("Frame")
    outer.Size = UDim2.new(1, 0, 0, height or 18)
    outer.BackgroundColor3 = Theme.Card
    outer.BorderSizePixel = 0
    outer.Parent = parent
    Elements.corner(outer, 5)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BackgroundColor3 = color or Theme.Gold
    fill.BorderSizePixel = 0
    fill.Parent = outer
    Elements.corner(fill, 5)
    return outer, fill
end
return Elements
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00048">
            <Properties>
              <string name="Name">GachaView</string>
              <ProtectedString name="Source">-- Gacha machine panel: price, odds, pity, last result, and the SPIN button.
-- The server rolls; this view only displays and requests.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local PetConfig = require(Shared.config.Pets)
local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local PetText = require(script.Parent.PetText)
local GachaView = {}
GachaView.__index = GachaView
local PanelWidth, PanelHeight = 360, 376
function GachaView.new(gui, send)
    local self = setmetatable({ send = send, hasStation = false, canSpin = false, odds = {} }, GachaView)
    self.button = E.button(gui, "SPIN", function() self:toggle() end, Theme.Background)
    self.button.Name, self.button.TextSize, self.button.TextColor3 = "SpinButton", 13, Theme.Green
    E.stroke(self.button, Theme.Green, 1.5, 0.3)
    E.fit(self.button, 8, 13)

    local panel = E.box(gui, "GachaPanel", UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(PanelWidth, PanelHeight), Theme.Background, 18)
    panel.AnchorPoint, panel.Visible, panel.ZIndex = Vector2.new(0.5, 0.5), false, 5
    E.stroke(panel, Theme.Green, 2, 0.12)
    self.panel = panel
    self.scale = Instance.new("UIScale")
    self.scale.Parent = panel
    self.title = E.label(panel, "STARTER FRYER", 28, Theme.Text)
    self.title.Name, self.title.Position, self.title.Size = "Title", UDim2.fromOffset(20, 14), UDim2.fromOffset(260, 28)
    self.title.Font, self.title.TextSize = Enum.Font.GothamBold, 21
    self.caption = E.label(panel, "", 16, Theme.Muted)
    self.caption.Name, self.caption.Position, self.caption.Size, self.caption.TextSize = "Caption", UDim2.fromOffset(20, 42), UDim2.fromOffset(270, 16), 11
    self.close = E.button(panel, "X", function() self:setOpen(false) end, Theme.Card)
    self.close.Name, self.close.Position, self.close.Size = "Close", UDim2.fromOffset(PanelWidth - 52, 14), UDim2.fromOffset(36, 36)
    self.close.TextColor3, self.close.TextSize = Theme.Text, 14

    local odds = E.box(panel, "Odds", UDim2.fromOffset(16, 70), UDim2.fromOffset(PanelWidth - 32, 136), Theme.Card, 14)
    for index, rarity in ipairs(PetConfig.RarityOrder) do
        local y = 8 + (index - 1) * 24
        local chance = E.label(odds, "", 22, PetText.color(rarity))
        chance.Name, chance.Position, chance.Size = rarity, UDim2.fromOffset(12, y), UDim2.fromOffset(112, 22)
        chance.Font, chance.TextSize = Enum.Font.GothamBold, 12
        E.fit(chance, 8, 12)
        local names = E.label(odds, "", 22, Theme.Muted)
        names.Name, names.Position, names.Size, names.TextSize = rarity .. "Pets", UDim2.fromOffset(126, y), UDim2.fromOffset(PanelWidth - 32 - 138, 22), 10
        E.fit(names, 7, 10)
        self.odds[rarity] = { chance = chance, names = names }
    end

    local result = E.box(panel, "Result", UDim2.fromOffset(16, 216), UDim2.fromOffset(PanelWidth - 32, 64), Theme.Card, 14)
    self.resultName = E.label(result, "Spin to get a Fry Buddy!", 26, Theme.Text)
    self.resultName.Name, self.resultName.Position, self.resultName.Size = "PetName", UDim2.fromOffset(14, 8), UDim2.fromOffset(PanelWidth - 60, 26)
    self.resultName.Font, self.resultName.TextSize = Enum.Font.GothamBold, 17
    E.fit(self.resultName, 9, 17)
    self.resultBonus = E.label(result, "Pets you win appear in PETS.", 18, Theme.Muted)
    self.resultBonus.Name, self.resultBonus.Position, self.resultBonus.Size, self.resultBonus.TextSize = "Bonus", UDim2.fromOffset(14, 36), UDim2.fromOffset(PanelWidth - 60, 18), 12

    self.count = E.label(panel, "", 16, Theme.Muted)
    self.count.Name, self.count.Position, self.count.Size, self.count.TextSize = "Count", UDim2.fromOffset(20, 290), UDim2.fromOffset(PanelWidth - 40, 16), 11
    self.spin = E.button(panel, "SPIN", function() self:spinOnce() end, Theme.Green)
    self.spin.Name, self.spin.Position, self.spin.Size = "Spin", UDim2.fromOffset(16, 312), UDim2.fromOffset(PanelWidth - 32, 48)
    self.spin.AutoButtonColor, self.spin.TextColor3, self.spin.TextSize = false, Theme.Ink, 16
    return self
end
function GachaView:setOpen(open) self.panel.Visible = open and self.hasStation end
function GachaView:toggle() if self.hasStation then self:setOpen(not self.panel.Visible) end end
function GachaView:spinOnce()
    if self.canSpin and self.panel.Visible and self.machineId then self.send("Spin", self.machineId) end
end
function GachaView:update(state)
    self.hasStation = state.hasStation
    self.button.Active, self.button.Selectable, self.button.AutoButtonColor = state.hasStation, state.hasStation, state.hasStation
    self.button.TextColor3 = if state.hasStation then Theme.Green else Theme.Muted
    if not state.hasStation then self.panel.Visible = false end
    local machine, pets = state.machine, state.pets
    if not machine or not pets then return end
    self.machineId = machine.id
    self.title.Text = string.upper(machine.name)
    local left = machine.pityEvery - machine.pity
    self.caption.Text = E.money(machine.price) .. " per spin  ·  " .. machine.pityRarity .. " or better within " .. left
        .. (if left == 1 then " spin" else " spins")
    for _, row in ipairs(machine.odds) do
        local view = self.odds[row.rarity]
        if view then
            view.chance.Text = string.upper(row.rarity) .. "  " .. E.number(row.chance * 100) .. "%"
            view.names.Text = table.concat(row.pets, ", ")
        end
    end
    local full = #pets.owned &gt;= pets.max
    local affordable = state.profile.cash &gt;= machine.price
    self.canSpin = state.hasStation and affordable and not full
    self.count.Text = "PETS " .. #pets.owned .. " / " .. pets.max .. (if full then "  ·  inventory full" else "")
    self.spin.Active, self.spin.Selectable = self.canSpin, self.canSpin
    self.spin.Text = if full then "INVENTORY FULL" elseif affordable then "SPIN  " .. E.money(machine.price) else "NEED " .. E.money(machine.price)
    self.spin.BackgroundColor3 = if self.canSpin then Theme.Green else Theme.Card
    self.spin.TextColor3 = if self.canSpin then Theme.Ink else Theme.Muted
    -- A new spin result names the pet in its rarity color.
    local spin = state.spin
    if spin and spin.serial ~= self.lastSerial and spin.autoDeleted then
        -- Auto-deleted pets are not in the inventory; name them from config.
        self.lastSerial = spin.serial
        local kind = PetConfig.Types[spin.type]
        self.resultName.Text = "Auto-deleted " .. kind.Name
        self.resultName.TextColor3 = Theme.Muted
        self.resultBonus.Text = string.upper(kind.Rarity) .. "  ·  turn auto-delete off in PETS"
    elseif spin and spin.serial ~= self.lastSerial then
        self.lastSerial = spin.serial
        for _, owned in ipairs(pets.owned) do
            if owned.id == spin.id then
                self.resultName.Text = "You got " .. owned.name .. "!"
                self.resultName.TextColor3 = PetText.color(owned.rarity)
                self.resultBonus.Text = string.upper(owned.rarity) .. "  ·  " .. PetText.bonus(owned.bonuses)
            end
        end
    end
end
function GachaView:resize(viewport)
    self.scale.Scale = math.min(1, (viewport.X - 32) / PanelWidth, (viewport.Y - 60 - 24) / PanelHeight)
end
return GachaView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00049">
            <Properties>
              <string name="Name">HudView</string>
              <ProtectedString name="Source">local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local HudView = {}
HudView.__index = HudView
local function action(parent, name, x, color, key, callback)
    local shadow = E.box(parent, name .. "Shadow", UDim2.fromOffset(x, 7), UDim2.fromOffset(190, 96), Theme.Shadow, 18)
    shadow.BackgroundTransparency = 0.18
    local button = E.button(parent, "", callback, color)
    button.Name, button.Position, button.Size = name, UDim2.fromOffset(x, 0), UDim2.fromOffset(190, 96)
    button.AutoButtonColor = false
    button:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, 18)
    E.stroke(button, Theme.Text, 1.5, 0.65)
    local title = E.label(button, "", 34, Theme.Ink)
    title.Name, title.Position, title.Size = "Title", UDim2.fromOffset(48, 13), UDim2.fromOffset(136, 34)
    title.Font, title.TextSize = Enum.Font.GothamBold, 21
    -- Longer titles after upgrades ("+12 fries/click") shrink to one line instead of wrapping.
    title.TextWrapped, title.TextScaled = false, true
    local fit = Instance.new("UITextSizeConstraint")
    fit.Name, fit.MinTextSize, fit.MaxTextSize, fit.Parent = "Fit", 10, 21, title
    local detail = E.label(button, "", 20, Theme.Ink)
    detail.Name, detail.Position, detail.Size, detail.TextSize = "Detail", UDim2.fromOffset(12, 50), UDim2.fromOffset(166, 20), 12
    local shortcut = E.label(button, key, 16, Theme.Ink)
    shortcut.Position, shortcut.Size, shortcut.TextSize = UDim2.fromOffset(168, 3), UDim2.fromOffset(18, 16), 10
    shortcut.TextXAlignment = Enum.TextXAlignment.Center
    return button, title, detail, shortcut
end
function HudView.new(parent, send)
    local self = setmetatable({ send = send, hovered = false }, HudView)
    local frame = Instance.new("Frame")
    frame.Name, frame.AnchorPoint = "Actions", Vector2.new(0.5, 1)
    frame.Position, frame.Size = UDim2.new(0.5, 0, 1, -22), UDim2.fromOffset(392, 104)
    frame.BackgroundTransparency, frame.Parent = 1, parent
    self.frame = frame
    self.scale = Instance.new("UIScale")
    self.scale.Parent = frame
    self.pack, self.packTitle, self.packDetail = action(frame, "Click", 0, Theme.Gold, "F", nil)
    self.sell, self.sellTitle, self.sellDetail, self.sellShortcut = action(frame, "Sell", 202, Theme.Card, "R", function() self:sellBag() end)
    -- Small code-built fry and bag symbols; no external texture assets.
    for n = 1, 3 do
        E.box(self.pack, "Fry" .. n, UDim2.fromOffset(14 + (n - 1) * 8, 15 - n % 2 * 3),
            UDim2.fromOffset(6, 27), Theme.Ink, 2)
    end
    E.box(self.sell, "BagIcon", UDim2.fromOffset(15, 18), UDim2.fromOffset(24, 28), Theme.Gold, 4)
    E.box(self.sell, "BagRim", UDim2.fromOffset(13, 16), UDim2.fromOffset(28, 5), Theme.GoldLight, 2)
    local track
    track, self.fill = E.bar(self.sell, Theme.Gold, 6)
    track.Position, track.Size, track.BackgroundColor3 = UDim2.fromOffset(12, 79), UDim2.fromOffset(166, 6), Theme.Background
    local hint = E.label(self.pack, "PACK FRIES", 14, Theme.Ink)
    hint.Position, hint.Size, hint.TextSize = UDim2.fromOffset(12, 76), UDim2.fromOffset(166, 14), 10
    local function hover(on)
        self.hovered = on
        if self.state then self:update(self.state) end
    end
    self.pack.MouseEnter:Connect(function() hover(true) end)
    self.pack.MouseLeave:Connect(function() hover(false) end)
    self.pack.SelectionGained:Connect(function() hover(true) end)
    self.pack.SelectionLost:Connect(function() hover(false) end)
    self.packTitle.Text, self.packDetail.Text = "LOADING", "YOUR RESTAURANT"
    self.sellTitle.Text, self.sellDetail.Text = "0 / 20", "FRIES IN BAG"
    self.sellTitle.TextColor3, self.sellDetail.TextColor3 = Theme.Text, Theme.Muted
    self.sellShortcut.TextColor3 = Theme.Muted
    self.pack.Active, self.sell.Active = false, false
    self.pack.Selectable, self.sell.Selectable = false, false
    return self
end
function HudView:sellBag()
    local state = self.state
    if state and state.hasStation and state.nearStation and state.profile.bag.fries &gt;= state.stats.capacity then self.send("Sell") end
end
function HudView:update(state)
    self.state = state
    local bag = state.profile.bag
    local capacity = state.stats.capacity
    local full = bag.fries &gt;= capacity
    local canPack = state.hasStation and state.nearStation and not full
    local canSell = state.hasStation and state.nearStation and full
    local perClick = state.stats.perClick
    local yieldText = "+" .. E.number(perClick) .. (if perClick == 1 then " fry/click" else " fries/click")
    self.pack.Active, self.pack.Selectable = canPack, canPack
    self.sell.Active, self.sell.Selectable = canSell, canSell
    self.pack.BackgroundColor3 = if canPack and self.hovered then Theme.GoldLight else Theme.Gold
    self.packTitle.Text = if not state.hasStation then "CLAIM FIRST" elseif full then "BAG FULL"
        elseif not state.nearStation then "AT COUNTER" elseif self.hovered then "CLICK" else yieldText
    self.packTitle.TextSize = if not state.hasStation then 17 else 21
    self.packTitle.Fit.MaxTextSize = self.packTitle.TextSize
    self.packDetail.Text = if not state.hasStation then "CLAIM AT THE ENTRANCE" elseif full then "SELL TO KEEP PACKING"
        elseif not state.nearStation then "RETURN TO COUNTER" elseif self.hovered then string.upper(yieldText) else "TAP / HOLD TO PACK"
    self.sellTitle.Text = if full then "SELL BAG" else math.floor(bag.fries) .. " / " .. capacity
    self.sellDetail.Text = if not state.hasStation then "CLAIM A RESTAURANT"
        elseif full and not state.nearStation then "RETURN TO COUNTER"
        elseif full then "+" .. E.money(state.stats.saleValue) .. " CASH"
        else "FRIES IN BAG"
    self.sell.BackgroundColor3 = if canSell then Theme.Green else Theme.Card
    self.sellTitle.TextColor3 = if canSell then Theme.Ink else Theme.Text
    self.sellDetail.TextColor3 = if canSell then Theme.Ink else Theme.Muted
    self.sellShortcut.TextColor3 = if canSell then Theme.Ink else Theme.Muted
    self.fill.BackgroundColor3 = if full then Theme.Green else Theme.Gold
    self.fill.Size = UDim2.fromScale(bag.fries / capacity, 1)
end
return HudView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00050">
            <Properties>
              <string name="Name">PetFollower</string>
              <ProtectedString name="Source">-- Draws every player's equipped pets locally, following and bobbing behind their character.
-- Reads the server's public "FollowPets" player attribute; no network traffic per frame.
local Players = game:GetService("Players")
local PetModels = require(script.Parent.PetModels)
local PetFollower = {}
PetFollower.__index = PetFollower
-- Slots behind the character, in its local space (studs; -Z is forward).
local Slots = { Vector3.new(-3, -1.2, 3.5), Vector3.new(3, -1.2, 3.5), Vector3.new(0, -0.8, 6) }
local Follow = 8 -- higher catches up faster
function PetFollower.new(localPlayer)
    local folder = Instance.new("Folder")
    folder.Name, folder.Parent = "FollowingPets", workspace
    return setmetatable({ folder = folder, localPlayer = localPlayer, entries = {}, clock = 0, showOthers = true }, PetFollower)
end
function PetFollower:setShowOthers(show) self.showOthers = show ~= false end
function PetFollower:clear(player)
    local entry = self.entries[player]
    if entry then
        for _, pet in ipairs(entry.pets) do pet.model:Destroy() end
        self.entries[player] = nil
    end
end
local function parse(text)
    local list = {}
    for item in string.gmatch(text or "", "[^,]+") do
        local golden = string.sub(item, -1) == "*"
        table.insert(list, { type = if golden then string.sub(item, 1, -2) else item, golden = golden })
        if #list &gt;= #Slots then break end
    end
    return list
end
function PetFollower:step(dt)
    self.clock += math.max(dt or 0, 0)
    local alpha = math.min(1, math.max(dt or 0, 0) * Follow)
    local present = {}
    for _, player in ipairs(Players:GetPlayers()) do
        present[player] = true
        local text = player:GetAttribute("FollowPets") or ""
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local visible = text ~= "" and root ~= nil and humanoid ~= nil and humanoid.Health &gt; 0
            and (player == self.localPlayer or self.showOthers)
        local entry = self.entries[player]
        if not visible then
            self:clear(player)
        else
            if not entry or entry.text ~= text then
                self:clear(player)
                entry = { text = text, pets = {} }
                for _, pet in ipairs(parse(text)) do
                    local model, pieces = PetModels.build(pet.type, pet.golden, self.folder)
                    table.insert(entry.pets, { model = model, pieces = pieces })
                end
                self.entries[player] = entry
            end
            local frame = root.CFrame or CFrame.new(root.Position)
            local forward = frame:PointToWorldSpace(Vector3.new(0, 0, -1)) - root.Position
            for index, pet in ipairs(entry.pets) do
                local bob = math.sin(self.clock * 3 + index * 1.7) * 0.25
                local target = frame:PointToWorldSpace(Slots[index]) + Vector3.new(0, bob, 0)
                -- The first frame snaps into place; later frames ease towards the target.
                pet.position = if pet.position then pet.position + (target - pet.position) * alpha else target
                local base = CFrame.lookAt(pet.position, pet.position + forward)
                for _, piece in ipairs(pet.pieces) do piece.part.CFrame = base * piece.offset end
            end
        end
    end
    for player in pairs(self.entries) do if not present[player] then self:clear(player) end end
end
return PetFollower
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00051">
            <Properties>
              <string name="Name">PetModels</string>
              <ProtectedString name="Source">-- Code-built pet models: a few smooth cartoon blocks and balls per pet, no assets.
-- Each piece is { shape, size, offset, color, transparency? }. Bodies get eyes on the front (-Z).
local PetModels = {}
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
local Specs = {
    CrinkleFry = { eyes = 0.45, { "Block", { 0.9, 1.8, 0.9 }, { 0, 0, 0 }, rgb(255, 214, 90) },
        { "Block", { 0.95, 0.12, 0.95 }, { 0, 0.4, 0 }, rgb(232, 176, 52) }, { "Block", { 0.95, 0.12, 0.95 }, { 0, -0.3, 0 }, rgb(232, 176, 52) } },
    SaltShaker = { eyes = 0.55, { "Block", { 1.1, 1.4, 1.1 }, { 0, 0, 0 }, rgb(244, 244, 240) },
        { "Block", { 1.12, 0.4, 1.12 }, { 0, 0.85, 0 }, rgb(170, 178, 190) } },
    PaperCup = { eyes = 0.6, { "Block", { 1.2, 1.4, 1.2 }, { 0, 0, 0 }, rgb(232, 72, 72) },
        { "Block", { 1.22, 0.38, 1.22 }, { 0, -0.2, 0 }, rgb(255, 248, 236) }, { "Block", { 0.8, 0.5, 0.8 }, { 0, 0.9, 0 }, rgb(255, 214, 90) } },
    PotatoPup = { eyes = 0.75, { "Ball", { 1.6, 1.6, 1.6 }, { 0, 0, 0 }, rgb(196, 150, 92) },
        { "Ball", { 0.55, 0.55, 0.55 }, { -0.55, 0.7, 0 }, rgb(150, 105, 60) }, { "Ball", { 0.55, 0.55, 0.55 }, { 0.55, 0.7, 0 }, rgb(150, 105, 60) } },
    KetchupPacket = { eyes = 0.18, { "Block", { 1.5, 1.1, 0.35 }, { 0, 0, 0 }, rgb(222, 44, 44) },
        { "Block", { 1.52, 0.25, 0.37 }, { 0, 0.32, 0 }, rgb(255, 248, 236) } },
    NapkinGhost = { eyes = 0.75, { "Ball", { 1.6, 1.6, 1.6 }, { 0, 0, 0 }, rgb(250, 250, 255), 0.15 },
        { "Block", { 1.2, 0.5, 1.2 }, { 0, -0.7, 0 }, rgb(250, 250, 255), 0.15 } },
    CurlyFryCat = { eyes = 0.7, { "Ball", { 1.5, 1.5, 1.5 }, { 0, 0, 0 }, rgb(240, 150, 60) },
        { "Block", { 0.35, 0.55, 0.35 }, { -0.45, 0.8, 0 }, rgb(214, 118, 40) }, { "Block", { 0.35, 0.55, 0.35 }, { 0.45, 0.8, 0 }, rgb(214, 118, 40) } },
    MayoJar = { eyes = 0.6, { "Block", { 1.2, 1.5, 1.2 }, { 0, 0, 0 }, rgb(252, 246, 222) },
        { "Block", { 1.25, 0.32, 1.25 }, { 0, 0.9, 0 }, rgb(92, 150, 232) } },
    FryerBot = { eyes = false, { "Block", { 1.4, 1.3, 1.2 }, { 0, 0, 0 }, rgb(170, 186, 202) },
        { "Block", { 0.9, 0.5, 0.06 }, { 0, 0.15, -0.62 }, rgb(126, 245, 215) }, { "Block", { 0.12, 0.5, 0.12 }, { 0, 0.9, 0 }, rgb(120, 130, 145) },
        { "Ball", { 0.3, 0.3, 0.3 }, { 0, 1.2, 0 }, rgb(244, 112, 111) } },
    FryKing = { eyes = 0.5, { "Block", { 1.0, 1.9, 1.0 }, { 0, 0, 0 }, rgb(255, 206, 64) },
        { "Block", { 1.12, 0.36, 1.12 }, { 0, 1.15, 0 }, rgb(255, 176, 0) }, { "Ball", { 0.3, 0.3, 0.3 }, { 0, 1.45, 0 }, rgb(244, 112, 111) } },
}
local Gold = rgb(255, 200, 50)
PetModels.Specs = Specs
-- Returns a Model plus the pieces with their local offsets, for the follower to place each frame.
function PetModels.build(petType, golden, parent)
    local spec = Specs[petType] or Specs.CrinkleFry
    local model = Instance.new("Model")
    model.Name = petType .. (if golden then "Golden" else "")
    local pieces = {}
    local function add(shape, size, offset, color, transparency)
        local part = Instance.new("Part")
        part.Shape = if shape == "Ball" then Enum.PartType.Ball else Enum.PartType.Block
        part.Size = Vector3.new(size[1], size[2], size[3])
        part.Color, part.Transparency = color, transparency or 0
        part.Material, part.Reflectance = Enum.Material.SmoothPlastic, if golden then 0.25 else 0
        part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = true, false, false, false, false
        part.Parent = model
        table.insert(pieces, { part = part, offset = CFrame.new(Vector3.new(offset[1], offset[2], offset[3])) })
    end
    for index, piece in ipairs(spec) do
        -- Golden pets tint the body gold and keep their accent colors.
        add(piece[1], piece[2], piece[3], if golden and index == 1 then Gold else piece[4], piece[5])
    end
    if spec.eyes then
        for _, x in ipairs({ -0.22, 0.22 }) do
            add("Ball", { 0.24, 0.24, 0.24 }, { x, 0.25, -spec.eyes }, rgb(40, 32, 28))
        end
    end
    model.Parent = parent
    return model, pieces
end
return PetModels
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00052">
            <Properties>
              <string name="Name">PetText</string>
              <ProtectedString name="Source">-- Shared pet display text and rarity colors.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local PetConfig = require(Shared.config.Pets)
local PetText = {}
local StatNames = { FriesPerClick = "fries per click", MoneyPerFry = "money per fry", BagCapacity = "bag capacity" }
local ShortNames = { FriesPerClick = "fries/click", MoneyPerFry = "money/fry", BagCapacity = "bag size" }
-- `short` uses compact stat names for narrow rows.
function PetText.bonus(bonuses, short)
    local names = if short then ShortNames else StatNames
    local parts = {}
    for _, bonus in ipairs(bonuses) do
        table.insert(parts, "+" .. math.floor(bonus.amount * 100 + 0.5) .. "% " .. names[bonus.stat])
    end
    return table.concat(parts, ", ")
end
function PetText.color(rarity)
    local c = PetConfig.Rarities[rarity].Color
    return Color3.fromRGB(c[1], c[2], c[3])
end
return PetText
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00053">
            <Properties>
              <string name="Name">PetsView</string>
              <ProtectedString name="Source">-- Pet inventory: owned pets with rarity, bonus, Equip/Unequip, and a two-tap Delete, plus
-- tools: auto-delete by rarity, delete all of a rarity (two taps), and merging into Golden pets.
-- The server owns the inventory; this view only displays and requests.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local PetConfig = require(Shared.config.Pets)
local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local PetText = require(script.Parent.PetText)
local PetsView = {}
PetsView.__index = PetsView
local PanelWidth, PanelHeight, RowHeight = 380, 480, 60
local ListTop = 188
local ConfirmSeconds = 3
local function chipRow(self, parent, name, label, y, onPress)
    local caption = E.label(parent, label, 26, Theme.Muted)
    caption.Name, caption.Position, caption.Size, caption.TextSize = name .. "Label", UDim2.fromOffset(20, y), UDim2.fromOffset(92, 26), 10
    caption.Font = Enum.Font.GothamBold
    local chips = {}
    for index, rarity in ipairs(PetConfig.BulkRarities) do
        local chip = E.button(parent, string.upper(rarity), function() onPress(rarity) end, Theme.Card)
        chip.Name, chip.Position, chip.Size = name .. rarity, UDim2.fromOffset(112 + (index - 1) * 86, y), UDim2.fromOffset(80, 26)
        chip.TextSize, chip.AutoButtonColor = 10, false
        E.fit(chip, 7, 10)
        chips[rarity] = chip
    end
    return chips
end
function PetsView.new(gui, send)
    local self = setmetatable({ send = send, hasStation = false, rows = {}, confirm = {} }, PetsView)
    self.button = E.button(gui, "PETS", function() self:toggle() end, Theme.Background)
    self.button.Name, self.button.TextSize, self.button.TextColor3 = "PetsButton", 13, Theme.Blue
    E.stroke(self.button, Theme.Blue, 1.5, 0.3)
    E.fit(self.button, 8, 13)

    local panel = E.box(gui, "PetsPanel", UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(PanelWidth, PanelHeight), Theme.Background, 18)
    panel.AnchorPoint, panel.Visible, panel.ZIndex = Vector2.new(0.5, 0.5), false, 5
    E.stroke(panel, Theme.Blue, 2, 0.12)
    self.panel = panel
    self.scale = Instance.new("UIScale")
    self.scale.Parent = panel
    local title = E.label(panel, "PETS", 28, Theme.Text)
    title.Name, title.Position, title.Size = "Title", UDim2.fromOffset(20, 14), UDim2.fromOffset(260, 28)
    title.Font, title.TextSize = Enum.Font.GothamBold, 21
    self.caption = E.label(panel, "", 16, Theme.Muted)
    self.caption.Name, self.caption.Position, self.caption.Size, self.caption.TextSize = "Caption", UDim2.fromOffset(20, 42), UDim2.fromOffset(280, 16), 11
    self.close = E.button(panel, "X", function() self:setOpen(false) end, Theme.Card)
    self.close.Name, self.close.Position, self.close.Size = "Close", UDim2.fromOffset(PanelWidth - 52, 14), UDim2.fromOffset(36, 36)
    self.close.TextColor3, self.close.TextSize = Theme.Text, 14

    self.autoChips = chipRow(self, panel, "Auto", "AUTO-DELETE", 68, function(rarity)
        if self.hasStation then self.send("ToggleAutoDelete", rarity) end
    end)
    self.clearChips = chipRow(self, panel, "Clear", "DELETE ALL", 100, function(rarity) self:arm("rarity:" .. rarity, "DeleteRarity", rarity) end)
    local merge = E.box(panel, "Merge", UDim2.fromOffset(16, 134), UDim2.fromOffset(PanelWidth - 32, 44), Theme.Card, 12)
    E.stroke(merge, Theme.Gold, 1, 0.5)
    self.mergeText = E.label(merge, "", 30, Theme.GoldLight)
    self.mergeText.Name, self.mergeText.Position, self.mergeText.Size, self.mergeText.TextSize = "MergeText", UDim2.fromOffset(12, 7), UDim2.new(1, -112, 0, 30), 11
    self.mergeButton = E.button(merge, "MERGE", function() self:merge() end, Theme.Gold)
    self.mergeButton.Name, self.mergeButton.AnchorPoint = "MergeButton", Vector2.new(1, 0.5)
    self.mergeButton.Position, self.mergeButton.Size, self.mergeButton.TextSize = UDim2.new(1, -8, 0.5, 0), UDim2.fromOffset(88, 32), 12
    self.mergeButton.TextColor3 = Theme.Ink

    local holder = E.box(panel, "ListArea", UDim2.fromOffset(16, ListTop), UDim2.fromOffset(PanelWidth - 32, PanelHeight - ListTop - 16), Theme.Background, 0)
    self.list = E.column(holder, "List")
    self.empty = E.label(holder, "No pets yet. Spin the machine to get one!", 40, Theme.Muted)
    self.empty.Name, self.empty.TextXAlignment, self.empty.TextSize = "Empty", Enum.TextXAlignment.Center, 13
    return self
end
function PetsView:setOpen(open) self.panel.Visible = open and self.hasStation end
function PetsView:toggle() if self.hasStation then self:setOpen(not self.panel.Visible) end end
function PetsView:armed(key) return self.confirm.key == key and os.clock() &lt; (self.confirm.untilTime or 0) end
-- Destructive requests need a second tap within a few seconds.
function PetsView:arm(key, action, argument)
    if not self.hasStation then return end
    if self:armed(key) then
        self.confirm = {}
        self.send(action, argument)
    else
        self.confirm = { key = key, untilTime = os.clock() + ConfirmSeconds }
    end
    if self.state then self:update(self.state) end
end
function PetsView:delete(id) self:arm("pet:" .. id, "DeletePet", id) end
function PetsView:merge()
    local first = self.mergeable and self.mergeable[1]
    if self.hasStation and first then self.send("MergePets", first.type) end
end
local function sorted(owned)
    local list = table.clone(owned)
    table.sort(list, function(a, b)
        if a.equipped ~= b.equipped then return a.equipped end
        if a.rank ~= b.rank then return a.rank &gt; b.rank end
        if a.golden ~= b.golden then return a.golden end
        return tonumber(string.sub(a.id, 2)) &lt; tonumber(string.sub(b.id, 2))
    end)
    return list
end
function PetsView:row(pet, order, full)
    local accent = if pet.golden then Theme.Gold else PetText.color(pet.rarity)
    local row = E.box(self.list, pet.id, UDim2.new(), UDim2.new(1, 0, 0, RowHeight), Theme.Card, 12)
    row.LayoutOrder = order
    E.stroke(row, accent, if pet.equipped or pet.golden then 2 else 1, if pet.equipped then 0 else 0.6)
    local name = E.label(row, pet.name, 22, accent)
    name.Name, name.Position, name.Size = "PetName", UDim2.fromOffset(12, 7), UDim2.new(1, -180, 0, 22)
    name.Font, name.TextSize = Enum.Font.GothamBold, 14
    E.fit(name, 9, 14)
    local tags = string.upper(pet.rarity) .. (if pet.golden then "  ·  GOLDEN" else "") .. (if pet.equipped then "  ·  EQUIPPED" else "")
    local detail = E.label(row, tags, 14, Theme.Muted)
    detail.Name, detail.Position, detail.Size, detail.TextSize = "Rarity", UDim2.fromOffset(12, 29), UDim2.new(1, -180, 0, 14), 9
    local bonus = E.label(row, PetText.bonus(pet.bonuses, true), 14, Theme.GoldLight)
    bonus.Name, bonus.Position, bonus.Size, bonus.TextSize = "Bonus", UDim2.fromOffset(12, 43), UDim2.new(1, -180, 0, 14), 10
    E.fit(bonus, 7, 10)
    local canEquip = pet.equipped or not full
    local equip = E.button(row, if pet.equipped then "UNEQUIP" else "EQUIP", function()
        if not self.hasStation then return end
        if pet.equipped then self.send("Unequip", pet.id) elseif not full then self.send("Equip", pet.id) end
    end, if pet.equipped then Theme.Background elseif canEquip then Theme.Gold else Theme.Background)
    equip.Name, equip.AnchorPoint = "Equip", Vector2.new(1, 0.5)
    equip.Position, equip.Size = UDim2.new(1, if pet.equipped then -8 else -78, 0.5, 0), UDim2.fromOffset(84, 38)
    equip.TextSize, equip.AutoButtonColor = 11, canEquip
    equip.TextColor3 = if pet.equipped then Theme.Text elseif canEquip then Theme.Ink else Theme.Muted
    equip.Active, equip.Selectable = canEquip, canEquip
    if not pet.equipped then
        local armed = self:armed("pet:" .. pet.id)
        local delete = E.button(row, if armed then "SURE?" else "DELETE", function() self:delete(pet.id) end,
            if armed then Theme.Red else Theme.Background)
        delete.Name, delete.AnchorPoint, delete.Position, delete.Size = "Delete", Vector2.new(1, 0.5), UDim2.new(1, -8, 0.5, 0), UDim2.fromOffset(64, 38)
        delete.TextSize, delete.TextColor3 = 10, if armed then Theme.Ink else Theme.Red
        E.stroke(delete, Theme.Red, 1, 0.5)
    end
    return row
end
function PetsView:update(state)
    self.state = state
    self.hasStation = state.hasStation
    self.button.Active, self.button.Selectable, self.button.AutoButtonColor = state.hasStation, state.hasStation, state.hasStation
    self.button.TextColor3 = if state.hasStation then Theme.Blue else Theme.Muted
    if not state.hasStation then self.panel.Visible = false end
    local pets = state.pets
    if not pets then return end
    local full = pets.equipped &gt;= pets.slots
    self.caption.Text = "Equipped " .. pets.equipped .. " / " .. pets.slots .. "  ·  " .. #pets.owned .. " / " .. pets.max .. " pets"
    self.empty.Visible = #pets.owned == 0
    -- Tools: auto-delete chips are toggles; delete-all chips need a second tap.
    local autoDelete = pets.autoDelete or {}
    for rarity, chip in pairs(self.autoChips) do
        local on = autoDelete[rarity] == true
        chip.BackgroundColor3 = if on then Theme.Red else Theme.Card
        chip.TextColor3 = if on then Theme.Ink else PetText.color(rarity)
    end
    for rarity, chip in pairs(self.clearChips) do
        local armed = self:armed("rarity:" .. rarity)
        chip.Text = if armed then "SURE?" else string.upper(rarity)
        chip.BackgroundColor3 = if armed then Theme.Red else Theme.Card
        chip.TextColor3 = if armed then Theme.Ink else PetText.color(rarity)
    end
    self.mergeable = pets.mergeable or {}
    local first = self.mergeable[1]
    self.mergeButton.Visible, self.mergeButton.Active = first ~= nil, first ~= nil
    self.mergeText.Text = if first then "Merge " .. (pets.mergeCount or 5) .. " " .. first.name .. " into a Golden "
        .. first.name .. " (2x bonus)" .. (if #self.mergeable &gt; 1 then "  ·  +" .. (#self.mergeable - 1) .. " more" else "")
        else "Collect " .. (pets.mergeCount or 5) .. " unequipped copies of a pet to merge them into a Golden pet (2x bonus)."
    self.mergeText.TextColor3 = if first then Theme.GoldLight else Theme.Muted
    -- Rebuild rows only when the pets, their state, or a Delete confirmation changes.
    local parts = { tostring(full), tostring(self.confirm.key), tostring(self:armed(self.confirm.key)) }
    for _, pet in ipairs(pets.owned) do table.insert(parts, pet.id .. (if pet.equipped then "*" else "") .. (if pet.golden then "g" else "")) end
    local signature = table.concat(parts, ",")
    if signature == self.signature then return end
    self.signature = signature
    for _, row in pairs(self.rows) do row:Destroy() end
    self.rows = {}
    for order, pet in ipairs(sorted(pets.owned)) do self.rows[pet.id] = self:row(pet, order, full) end
end
function PetsView:resize(viewport)
    self.scale.Scale = math.min(1, (viewport.X - 32) / PanelWidth, (viewport.Y - 60 - 24) / PanelHeight)
end
return PetsView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00054">
            <Properties>
              <string name="Name">RebirthView</string>
              <ProtectedString name="Source">-- Rebirth: a REBIRTH button and a confirmation panel. The server checks the threshold,
-- resets Cash and the bag, and awards gems; this view only displays and requests.
local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local RebirthView = {}
RebirthView.__index = RebirthView
local PanelWidth, PanelHeight = 340, 312
local function line(parent, name, text, y, height, color, size)
    local label = E.label(parent, text, height, color)
    label.Name, label.Position, label.Size, label.TextSize = name, UDim2.fromOffset(20, y), UDim2.fromOffset(PanelWidth - 40, height), size
    return label
end
function RebirthView.new(gui, send)
    local self = setmetatable({ send = send, hasStation = false, ready = false, count = nil }, RebirthView)
    self.button = E.button(gui, "REBIRTH", function() self:toggle() end, Theme.Background)
    self.button.Name, self.button.TextSize, self.button.TextColor3 = "RebirthButton", 13, Theme.Gem
    self.button.Size = UDim2.fromOffset(105, 44)
    self.buttonStroke = E.stroke(self.button, Theme.Gem, 1.5, 0.3)
    E.fit(self.button, 8, 13)

    local panel = E.box(gui, "RebirthPanel", UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(PanelWidth, PanelHeight), Theme.Background, 18)
    panel.AnchorPoint, panel.Visible = Vector2.new(0.5, 0.5), false
    panel.ZIndex = 5 -- above the HUD buttons when open
    E.stroke(panel, Theme.Gem, 2, 0.12)
    self.panel = panel
    self.scale = Instance.new("UIScale")
    self.scale.Parent = panel
    local title = line(panel, "Title", "REBIRTH", 14, 28, Theme.Text, 21)
    title.Font, title.Size = Enum.Font.GothamBold, UDim2.fromOffset(240, 28)
    local caption = line(panel, "Caption", "Trade your Cash for gems", 42, 16, Theme.Muted, 11)
    caption.Size = UDim2.fromOffset(240, 16)
    self.close = E.button(panel, "X", function() self:setOpen(false) end, Theme.Card)
    self.close.Name, self.close.Position, self.close.Size = "Close", UDim2.fromOffset(PanelWidth - 52, 14), UDim2.fromOffset(36, 36)
    self.close.TextColor3, self.close.TextSize = Theme.Text, 14

    local card = E.box(panel, "Details", UDim2.fromOffset(16, 70), UDim2.fromOffset(PanelWidth - 32, 164), Theme.Card, 14)
    self.reward = E.label(card, "+10 GEMS", 32, Theme.Gem)
    self.reward.Name, self.reward.Position, self.reward.Size = "Reward", UDim2.fromOffset(14, 8), UDim2.fromOffset(PanelWidth - 60, 32)
    self.reward.Font, self.reward.TextSize = Enum.Font.GothamBold, 24
    self.need = E.label(card, "", 18, Theme.Text)
    self.need.Name, self.need.Position, self.need.Size, self.need.TextSize = "Need", UDim2.fromOffset(14, 44), UDim2.fromOffset(PanelWidth - 60, 18), 13
    -- Large amounts shrink to one line instead of wrapping out of the card.
    self.need.TextScaled, self.need.TextWrapped = true, false
    local fit = Instance.new("UITextSizeConstraint")
    fit.MinTextSize, fit.MaxTextSize, fit.Parent = 8, 13, self.need
    local track
    track, self.fill = E.bar(card, Theme.Gem, 8)
    track.Position, track.Size, track.BackgroundColor3 = UDim2.fromOffset(14, 66), UDim2.fromOffset(PanelWidth - 60, 8), Theme.Background
    local resets = E.label(card, "Resets: your Cash and current bag", 16, Theme.Muted)
    resets.Name, resets.Position, resets.Size, resets.TextSize = "Resets", UDim2.fromOffset(14, 88), UDim2.fromOffset(PanelWidth - 60, 16), 12
    local keeps = E.label(card, "Keeps: gems, upgrades, and rebirth count", 16, Theme.Muted)
    keeps.Name, keeps.Position, keeps.Size, keeps.TextSize = "Keeps", UDim2.fromOffset(14, 108), UDim2.fromOffset(PanelWidth - 60, 16), 12
    self.countLabel = E.label(card, "REBIRTHS: 0", 16, Theme.Muted)
    self.countLabel.Name, self.countLabel.Position, self.countLabel.Size = "Count", UDim2.fromOffset(14, 136), UDim2.fromOffset(PanelWidth - 60, 16)
    self.countLabel.TextSize = 11

    self.confirm = E.button(panel, "REBIRTH", function() self:rebirth() end, Theme.Green)
    self.confirm.Name, self.confirm.Position, self.confirm.Size = "Confirm", UDim2.fromOffset(16, 248), UDim2.fromOffset(PanelWidth - 32, 48)
    self.confirm.AutoButtonColor, self.confirm.TextColor3, self.confirm.TextSize = false, Theme.Ink, 16
    return self
end
function RebirthView:setOpen(open) self.panel.Visible = open and self.hasStation end
function RebirthView:toggle() if self.hasStation then self:setOpen(not self.panel.Visible) end end
function RebirthView:rebirth()
    if self.hasStation and self.ready and self.panel.Visible then self.send("Rebirth") end
end
function RebirthView:update(state)
    local info = state.rebirth
    self.hasStation = state.hasStation
    self.button.Active, self.button.Selectable, self.button.AutoButtonColor = state.hasStation, state.hasStation, state.hasStation
    if not state.hasStation then self.panel.Visible = false end
    if not info then return end
    -- A completed rebirth closes the panel; the Cash and Gems card shows the result.
    if self.count and info.count &gt; self.count then self.panel.Visible = false end
    self.count = info.count
    self.ready = state.hasStation and state.profile.cash &gt;= info.threshold
    local glow = self.ready
    self.button.BackgroundColor3 = if glow then Theme.Gem else Theme.Background
    self.button.TextColor3 = if glow then Theme.Ink elseif state.hasStation then Theme.Gem else Theme.Muted
    self.reward.Text = "+" .. E.count(info.reward) .. " GEMS"
    self.need.Text = "Needs " .. E.money(info.threshold) .. " Cash  (you have " .. E.money(state.profile.cash) .. ")"
    self.fill.Size = UDim2.fromScale(math.clamp(state.profile.cash / info.threshold, 0, 1), 1)
    self.countLabel.Text = "REBIRTHS: " .. E.count(info.count)
    self.confirm.Active, self.confirm.Selectable = self.ready, self.ready
    self.confirm.Text = if self.ready then "REBIRTH NOW" else "NEED " .. E.money(info.threshold)
    self.confirm.BackgroundColor3 = if self.ready then Theme.Green else Theme.Card
    self.confirm.TextColor3 = if self.ready then Theme.Ink else Theme.Muted
end
function RebirthView:resize(viewport)
    self.scale.Scale = math.min(1, (viewport.X - 32) / PanelWidth, (viewport.Y - 60 - 24) / PanelHeight)
end
return RebirthView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00055">
            <Properties>
              <string name="Name">RestaurantGuides</string>
              <ProtectedString name="Source">local Theme = require(script.Parent.Theme)
local RestaurantGuides = {}
RestaurantGuides.__index = RestaurantGuides
local FLOW_CYCLES_PER_SECOND = 0.8
-- Reuse fade values rather than allocating a new sequence for every chevron each frame.
local fades = {}
for i = 0, 20 do fades[i] = NumberSequence.new(1 - 0.9 * i / 20) end

local function beam(parent, name, start, finish)
    local line = Instance.new("Beam")
    line.Name, line.Attachment0, line.Attachment1 = name, start, finish
    line.Width0, line.Width1, line.Segments = 0.22, 0.22, 1
    line.FaceCamera, line.LightInfluence, line.LightEmission = true, 0, 0.5
    line.Color, line.Transparency = ColorSequence.new(Theme.Gold), NumberSequence.new(0.1)
    line.Enabled, line.Parent = false, parent
    return line
end

local function chevron(parent, index)
    local points = {}
    for _, name in ipairs({"Left", "Tip", "Right"}) do
        local point = Instance.new("Attachment")
        point.Name, point.Parent = "Chevron" .. index .. name, parent
        points[name] = point
    end
    points.leftArm = beam(parent, "Chevron" .. index .. "LeftArm", points.Left, points.Tip)
    points.rightArm = beam(parent, "Chevron" .. index .. "RightArm", points.Right, points.Tip)
    return points
end

function RestaurantGuides.new()
    local folder = Instance.new("Folder")
    folder.Name, folder.Parent = "RestaurantGuides", workspace
    return setmetatable({ folder = folder, entries = {}, phase = 0 }, RestaurantGuides)
end

function RestaurantGuides:setTarget(index, entrance)
    local entry = self.entries[index]
    if entry and entry.entrance ~= entrance then
        entry.finish:Destroy()
        entry.base:Destroy()
        self.entries[index], entry = nil, nil
    end
    if not entrance or entry then return end
    local finish = Instance.new("Attachment")
    finish.Name, finish.Position, finish.Parent = "RestaurantGuideEnd", Vector3.new(0, 1, 0), entrance
    local base = Instance.new("Part")
    base.Name, base.Size = "ChevronGuide" .. index, Vector3.new(0.1, 0.1, 0.1)
    base.Anchored, base.Transparency = true, 1
    base.CanCollide, base.CanTouch, base.CanQuery, base.CastShadow = false, false, false, false
    base.Parent = self.folder
    self.entries[index] = { entrance = entrance, finish = finish, base = base, chevrons = {} }
end

function RestaurantGuides:step(character, dt)
    self.phase = (self.phase + math.max(dt or 0, 0) * FLOW_CYCLES_PER_SECOND) % 1
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local head = character and character:FindFirstChild("Head")
    if not humanoid or humanoid.Health &lt;= 0 or not next(self.entries) then head = nil end
    if self.head ~= head then
        if self.origin then self.origin:Destroy() end
        self.head, self.origin = head, nil
        if head then
            local origin = Instance.new("Attachment")
            origin.Name, origin.Position = "RestaurantGuideStart", Vector3.new(0, head.Size.Y / 2 + 1.5, 0)
            origin.Parent, self.origin = head, origin
        end
    end
    for _, entry in pairs(self.entries) do
        local count = 0
        if self.origin and entry.entrance.Parent then
            local finish = entry.finish.WorldPosition
            local delta = finish - self.origin.WorldPosition
            local length = delta.Magnitude
            if length &gt; 1 then
                entry.base.Position = self.origin.WorldPosition
                local direction = delta.Unit
                local camera = workspace.CurrentCamera
                local look = if camera and camera.CFrame then camera.CFrame.LookVector else Vector3.new(0, -1, 0)
                local side = direction:Cross(look)
                if side.Magnitude &lt; 0.001 then side = direction:Cross(Vector3.new(0, 1, 0)) end
                side = if side.Magnitude &lt; 0.001 then Vector3.new(1, 0, 0) else side.Unit
                count = math.clamp(math.floor(length / 6), 1, 24)
                local depth = math.min(1.8, length / 3)
                -- Reuse a bounded set of open &gt; shapes, with clear gaps and no connecting shaft.
                for i = 1, count do
                    local mark = entry.chevrons[i]
                    if not mark then mark = chevron(entry.base, i); entry.chevrons[i] = mark end
                    local distance = ((i - 0.5 + self.phase) % count) * length / count
                    local center = direction * distance
                    -- Fade and shrink at the ends so the looping pattern never jumps visibly
                    -- or extends beyond the player's head and the restaurant endpoint.
                    local edge = math.min(distance, length - distance)
                    local halfDepth = math.min(depth / 2, edge)
                    local rear = center - direction * halfDepth
                    mark.Tip.Position = center + direction * halfDepth
                    mark.Left.Position = rear + side * halfDepth
                    mark.Right.Position = rear - side * halfDepth
                    local fade = fades[math.floor(math.min(edge / depth, 1) * 20 + 0.5)]
                    mark.leftArm.Transparency, mark.rightArm.Transparency = fade, fade
                end
            end
        end
        for i, mark in ipairs(entry.chevrons) do
            mark.leftArm.Enabled, mark.rightArm.Enabled = i &lt;= count, i &lt;= count
        end
    end
end

return RestaurantGuides
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00056">
            <Properties>
              <string name="Name">RestaurantMarkers</string>
              <ProtectedString name="Source">local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Runtime = require(Shared.config.Runtime)
local E = require(script.Parent.Elements)
local Theme = require(script.Parent.Theme)
local RestaurantGuides = require(script.Parent.RestaurantGuides)
local RestaurantMarkers = {}
RestaurantMarkers.__index = RestaurantMarkers

function RestaurantMarkers.new(playerGui, userId)
    return setmetatable({ playerGui = playerGui, userId = userId, entries = {}, guides = RestaurantGuides.new() }, RestaurantMarkers)
end

function RestaurantMarkers:create(index, station)
    local gui = Instance.new("BillboardGui")
    gui.Name, gui.Size = "RestaurantMarker" .. index, UDim2.fromOffset(220, 104)
    gui.ResetOnSpawn, gui.AlwaysOnTop, gui.LightInfluence = false, true, 0
    gui.MaxDistance, gui.Enabled = 240, false
    gui.Parent = self.playerGui

    local available = E.box(gui, "Available", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), Theme.Background, 0)
    available.BackgroundTransparency = 1
    local caption = E.box(available, "Caption", UDim2.fromOffset(40, 0), UDim2.fromOffset(140, 28), Theme.Background, 10)
    E.stroke(caption, Theme.Gold, 1.5)
    local label = E.label(caption, "AVAILABLE", 28, Theme.Gold)
    label.Font, label.TextSize, label.TextXAlignment = Enum.Font.GothamBold, 13, Enum.TextXAlignment.Center

    local owner = E.box(gui, "Owner", UDim2.fromOffset(0, 14), UDim2.fromOffset(220, 76), Theme.Background, 16)
    E.stroke(owner, Theme.Gold, 2)
    local portrait = E.box(owner, "Portrait", UDim2.fromOffset(8, 8), UDim2.fromOffset(60, 60), Theme.Card, 30)
    local fallback = E.label(portrait, "?", 60, Theme.Gold)
    fallback.Name, fallback.TextSize, fallback.TextXAlignment = "Fallback", 30, Enum.TextXAlignment.Center
    local avatar = Instance.new("ImageLabel")
    avatar.Name, avatar.Size, avatar.BackgroundTransparency = "Avatar", UDim2.fromScale(1, 1), 1
    avatar.Image, avatar.Visible, avatar.Parent = "", false, portrait
    E.corner(avatar, 30)
    local title = E.label(owner, "RESTAURANT " .. index, 18, Theme.Muted)
    title.Position, title.Size, title.TextSize = UDim2.fromOffset(78, 14), UDim2.fromOffset(132, 18), 10
    local username = E.label(owner, "", 28, Theme.Text)
    username.Name, username.Position, username.Size = "Username", UDim2.fromOffset(78, 33), UDim2.fromOffset(132, 28)
    username.Font, username.TextScaled, username.TextWrapped = Enum.Font.GothamBold, true, false
    local limit = Instance.new("UITextSizeConstraint")
    limit.MinTextSize, limit.MaxTextSize, limit.Parent = 9, 15, username
    return { station = station, gui = gui, available = available, owner = owner,
        username = username, avatar = avatar, fallback = fallback, ownerId = 0, generation = 0, attempts = 0 }
end

function RestaurantMarkers:loadPortrait(entry)
    if entry.ownerId &lt;= 0 or entry.pending or entry.avatar.Visible or entry.attempts &gt;= 3
        or os.clock() &lt; (entry.nextAttempt or 0) then return end
    entry.pending, entry.attempts = true, entry.attempts + 1
    local ownerId, generation = entry.ownerId, entry.generation
    -- Thumbnail requests yield and can fail; they must never delay claiming or the HUD.
    task.spawn(function()
        local ok, content, ready = pcall(function()
            return Players:GetUserThumbnailAsync(ownerId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
        end)
        if not entry.gui.Parent or entry.generation ~= generation then return end
        entry.pending, entry.nextAttempt = false, os.clock() + 5
        if ok and ready and type(content) == "string" and content ~= "" then
            entry.avatar.Image, entry.avatar.Visible = content, true
            entry.fallback.Visible = false
        end
    end)
end

function RestaurantMarkers:update(hasStation)
    local world = workspace:FindFirstChild("FriesRestaurant")
    local ownsRestaurant = hasStation
    -- Replicated ownership also hides guidance while the private claim snapshot is in flight.
    for index = 1, Runtime.StationCount do
        local station = world and world:FindFirstChild("Station" .. index)
        if station and station:GetAttribute("OwnerUserId") == self.userId then ownsRestaurant = true end
    end
    for index = 1, Runtime.StationCount do
        local station = world and world:FindFirstChild("Station" .. index)
        local entry = self.entries[index]
        if entry and entry.station ~= station then
            entry.gui:Destroy()
            self.entries[index], entry = nil, nil
        end
        local entrance = station and station:FindFirstChild("ClaimPoint")
        local roof = station and station:FindFirstChild("RoofCap")
        local target = nil
        if entrance and roof then
            if not entry then entry = self:create(index, station); self.entries[index] = entry end
            local ownerId = station:GetAttribute("OwnerUserId") or 0
            if entry.ownerId ~= ownerId then
                entry.ownerId, entry.generation = ownerId, entry.generation + 1
                entry.pending, entry.attempts, entry.nextAttempt = false, 0, 0
                entry.avatar.Image, entry.avatar.Visible, entry.fallback.Visible = "", false, true
            end
            local claimed = ownerId ~= 0
            entry.owner.Visible, entry.available.Visible = claimed, not claimed and not ownsRestaurant
            if not claimed and not ownsRestaurant then target = entrance end
            entry.gui.Enabled = claimed or not ownsRestaurant
            entry.gui.Adornee = if claimed then roof else entrance
            entry.gui.StudsOffsetWorldSpace = Vector3.new(0, if claimed then 4 else 3, 0)
            if claimed then
                local username = station:GetAttribute("OwnerUsername") or "Player"
                entry.username.Text = "@" .. username
                entry.fallback.Text = string.upper(string.sub(username, 1, 1))
                self:loadPortrait(entry)
            end
        elseif entry then
            entry.gui.Enabled = false
        end
        self.guides:setTarget(index, target)
    end
end

return RestaurantMarkers
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00057">
            <Properties>
              <string name="Name">SettingsView</string>
              <ProtectedString name="Source">-- Settings: a gear button beside Return to Counter and a panel of saved ON/OFF toggles.
-- The server saves each setting; this view only displays and requests changes.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Config = require(Shared.config.Settings)
local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local SettingsView = {}
SettingsView.__index = SettingsView
local PanelWidth, PanelHeight, RowHeight = 340, 92 + #Config.Order * 76, 68
-- A code-built gear: four bars under a ring with a dark centre.
local function gear(parent)
    for index = 0, 3 do
        local tooth = E.box(parent, "Tooth" .. index, UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(5, 24), Theme.Muted, 1)
        tooth.AnchorPoint, tooth.Rotation = Vector2.new(0.5, 0.5), index * 45
    end
    local ring = E.box(parent, "Ring", UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(18, 18), Theme.Muted, 9)
    ring.AnchorPoint = Vector2.new(0.5, 0.5)
    local hole = E.box(parent, "Hole", UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(8, 8), Theme.Background, 4)
    hole.AnchorPoint = Vector2.new(0.5, 0.5)
end
function SettingsView.new(gui, send)
    local self = setmetatable({ send = send, rows = {}, hasStation = true }, SettingsView)
    self.button = E.button(gui, "", function() self:toggle() end, Theme.Background)
    self.button.Name, self.button.Size = "SettingsButton", UDim2.fromOffset(44, 44)
    E.stroke(self.button, Theme.Muted, 1.5, 0.4)
    gear(self.button)

    local panel = E.box(gui, "SettingsPanel", UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(PanelWidth, PanelHeight), Theme.Background, 18)
    panel.AnchorPoint, panel.Visible, panel.ZIndex = Vector2.new(0.5, 0.5), false, 5
    E.stroke(panel, Theme.Muted, 2, 0.2)
    self.panel = panel
    self.scale = Instance.new("UIScale")
    self.scale.Parent = panel
    local title = E.label(panel, "SETTINGS", 28, Theme.Text)
    title.Name, title.Position, title.Size = "Title", UDim2.fromOffset(20, 14), UDim2.fromOffset(240, 28)
    title.Font, title.TextSize = Enum.Font.GothamBold, 21
    local caption = E.label(panel, "Saved to your profile", 16, Theme.Muted)
    caption.Position, caption.Size, caption.TextSize = UDim2.fromOffset(20, 42), UDim2.fromOffset(240, 16), 11
    self.close = E.button(panel, "X", function() self:setOpen(false) end, Theme.Card)
    self.close.Name, self.close.Position, self.close.Size = "Close", UDim2.fromOffset(PanelWidth - 52, 14), UDim2.fromOffset(36, 36)
    self.close.TextColor3, self.close.TextSize = Theme.Text, 14
    for index, key in ipairs(Config.Order) do
        local row = E.box(panel, key, UDim2.fromOffset(16, 70 + (index - 1) * (RowHeight + 8)), UDim2.fromOffset(PanelWidth - 32, RowHeight), Theme.Card, 14)
        local name = E.label(row, Config.Names[key], 22, Theme.Text)
        name.Name, name.Position, name.Size = "SettingName", UDim2.fromOffset(14, 8), UDim2.fromOffset(PanelWidth - 140, 22)
        name.Font, name.TextSize = Enum.Font.GothamBold, 14
        E.fit(name, 9, 14)
        local hint = E.label(row, Config.Hints[key], 30, Theme.Muted)
        hint.Name, hint.Position, hint.Size, hint.TextSize = "Hint", UDim2.fromOffset(14, 32), UDim2.fromOffset(PanelWidth - 140, 30), 10
        local switch = E.button(row, "", function() self.send("ToggleSetting", key) end, Theme.Green)
        switch.Name, switch.AnchorPoint, switch.Position, switch.Size = "Toggle", Vector2.new(1, 0.5), UDim2.new(1, -12, 0.5, 0), UDim2.fromOffset(76, 36)
        switch.TextSize, switch.AutoButtonColor = 13, false
        E.stroke(switch, Theme.Muted, 1.5, 0.4)
        self.rows[key] = switch
    end
    return self
end
function SettingsView:setOpen(open) self.panel.Visible = open end
function SettingsView:toggle() self:setOpen(not self.panel.Visible) end
function SettingsView:update(state)
    local values = state.settings or {}
    for key, switch in pairs(self.rows) do
        local on = values[key] ~= false
        switch.Text = if on then "ON" else "OFF"
        switch.BackgroundColor3 = if on then Theme.Green else Theme.Card
        switch.TextColor3 = if on then Theme.Ink else Theme.Muted
    end
end
function SettingsView:resize(viewport)
    self.scale.Scale = math.min(1, (viewport.X - 32) / PanelWidth, (viewport.Y - 60 - 24) / PanelHeight)
end
return SettingsView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00058">
            <Properties>
              <string name="Name">ShopView</string>
              <ProtectedString name="Source">-- Upgrade shop: an UPGRADES button and a panel with one row per gem upgrade track.
-- Rows display server-computed levels, values, and costs; the server decides purchases.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Upgrades = require(Shared.config.Upgrades)
local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local ShopView = {}
ShopView.__index = ShopView
local PanelWidth, PanelHeight = 360, 322
local function describe(row)
    if row.id == "MoneyPerFry" then
        return string.format("$%.2f → $%.2f per fry", row.value, row.nextValue)
    elseif row.id == "FriesPerClick" then
        return E.number(row.value) .. " → " .. E.number(row.nextValue) .. " fries/click"
    end
    return E.number(row.value) .. " → " .. E.number(row.nextValue) .. " fries per bag"
end
function ShopView.new(gui, send)
    local self = setmetatable({ send = send, rows = {}, data = {}, hasStation = false }, ShopView)
    self.button = E.button(gui, "UPGRADES", function() self:toggle() end, Theme.Background)
    self.button.Name, self.button.TextSize, self.button.TextColor3 = "UpgradesButton", 13, Theme.Gold
    self.button.Size = UDim2.fromOffset(218, 44)
    E.stroke(self.button, Theme.Gold, 1.5, 0.3)
    E.fit(self.button, 8, 13)

    local panel = E.box(gui, "UpgradeShop", UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(PanelWidth, PanelHeight), Theme.Background, 18)
    panel.AnchorPoint, panel.Visible = Vector2.new(0.5, 0.5), false
    panel.ZIndex = 5 -- above the HUD buttons when open
    E.stroke(panel, Theme.Gold, 2, 0.12)
    self.panel = panel
    self.scale = Instance.new("UIScale")
    self.scale.Parent = panel
    local title = E.label(panel, "UPGRADES", 28, Theme.Text)
    title.Name, title.Position, title.Size = "Title", UDim2.fromOffset(20, 14), UDim2.fromOffset(250, 28)
    title.Font, title.TextSize = Enum.Font.GothamBold, 21
    local caption = E.label(panel, "Spend gems to boost your restaurant", 16, Theme.Muted)
    caption.Position, caption.Size, caption.TextSize = UDim2.fromOffset(20, 42), UDim2.fromOffset(260, 16), 11
    self.close = E.button(panel, "X", function() self:setOpen(false) end, Theme.Card)
    self.close.Name, self.close.Position, self.close.Size = "Close", UDim2.fromOffset(PanelWidth - 52, 14), UDim2.fromOffset(36, 36)
    self.close.TextColor3, self.close.TextSize = Theme.Text, 14

    for index, id in ipairs(Upgrades.Order) do
        local row = E.box(panel, id, UDim2.fromOffset(16, 70 + (index - 1) * 82), UDim2.fromOffset(PanelWidth - 32, 74), Theme.Card, 14)
        local name = E.label(row, Upgrades.Tracks[id].Name, 22, Theme.Text)
        name.Name, name.Position, name.Size = "TrackName", UDim2.fromOffset(14, 8), UDim2.fromOffset(190, 22)
        name.Font, name.TextSize = Enum.Font.GothamBold, 15
        local level = E.label(row, "LEVEL 0", 16, Theme.Muted)
        level.Name, level.Position, level.Size, level.TextSize = "Level", UDim2.fromOffset(14, 30), UDim2.fromOffset(190, 16), 11
        local value = E.label(row, "", 18, Theme.GoldLight)
        value.Name, value.Position, value.Size, value.TextSize = "Value", UDim2.fromOffset(14, 48), UDim2.fromOffset(196, 18), 12
        value.TextWrapped = false
        local buy = E.button(row, "", function() self:buy(id) end, Theme.Gold)
        buy.Name, buy.Position, buy.Size = "Buy", UDim2.fromOffset(PanelWidth - 32 - 112, 15), UDim2.fromOffset(100, 44)
        buy.AutoButtonColor, buy.TextColor3 = false, Theme.Ink
        self.rows[id] = { level = level, value = value, buy = buy }
    end
    return self
end
function ShopView:setOpen(open)
    self.panel.Visible = open and self.hasStation
end
function ShopView:toggle()
    if self.hasStation then self:setOpen(not self.panel.Visible) end
end
function ShopView:buy(id)
    local data = self.data[id]
    if self.hasStation and data and data.affordable then self.send("Upgrade", id) end
end
function ShopView:update(state)
    self.hasStation = state.hasStation
    self.button.Active, self.button.Selectable, self.button.AutoButtonColor = state.hasStation, state.hasStation, state.hasStation
    self.button.TextColor3 = if state.hasStation then Theme.Gold else Theme.Muted
    if not state.hasStation then self.panel.Visible = false end
    for _, row in ipairs(state.shop or {}) do
        local view = self.rows[row.id]
        if view then
            local affordable = state.hasStation and (state.profile.gems or 0) &gt;= row.cost
            self.data[row.id] = { affordable = affordable }
            view.level.Text = "LEVEL " .. row.level
            view.value.Text = describe(row)
            view.buy.Text = E.count(row.cost) .. (if row.cost == 1 then " GEM" else " GEMS")
            view.buy.TextSize = if #view.buy.Text &gt; 10 then 11 else 14
            view.buy.Active, view.buy.Selectable = affordable, affordable
            view.buy.BackgroundColor3 = if affordable then Theme.Gold else Theme.Background
            view.buy.TextColor3 = if affordable then Theme.Ink else Theme.Muted
        end
    end
end
-- AppView places the button; the panel scales to fit the screen.
function ShopView:resize(viewport)
    self.scale.Scale = math.min(1, (viewport.X - 32) / PanelWidth, (viewport.Y - 60 - 24) / PanelHeight)
end
return ShopView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00059">
            <Properties>
              <string name="Name">Theme</string>
              <ProtectedString name="Source">return {
    Background = Color3.fromRGB(35, 43, 42),
    Card = Color3.fromRGB(49, 61, 55),
    Text = Color3.fromRGB(255, 248, 228),
    Muted = Color3.fromRGB(198, 207, 191),
    Gold = Color3.fromRGB(255, 199, 70),
    GoldLight = Color3.fromRGB(255, 221, 127),
    Green = Color3.fromRGB(107, 218, 153),
    GreenLight = Color3.fromRGB(155, 239, 183),
    Red = Color3.fromRGB(244, 112, 111),
    Blue = Color3.fromRGB(92, 175, 243),
    Gem = Color3.fromRGB(183, 140, 255),
    Ink = Color3.fromRGB(57, 44, 25),
    Shadow = Color3.fromRGB(25, 31, 28),
}
</ProtectedString>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
