function Recipes.FryUnicorn(b)
    b.body("Ball", { 1.5, 1.5, 1.5 }, { 0, 0, 0 }, rgb(252, 250, 255))
    b.add("Block", { 0.2, 0.9, 0.2 }, { 0, 1.0, -0.25 }, rgb(255, 214, 90), { name = "Horn", rotation = CFrame.Angles(-0.35, 0, 0) })
    for index, tint in ipairs({ rgb(255, 92, 168), rgb(255, 183, 3), rgb(76, 201, 240), rgb(123, 44, 191) }) do
        b.add("Ball", { 0.4, 0.4, 0.4 }, { 0.15 - index * 0.05, 0.75 - index * 0.25, 0.55 }, tint, { name = "Mane" .. index })
    end
    for _, side in ipairs({ -1, 1 }) do
        b.add("Block", { 0.2, 0.36, 0.2 }, { side * 0.4, 0.75, 0.05 }, rgb(240, 236, 250), { name = "Ear", rotation = CFrame.Angles(0, 0, side * -0.3) })
    end
    b.face(-0.7, 0.18, 0.28, 0.3)
    b.feet(-0.75, 0.38, rgb(230, 220, 240))
end
function Recipes.FryEmperor(b)
    b.body("Block", { 1.1, 2.1, 1.1 }, { 0, 0.05, 0 }, rgb(255, 214, 90))
    for index, y in ipairs({ -0.6, 0.0 }) do
        b.add("Block", { 1.14, 0.1, 1.14 }, { 0, y, 0 }, rgb(236, 170, 40), { name = "Crinkle" .. index })
    end
    b.add("Block", { 1.4, 1.8, 0.12 }, { 0, -0.1, 0.62 }, rgb(90, 24, 154), { name = "Cape" })
    b.add("Block", { 1.42, 0.2, 0.14 }, { 0, -0.95, 0.62 }, rgb(255, 255, 255), { name = "Ermine" })
    b.add("Cylinder", { 0.5, 1.2, 1.2 }, { 0, 1.35, 0 }, rgb(255, 183, 3), { upright = true, name = "Crown", body = false })
    for index = 0, 4 do
        local angle = index * math.pi * 2 / 5
        b.add("Ball", { 0.22, 0.22, 0.22 }, { math.cos(angle) * 0.5, 1.7, math.sin(angle) * 0.5 }, if index % 2 == 0 then rgb(230, 57, 70) else rgb(76, 201, 240), { name = "Jewel" .. index })
    end
    b.add("Block", { 0.12, 1.4, 0.12 }, { 0.8, 0.0, -0.2 }, rgb(255, 183, 3), { name = "Scepter" })
    b.add("Ball", { 0.3, 0.3, 0.3 }, { 0.8, 0.75, -0.2 }, rgb(123, 44, 191), { name = "ScepterGem", neon = true })
    b.face(-0.56, 0.45, 0.22, 0.32)
    b.feet(-1.02, 0.28, rgb(214, 140, 40))
end
PetModels.Recipes = Recipes
-- Returns a Model plus its pieces and local offsets, for callers to place each frame.
function PetModels.build(petType, golden, parent)
    local model = Instance.new("Model")
    model.Name = petType .. (if golden then "Golden" else "")
    local b, pieces = builder(model, golden)
    local recipe = Recipes[petType] or Recipes.CrinkleFry
    recipe(b)
    b.sparkles()
    model.Parent = parent
    return model, pieces
end
-- Places every piece relative to a base CFrame (the pet's position and facing).
function PetModels.place(pieces, base)
    for _, piece in ipairs(pieces) do piece.part.CFrame = base * piece.offset end
end
return PetModels
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00058">
            <Properties>
              <string name="Name">PetPortrait</string>
              <ProtectedString name="Source">-- Live 3D pet portraits for the UI: a ViewportFrame showing the same code-built model the
-- pet uses in the world, framed from the front and slightly above.
local PetModels = require(script.Parent.PetModels)
local PetPortrait = {}
local Origin = CFrame.new(Vector3.new(0, 0, 0))
local function frame(viewport)
    local camera = viewport:FindFirstChild("PortraitCamera")
    if not camera then
        camera = Instance.new("Camera")
        camera.Name, camera.FieldOfView = "PortraitCamera", 30
        camera.Parent = viewport
        viewport.CurrentCamera = camera
    end
    -- Pets face -Z and are about 2 studs tall: look at them from the front, a little above.
    camera.CFrame = CFrame.lookAt(Vector3.new(0, 0.7, -6.4), Vector3.new(0, 0.15, 0))
end
-- Creates a portrait (or reuses `viewport`) showing `petType`; nil shows an empty frame.
function PetPortrait.set(viewport, petType, golden)
    local key = tostring(petType) .. (if golden then "*" else "")
    if viewport:GetAttribute("Showing") == key then return viewport end
    viewport:SetAttribute("Showing", key)
    local old = viewport:FindFirstChild("Pet")
    if old then old:Destroy() end
    if petType then
        local model, pieces = PetModels.build(petType, golden, viewport)
        model.Name = "Pet"
        PetModels.place(pieces, Origin)
    end
    return viewport
end
function PetPortrait.make(parent, name, size, position)
    local viewport = Instance.new("ViewportFrame")
    viewport.Name, viewport.BackgroundTransparency = name or "Portrait", 1
    viewport.Size, viewport.Position = size or UDim2.fromOffset(72, 72), position or UDim2.new()
    viewport.Ambient, viewport.LightColor = Color3.fromRGB(190, 180, 170), Color3.fromRGB(255, 250, 240)
    viewport.LightDirection = Vector3.new(-0.4, -1, 0.6)
    viewport.Parent = parent
    frame(viewport)
    return viewport
end
return PetPortrait
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00059">
            <Properties>
              <string name="Name">PetText</string>
              <ProtectedString name="Source">-- Shared pet display text and rarity colors.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local PetConfig = require(Shared.config.Pets)
local Format = require(Shared.util.Format)
local PetText = {}
-- Pets add flat amounts: fries per click, dollars per fry, and bag slots.
local function amount(bonus)
    if bonus.stat == "MoneyPerFry" then return "+" .. Format.money(bonus.amount) end
    return "+" .. Format.short(bonus.amount)
end
local Long = { FriesPerClick = " fries/click", MoneyPerFry = "/fry", BagCapacity = " bag" }
local Short = { FriesPerClick = " fries", MoneyPerFry = "/fry", BagCapacity = " bag" }
-- "+4 fries/click  ·  +$1/fry  ·  +10 bag"; `short` is one line per stat for pet tiles.
function PetText.bonus(bonuses, short)
    local names = if short then Short else Long
    local parts = {}
    for _, bonus in ipairs(bonuses) do table.insert(parts, amount(bonus) .. names[bonus.stat]) end
    return table.concat(parts, if short then "\n" else "  ·  ")
end
function PetText.color(rarity)
    local c = PetConfig.Rarities[rarity].Color
    return Color3.fromRGB(c[1], c[2], c[3])
end
return PetText
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00060">
            <Properties>
              <string name="Name">PetsView</string>
              <ProtectedString name="Source">-- Pet inventory: a grid of pet tiles (live 3D portrait, rarity band, name, bonus, equipped
-- tick, Golden sparkle). Tapping a tile selects it; the detail bar below shows it larger with
-- EQUIP or UNEQUIP and a two-tap DELETE. Tools above the grid: auto-delete and delete-all by
-- rarity, and merging copies into Golden pets. The server owns the inventory; this view only
-- displays and requests.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local PetConfig = require(Shared.config.Pets)
local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local Icons = require(script.Parent.Icons)
local PetText = require(script.Parent.PetText)
local PetPortrait = require(script.Parent.PetPortrait)
local PetsView = {}
PetsView.__index = PetsView
PetsView.Accent = Theme.Blue
local MinWidth, MaxWidth, MinHeight, MaxHeight = 340, 680, 400, 580
local GridTop, DetailHeight = 202, 86
local TileWidth, TileHeight = 92, 148
local ConfirmSeconds = 3
local function accentOf(pet) return if pet.golden then PetText.color("Legendary") else PetText.color(pet.rarity) end
local function chipRow(self, parent, name, label, y, onPress)
    local caption = E.label(parent, label, 28, Theme.Muted)
    caption.Name, caption.Position, caption.Size, caption.TextSize = name .. "Label", UDim2.fromOffset(20, y), UDim2.fromOffset(94, 28), 12
    caption.Font = Theme.Display
    E.fit(caption, 8, 12)
    local chips = {}
    for _, rarity in ipairs(PetConfig.BulkRarities) do
        local chip = E.button(parent, string.upper(rarity), function() onPress(rarity) end, Theme.Chip)
        chip.Name, chip.Size = name .. rarity, UDim2.fromOffset(84, 28)
        chip.TextSize, chip.AutoButtonColor = 12, false
        chip:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, 14)
        E.fit(chip, 7, 12)
        chips[rarity] = chip
    end
    return chips
end
function PetsView.new(gui, send)
    local self = setmetatable({ send = send, hasStation = false, tiles = {}, confirm = {}, selected = nil }, PetsView)
    self.button = E.menuButton(gui, "PetsButton", "PETS", "pets", PetsView.Accent, function() self:toggle() end)
    local frame = E.panel(gui, "PetsPanel", MaxWidth, MaxHeight, Theme.Blue)
    local panel = frame.panel
    self.panel, self.scale, self.close, self.caption = panel, frame.scale, frame.close, frame.caption
    frame.title.Text = "PETS"
    self.close.Activated:Connect(function() self:setOpen(false) end)

    self.autoChips = chipRow(self, panel, "Auto", "AUTO-DELETE", 80, function(rarity)
        if self.hasStation then self.send("ToggleAutoDelete", rarity) end
    end)
    self.clearChips = chipRow(self, panel, "Clear", "DELETE ALL", 114, function(rarity) self:arm("rarity:" .. rarity, "DeleteRarity", rarity) end)
    self.autoLabel, self.clearLabel = panel.AutoLabel, panel.ClearLabel
    local merge = E.box(panel, "Merge", UDim2.fromOffset(16, 150), UDim2.new(1, -32, 0, 44), Theme.Card, 14)
    E.stroke(merge, Theme.Gold, 3, 0)
    local sparkle = Icons.make(merge, "sparkle", 24, Theme.Gold, UDim2.fromOffset(10, 10))
    sparkle.Name = "Sparkle"
    self.mergeText = E.label(merge, "", 30, Theme.Accent)
    self.mergeText.Name, self.mergeText.Position, self.mergeText.Size, self.mergeText.TextSize = "MergeText", UDim2.fromOffset(42, 7), UDim2.new(1, -144, 0, 30), 12
    self.mergeButton = E.button(merge, "MERGE", function() self:merge() end, Theme.Gold)
    self.mergeButton.Name, self.mergeButton.AnchorPoint = "MergeButton", Vector2.new(1, 0.5)
    self.mergeButton.Position, self.mergeButton.Size, self.mergeButton.TextSize = UDim2.new(1, -10, 0.5, -1), UDim2.fromOffset(86, 32), 14

    self.mergeBanner = merge
    local area = E.box(panel, "GridArea", UDim2.fromOffset(12, GridTop), UDim2.new(1, -24, 1, -GridTop - DetailHeight - 28), Theme.Cream, 0)
    self.gridArea = area
    self.grid, self.gridLayout = E.grid(area, "Grid", TileWidth, TileHeight, 10)
    self.empty = E.label(area, "No pets yet. Spin the machine to get one!", 40, Theme.Muted)
    self.empty.Name, self.empty.TextXAlignment, self.empty.TextSize = "Empty", Enum.TextXAlignment.Center, 14

    -- Detail bar for the selected pet.
    local detail = E.card(panel, "Selected", UDim2.new(0, 16, 1, -DetailHeight - 16), UDim2.new(1, -32, 0, DetailHeight), 18)
    self.detail = detail
    self.detailPortrait = PetPortrait.make(detail, "Portrait", UDim2.fromOffset(70, 70), UDim2.fromOffset(8, 8))
    self.detailName = E.label(detail, "", 26, Theme.Ink)
    self.detailName.Name, self.detailName.Position, self.detailName.Size = "PetName", UDim2.fromOffset(88, 8), UDim2.new(1, -290, 0, 26)
    self.detailName.Font, self.detailName.TextSize = Theme.Display, 19
    E.fit(self.detailName, 10, 19)
    self.detailTags = E.label(detail, "", 16, Theme.Muted)
    self.detailTags.Name, self.detailTags.Position, self.detailTags.Size, self.detailTags.TextSize = "Rarity", UDim2.fromOffset(88, 36), UDim2.new(1, -290, 0, 16), 11
    E.fit(self.detailTags, 7, 11)
    self.detailBonus = E.label(detail, "", 18, Theme.Accent)
    self.detailBonus.Name, self.detailBonus.Position, self.detailBonus.Size, self.detailBonus.TextSize = "Bonus", UDim2.fromOffset(88, 56), UDim2.new(1, -290, 0, 18), 13
    E.fit(self.detailBonus, 7, 13)
    -- Three stats can wrap onto a second line on narrow panels.
    self.detailBonus.TextWrapped, self.detailBonus.Size = true, UDim2.new(1, -290, 0, 26)
    self.equip = E.button(detail, "EQUIP", function() self:equipSelected() end, Theme.Gold)
    self.equip.Name, self.equip.AnchorPoint = "Equip", Vector2.new(1, 0.5)
    self.equip.Position, self.equip.Size, self.equip.TextSize = UDim2.new(1, -96, 0.5, -1), UDim2.fromOffset(104, 44), 15
    self.deleteButton = E.button(detail, "DELETE", function() if self.selected then self:delete(self.selected) end end, Theme.Card)
    self.deleteButton.Name, self.deleteButton.AnchorPoint = "Delete", Vector2.new(1, 0.5)
    self.deleteButton.Position, self.deleteButton.Size, self.deleteButton.TextSize = UDim2.new(1, -12, 0.5, -1), UDim2.fromOffset(76, 44), 13
    self.hint = E.label(detail, "Tap a pet to see it here.", DetailHeight, Theme.Muted)
    self.hint.Name, self.hint.TextXAlignment, self.hint.TextSize = "Hint", Enum.TextXAlignment.Center, 14
    return self
end
function PetsView:setOpen(open) self.panel.Visible = open and self.hasStation end
function PetsView:toggle() if self.hasStation then self:setOpen(not self.panel.Visible) end end
function PetsView:armed(key) return self.confirm.key == key and os.clock() &lt; (self.confirm.untilTime or 0) end
-- Destructive requests need a second tap within a few seconds.
function PetsView:arm(key, action, argument)
    if not self.hasStation then return end
    if self:armed(key) then
        self.confirm = {}
        self.send(action, argument)
    else
        self.confirm = { key = key, untilTime = os.clock() + ConfirmSeconds }
    end
    if self.state then self:update(self.state) end
end
function PetsView:delete(id) self:arm("pet:" .. id, "DeletePet", id) end
function PetsView:select(id)
    self.selected = id
    if self.state then self:update(self.state) end
end
function PetsView:equipSelected()
    local pet = self.byId and self.selected and self.byId[self.selected]
    if not self.hasStation or not pet then return end
    if pet.equipped then self.send("Unequip", pet.id) elseif not self.slotsFull then self.send("Equip", pet.id) end
end
function PetsView:merge()
    local first = self.mergeable and self.mergeable[1]
    if self.hasStation and first then self.send("MergePets", first.type) end
end
local function sorted(owned)
    local list = table.clone(owned)
    table.sort(list, function(a, b)
        if a.equipped ~= b.equipped then return a.equipped end
        if a.rank ~= b.rank then return a.rank &gt; b.rank end
        if a.golden ~= b.golden then return a.golden end
        return tonumber(string.sub(a.id, 2)) &lt; tonumber(string.sub(b.id, 2))
    end)
    return list
end
function PetsView:tile(pet)
    local tile = E.button(self.grid, "", function() self:select(pet.id) end, Theme.Card, 0)
    tile.Name, tile.AutoButtonColor = pet.id, true
    tile:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, 16)
    local stroke = E.stroke(tile, accentOf(pet), 3, 0)
    stroke.Name = "Outline"
    local band = E.box(tile, "Band", UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 10), accentOf(pet), 8)
    band.ZIndex = 2
    PetPortrait.set(PetPortrait.make(tile, "Portrait", UDim2.fromOffset(70, 70), UDim2.new(0.5, -35, 0, 12)), pet.type, pet.golden)
    local name = E.label(tile, pet.name, 18, Theme.Ink)
    name.Name, name.Position, name.Size = "PetName", UDim2.new(0, 4, 0, 84), UDim2.new(1, -8, 0, 18)
    name.Font, name.TextSize, name.TextXAlignment = Theme.Display, 13, Enum.TextXAlignment.Center
    E.fit(name, 7, 13)
    -- One line per stat: fries, money, bag.
    local bonus = E.label(tile, PetText.bonus(pet.bonuses, true), 40, Theme.Accent)
    bonus.Name, bonus.Position, bonus.Size = "Bonus", UDim2.new(0, 4, 0, 103), UDim2.new(1, -8, 0, 40)
    bonus.TextSize, bonus.TextXAlignment, bonus.LineHeight = 11, Enum.TextXAlignment.Center, 1.05
    local badge = E.box(tile, "Equipped", UDim2.new(1, -20, 0, -6), UDim2.fromOffset(26, 26), Theme.Green, 13)
    E.stroke(badge, Theme.White, 2, 0)
    badge.ZIndex = 3
    local tick = Icons.make(badge, "check", 18, Theme.White, UDim2.fromOffset(4, 4))
    tick.ZIndex = 3
    if pet.golden then
        local glint = Icons.make(tile, "sparkle", 22, Theme.Gold, UDim2.fromOffset(-6, -6))
        glint.Name = "Golden"
    end
    return tile
end
function PetsView:update(state)
    self.state = state
    self.hasStation = state.hasStation
    E.setMenuEnabled(self.button, state.hasStation, PetsView.Accent)
    if not state.hasStation then self.panel.Visible = false end
    local pets = state.pets
    if not pets then return end
    self.slotsFull = pets.equipped &gt;= pets.slots
    self.caption.Text = "Equipped " .. pets.equipped .. " / " .. pets.slots .. "  ·  " .. #pets.owned .. " / " .. pets.max .. " pets"
    self.empty.Visible = #pets.owned == 0
    -- Tools: auto-delete chips are toggles; delete-all chips need a second tap.
    local autoDelete = pets.autoDelete or {}
    for rarity, chip in pairs(self.autoChips) do
        local on = autoDelete[rarity] == true
        chip.BackgroundColor3 = if on then Theme.Red else Theme.Chip
        chip.TextColor3 = if on then Theme.OnColor else PetText.color(rarity)
    end
    for rarity, chip in pairs(self.clearChips) do
        local armed = self:armed("rarity:" .. rarity)
        chip.Text = if armed then "SURE?" else string.upper(rarity)
        chip.BackgroundColor3 = if armed then Theme.Red else Theme.Chip
        chip.TextColor3 = if armed then Theme.OnColor else PetText.color(rarity)
    end
    self.mergeable = pets.mergeable or {}
    local first = self.mergeable[1]
    self.mergeButton.Visible, self.mergeButton.Active = first ~= nil, first ~= nil
    self.mergeText.Text = if first then "Merge " .. (pets.mergeCount or 5) .. " " .. first.name .. " into a Golden "
        .. first.name .. " (2x bonus)" .. (if #self.mergeable &gt; 1 then "  ·  +" .. (#self.mergeable - 1) .. " more" else "")
        else "Collect " .. (pets.mergeCount or 5) .. " unequipped copies of a pet to merge them into a Golden pet (2x bonus)."
    self.mergeText.TextColor3 = if first then Theme.Accent else Theme.Muted
    -- Tiles: reuse by ID so portraits are only built for new pets.
    self.byId = {}
    for order, pet in ipairs(sorted(pets.owned)) do
        self.byId[pet.id] = pet
        local tile = self.tiles[pet.id]
        if tile and tile:GetAttribute("Golden") ~= pet.golden then tile:Destroy(); tile = nil end
        if not tile then
            tile = self:tile(pet)
            tile:SetAttribute("Golden", pet.golden)
            self.tiles[pet.id] = tile
        end
        tile.LayoutOrder = order
        tile.Equipped.Visible = pet.equipped
        local selected = self.selected == pet.id
        tile.BackgroundColor3 = if selected then Theme.Cream else Theme.Card
        tile.Outline.Color = if selected then Theme.Ink else accentOf(pet)
        tile.Outline.Thickness = if selected then 4 else 3
    end
    for id, tile in pairs(self.tiles) do
        if not self.byId[id] then tile:Destroy(); self.tiles[id] = nil end
    end
    -- Detail bar.
    local pet = self.selected and self.byId[self.selected]
    if not pet then self.selected = nil end
    for _, child in ipairs({ self.detailPortrait, self.detailName, self.detailTags, self.detailBonus, self.equip }) do child.Visible = pet ~= nil end
    self.hint.Visible = pet == nil
    self.deleteButton.Visible = pet ~= nil and not pet.equipped
    if pet then
        PetPortrait.set(self.detailPortrait, pet.type, pet.golden)
        self.detailName.Text, self.detailName.TextColor3 = pet.name, accentOf(pet)
        self.detailTags.Text = string.upper(pet.rarity) .. (if pet.golden then "  ·  GOLDEN" else "") .. (if pet.equipped then "  ·  EQUIPPED" else "")
        self.detailBonus.Text = PetText.bonus(pet.bonuses)
        local canEquip = pet.equipped or not self.slotsFull
        self.equip.Text = if pet.equipped then "UNEQUIP" elseif canEquip then "EQUIP" else "SLOTS FULL"
        self.equip.Active, self.equip.Selectable, self.equip.AutoButtonColor = canEquip, canEquip, canEquip
        self.equip.BackgroundColor3 = if pet.equipped then Theme.Chip elseif canEquip then Theme.Gold else Theme.Disabled
        self.equip.TextColor3 = if canEquip then Theme.Ink else Theme.Muted
        local armed = self:armed("pet:" .. pet.id)
        self.deleteButton.Text = if armed then "SURE?" else "DELETE"
        self.deleteButton.BackgroundColor3 = if armed then Theme.Red else Theme.Card
        self.deleteButton.TextColor3 = if armed then Theme.OnColor else Theme.Red
    end
end
-- The panel grows with the screen (more tile columns) and only scales below its minimum.
function PetsView:resize(viewport)
    local availableWidth, availableHeight = viewport.X - 32, viewport.Y - 60 - 24
    local width = math.clamp(availableWidth, MinWidth, MaxWidth)
    -- Short, wide screens (phone landscape): both chip rows share one line so a full row of
    -- pet tiles still fits above the detail bar.
    local compact = width &gt;= 600 and availableHeight &lt; 480
    local height = math.clamp(availableHeight, if compact then 440 else MinHeight, MaxHeight)
    self.panel.Size = UDim2.fromOffset(width, height)
    self.scale.Scale = math.min(1, availableWidth / width, availableHeight / height)
    local groupWidth = if compact then math.floor((width - 32 - 16) / 2) else width - 32
    local chipWidth = math.clamp(math.floor((groupWidth - 88 - 16) / 3), 60, 100)
    for row, chips in ipairs({ self.autoChips, self.clearChips }) do
        local left = if compact and row == 2 then 16 + groupWidth + 16 else 16
        local y = if compact then 80 else (if row == 1 then 80 else 114)
        local label = if row == 1 then self.autoLabel else self.clearLabel
        label.Position, label.Size = UDim2.fromOffset(left + 4, y), UDim2.fromOffset(if compact then 82 else 94, 28)
        for index, rarity in ipairs(PetConfig.BulkRarities) do
            local chip = chips[rarity]
            chip.Size = UDim2.fromOffset(chipWidth, 28)
            chip.Position = UDim2.fromOffset(left + (if compact then 88 else 98) + (index - 1) * (chipWidth + 8), y)
        end
    end
    local gridTop = if compact then GridTop - 34 else GridTop
    self.mergeBanner.Position = UDim2.fromOffset(16, gridTop - 52)
    self.gridArea.Position = UDim2.fromOffset(12, gridTop)
    self.gridArea.Size = UDim2.new(1, -24, 1, -gridTop - DetailHeight - 28)
    E.fitGrid(self.gridLayout, width - 24, TileWidth)
    -- Detail bar: buttons side by side on wide panels, stacked on narrow ones so the name fits.
    local narrow = width &lt; 520
    local textWidth = if narrow then -(88 + 96 + 24) else -290
    for _, label in ipairs({ self.detailName, self.detailTags, self.detailBonus }) do
        label.Size = UDim2.new(1, textWidth, 0, label.Size.Y.Offset)
    end
    if narrow then
        self.equip.AnchorPoint, self.equip.Position, self.equip.Size = Vector2.new(1, 0), UDim2.new(1, -14, 0, 8), UDim2.fromOffset(96, 36)
        self.deleteButton.AnchorPoint, self.deleteButton.Position = Vector2.new(1, 1), UDim2.new(1, -14, 1, -12)
        self.deleteButton.Size = UDim2.fromOffset(96, 28)
    else
        self.equip.AnchorPoint, self.equip.Position, self.equip.Size = Vector2.new(1, 0.5), UDim2.new(1, -96, 0.5, -1), UDim2.fromOffset(104, 44)
        self.deleteButton.AnchorPoint, self.deleteButton.Position = Vector2.new(1, 0.5), UDim2.new(1, -12, 0.5, -1)
        self.deleteButton.Size = UDim2.fromOffset(76, 44)
    end
end
return PetsView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00061">
            <Properties>
              <string name="Name">RebirthView</string>
              <ProtectedString name="Source">-- Rebirth: a REBIRTH menu button and a confirmation panel. The server checks the threshold,
-- resets Cash and the bag, and awards gems; this view only displays and requests.
local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local Icons = require(script.Parent.Icons)
local RebirthView = {}
RebirthView.__index = RebirthView
RebirthView.Accent = Theme.Gem
local PanelWidth, PanelHeight = 360, 344
function RebirthView.new(gui, send)
    local self = setmetatable({ send = send, hasStation = false, ready = false, count = nil }, RebirthView)
    self.button = E.menuButton(gui, "RebirthButton", "REBIRTH", "rebirth", RebirthView.Accent, function() self:toggle() end)
    local frame = E.panel(gui, "RebirthPanel", PanelWidth, PanelHeight, Theme.Gem)
    self.panel, self.scale, self.close = frame.panel, frame.scale, frame.close
    frame.title.Text, frame.caption.Text = "REBIRTH", "Trade your Cash for gems"
    self.close.Activated:Connect(function() self:setOpen(false) end)

    local card = E.card(self.panel, "Details", UDim2.fromOffset(16, E.PanelTop + 10), UDim2.fromOffset(PanelWidth - 32, 180))
    local gem = Icons.make(card, "gem", 40, Theme.Gem, UDim2.fromOffset(14, 10))
    gem.Name = "GemIcon"
    self.reward = E.label(card, "+10 GEMS", 40, Theme.Gem)
    self.reward.Name, self.reward.Position, self.reward.Size = "Reward", UDim2.fromOffset(62, 10), UDim2.fromOffset(PanelWidth - 108, 40)
    self.reward.Font, self.reward.TextSize = Theme.Display, 30
    E.fit(self.reward, 14, 30)
    self.need = E.label(card, "", 18, Theme.Ink)
    self.need.Name, self.need.Position, self.need.Size, self.need.TextSize = "Need", UDim2.fromOffset(14, 58), UDim2.fromOffset(PanelWidth - 60, 18), 13
    E.fit(self.need, 8, 13)
    local track
    track, self.fill = E.bar(card, Theme.Gem, 10)
    track.Name, track.Position, track.Size = "Progress", UDim2.fromOffset(14, 82), UDim2.fromOffset(PanelWidth - 60, 10)
    E.dashes(card, "Divider", UDim2.fromOffset(14, 104), PanelWidth - 60)
    local resets = E.label(card, "Resets: your Cash and current bag", 16, Theme.Muted)
    resets.Name, resets.Position, resets.Size, resets.TextSize = "Resets", UDim2.fromOffset(14, 112), UDim2.fromOffset(PanelWidth - 60, 16), 12
    local keeps = E.label(card, "Keeps: gems, upgrades, pets, and rebirth count", 16, Theme.Muted)
    keeps.Name, keeps.Position, keeps.Size, keeps.TextSize = "Keeps", UDim2.fromOffset(14, 130), UDim2.fromOffset(PanelWidth - 60, 16), 12
    E.fit(keeps, 8, 12)
    self.countLabel = E.label(card, "REBIRTHS: 0", 16, Theme.Ink)
    self.countLabel.Name, self.countLabel.Position, self.countLabel.Size = "Count", UDim2.fromOffset(14, 154), UDim2.fromOffset(PanelWidth - 60, 16)
    self.countLabel.Font, self.countLabel.TextSize = Theme.Display, 12

    self.confirm = E.button(self.panel, "REBIRTH", function() self:rebirth() end, Theme.Green, 5)
    self.confirm.Name, self.confirm.Position, self.confirm.Size = "Confirm", UDim2.fromOffset(16, PanelHeight - 70), UDim2.fromOffset(PanelWidth - 37, 50)
    self.confirm.AutoButtonColor, self.confirm.TextColor3, self.confirm.TextSize = false, Theme.OnColor, 20
    self.confirmOutline = E.textStroke(self.confirm, Theme.Ink, 2)
    return self
end
function RebirthView:setOpen(open) self.panel.Visible = open and self.hasStation end
function RebirthView:toggle() if self.hasStation then self:setOpen(not self.panel.Visible) end end
function RebirthView:rebirth()
    if self.hasStation and self.ready and self.panel.Visible then self.send("Rebirth") end
end
function RebirthView:update(state)
    local info = state.rebirth
    self.hasStation = state.hasStation
    E.setMenuEnabled(self.button, state.hasStation, RebirthView.Accent)
    if not state.hasStation then self.panel.Visible = false end
    if not info then return end
    -- A completed rebirth closes the panel; the Cash and Gems card shows the result.
    if self.count and info.count &gt; self.count then self.panel.Visible = false end
    self.count = info.count
    self.ready = state.hasStation and state.profile.cash &gt;= info.threshold
    self.button.Badge.Visible = self.ready -- "!" when a rebirth is available
    self.reward.Text = "+" .. E.count(info.reward) .. " GEMS"
    self.need.Text = "Needs " .. E.money(info.threshold) .. " Cash  (you have " .. E.money(state.profile.cash) .. ")"
    self.fill.Size = UDim2.fromScale(math.clamp(state.profile.cash / info.threshold, 0, 1), 1)
    self.countLabel.Text = "REBIRTHS: " .. E.count(info.count)
    self.confirm.Active, self.confirm.Selectable = self.ready, self.ready
    self.confirm.Text = if self.ready then "REBIRTH NOW" else "NEED " .. E.money(info.threshold)
    self.confirm.BackgroundColor3 = if self.ready then Theme.Green else Theme.Disabled
    self.confirm.TextColor3 = if self.ready then Theme.OnColor else Theme.Muted
    self.confirmOutline.Enabled = self.ready
end
function RebirthView:resize(viewport)
    self.scale.Scale = math.min(1, (viewport.X - 32) / PanelWidth, (viewport.Y - 60 - 24) / PanelHeight)
end
return RebirthView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00062">
            <Properties>
              <string name="Name">RestaurantGuides</string>
              <ProtectedString name="Source">local Theme = require(script.Parent.Theme)
local RestaurantGuides = {}
RestaurantGuides.__index = RestaurantGuides
local FLOW_CYCLES_PER_SECOND = 0.8
-- Reuse fade values rather than allocating a new sequence for every chevron each frame.
local fades = {}
for i = 0, 20 do fades[i] = NumberSequence.new(1 - 0.9 * i / 20) end

local function beam(parent, name, start, finish)
    local line = Instance.new("Beam")
    line.Name, line.Attachment0, line.Attachment1 = name, start, finish
    line.Width0, line.Width1, line.Segments = 0.22, 0.22, 1
    line.FaceCamera, line.LightInfluence, line.LightEmission = true, 0, 0.5
    line.Color, line.Transparency = ColorSequence.new(Theme.Gold), NumberSequence.new(0.1)
    line.Enabled, line.Parent = false, parent
    return line
end

local function chevron(parent, index)
    local points = {}
    for _, name in ipairs({"Left", "Tip", "Right"}) do
        local point = Instance.new("Attachment")
        point.Name, point.Parent = "Chevron" .. index .. name, parent
        points[name] = point
    end
    points.leftArm = beam(parent, "Chevron" .. index .. "LeftArm", points.Left, points.Tip)
    points.rightArm = beam(parent, "Chevron" .. index .. "RightArm", points.Right, points.Tip)
    return points
end

function RestaurantGuides.new()
    local folder = Instance.new("Folder")
    folder.Name, folder.Parent = "RestaurantGuides", workspace
    return setmetatable({ folder = folder, entries = {}, phase = 0 }, RestaurantGuides)
end

function RestaurantGuides:setTarget(index, entrance)
    local entry = self.entries[index]
    if entry and entry.entrance ~= entrance then
        entry.finish:Destroy()
        entry.base:Destroy()
        self.entries[index], entry = nil, nil
    end
    if not entrance or entry then return end
    local finish = Instance.new("Attachment")
    finish.Name, finish.Position, finish.Parent = "RestaurantGuideEnd", Vector3.new(0, 1, 0), entrance
    local base = Instance.new("Part")
    base.Name, base.Size = "ChevronGuide" .. index, Vector3.new(0.1, 0.1, 0.1)
    base.Anchored, base.Transparency = true, 1
    base.CanCollide, base.CanTouch, base.CanQuery, base.CastShadow = false, false, false, false
    base.Parent = self.folder
    self.entries[index] = { entrance = entrance, finish = finish, base = base, chevrons = {} }
end

function RestaurantGuides:step(character, dt)
    self.phase = (self.phase + math.max(dt or 0, 0) * FLOW_CYCLES_PER_SECOND) % 1
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local head = character and character:FindFirstChild("Head")
    if not humanoid or humanoid.Health &lt;= 0 or not next(self.entries) then head = nil end
    if self.head ~= head then
        if self.origin then self.origin:Destroy() end
        self.head, self.origin = head, nil
        if head then
            local origin = Instance.new("Attachment")
            origin.Name, origin.Position = "RestaurantGuideStart", Vector3.new(0, head.Size.Y / 2 + 1.5, 0)
            origin.Parent, self.origin = head, origin
        end
    end
    for _, entry in pairs(self.entries) do
        local count = 0
        if self.origin and entry.entrance.Parent then
            local finish = entry.finish.WorldPosition
            local delta = finish - self.origin.WorldPosition
            local length = delta.Magnitude
            if length &gt; 1 then
                entry.base.Position = self.origin.WorldPosition
                local direction = delta.Unit
                local camera = workspace.CurrentCamera
                local look = if camera and camera.CFrame then camera.CFrame.LookVector else Vector3.new(0, -1, 0)
                local side = direction:Cross(look)
                if side.Magnitude &lt; 0.001 then side = direction:Cross(Vector3.new(0, 1, 0)) end
                side = if side.Magnitude &lt; 0.001 then Vector3.new(1, 0, 0) else side.Unit
                count = math.clamp(math.floor(length / 6), 1, 24)
                local depth = math.min(1.8, length / 3)
                -- Reuse a bounded set of open &gt; shapes, with clear gaps and no connecting shaft.
                for i = 1, count do
                    local mark = entry.chevrons[i]
                    if not mark then mark = chevron(entry.base, i); entry.chevrons[i] = mark end
                    local distance = ((i - 0.5 + self.phase) % count) * length / count
                    local center = direction * distance
                    -- Fade and shrink at the ends so the looping pattern never jumps visibly
                    -- or extends beyond the player's head and the restaurant endpoint.
                    local edge = math.min(distance, length - distance)
                    local halfDepth = math.min(depth / 2, edge)
                    local rear = center - direction * halfDepth
                    mark.Tip.Position = center + direction * halfDepth
                    mark.Left.Position = rear + side * halfDepth
                    mark.Right.Position = rear - side * halfDepth
                    local fade = fades[math.floor(math.min(edge / depth, 1) * 20 + 0.5)]
                    mark.leftArm.Transparency, mark.rightArm.Transparency = fade, fade
                end
            end
        end
        for i, mark in ipairs(entry.chevrons) do
            mark.leftArm.Enabled, mark.rightArm.Enabled = i &lt;= count, i &lt;= count
        end
    end
end

return RestaurantGuides
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00063">
            <Properties>
              <string name="Name">RestaurantMarkers</string>
              <ProtectedString name="Source">local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Runtime = require(Shared.config.Runtime)
local E = require(script.Parent.Elements)
local Theme = require(script.Parent.Theme)
local RestaurantGuides = require(script.Parent.RestaurantGuides)
local RestaurantMarkers = {}
RestaurantMarkers.__index = RestaurantMarkers

function RestaurantMarkers.new(playerGui, userId)
    return setmetatable({ playerGui = playerGui, userId = userId, entries = {}, guides = RestaurantGuides.new() }, RestaurantMarkers)
end

function RestaurantMarkers:create(index, station)
    local gui = Instance.new("BillboardGui")
    gui.Name, gui.Size = "RestaurantMarker" .. index, UDim2.fromOffset(220, 104)
    gui.ResetOnSpawn, gui.AlwaysOnTop, gui.LightInfluence = false, true, 0
    gui.MaxDistance, gui.Enabled = 240, false
    gui.Parent = self.playerGui

    local available = E.box(gui, "Available", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), Theme.Background, 0)
    available.BackgroundTransparency = 1
    local caption = E.box(available, "Caption", UDim2.fromOffset(40, 0), UDim2.fromOffset(140, 28), Theme.Gold, 14)
    E.stroke(caption, Theme.White, 3)
    local label = E.label(caption, "AVAILABLE", 28, Theme.Ink)
    label.Font, label.TextSize, label.TextXAlignment = Theme.Display, 15, Enum.TextXAlignment.Center

    local owner = E.box(gui, "Owner", UDim2.fromOffset(0, 14), UDim2.fromOffset(220, 76), Theme.Cream, 18)
    E.stroke(owner, Theme.White, 4)
    local portrait = E.box(owner, "Portrait", UDim2.fromOffset(8, 8), UDim2.fromOffset(60, 60), Theme.Card, 30)
    local fallback = E.label(portrait, "?", 60, Theme.Accent)
    fallback.Name, fallback.TextSize, fallback.TextXAlignment = "Fallback", 30, Enum.TextXAlignment.Center
    local avatar = Instance.new("ImageLabel")
    avatar.Name, avatar.Size, avatar.BackgroundTransparency = "Avatar", UDim2.fromScale(1, 1), 1
    avatar.Image, avatar.Visible, avatar.Parent = "", false, portrait
    E.corner(avatar, 30)
    local title = E.label(owner, "RESTAURANT " .. index, 18, Theme.Muted)
    title.Position, title.Size, title.TextSize = UDim2.fromOffset(78, 14), UDim2.fromOffset(132, 18), 10
    local username = E.label(owner, "", 28, Theme.Text)
    username.Name, username.Position, username.Size = "Username", UDim2.fromOffset(78, 33), UDim2.fromOffset(132, 28)
    username.Font, username.TextScaled, username.TextWrapped = Theme.Display, true, false
    local limit = Instance.new("UITextSizeConstraint")
    limit.MinTextSize, limit.MaxTextSize, limit.Parent = 9, 15, username
    return { station = station, gui = gui, available = available, owner = owner,
        username = username, avatar = avatar, fallback = fallback, ownerId = 0, generation = 0, attempts = 0 }
end

function RestaurantMarkers:loadPortrait(entry)
    if entry.ownerId &lt;= 0 or entry.pending or entry.avatar.Visible or entry.attempts &gt;= 3
        or os.clock() &lt; (entry.nextAttempt or 0) then return end
    entry.pending, entry.attempts = true, entry.attempts + 1
    local ownerId, generation = entry.ownerId, entry.generation
    -- Thumbnail requests yield and can fail; they must never delay claiming or the HUD.
    task.spawn(function()
        local ok, content, ready = pcall(function()
            return Players:GetUserThumbnailAsync(ownerId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
        end)
        if not entry.gui.Parent or entry.generation ~= generation then return end
        entry.pending, entry.nextAttempt = false, os.clock() + 5
        if ok and ready and type(content) == "string" and content ~= "" then
            entry.avatar.Image, entry.avatar.Visible = content, true
            entry.fallback.Visible = false
        end
    end)
end

function RestaurantMarkers:update(hasStation)
    local world = workspace:FindFirstChild("FriesRestaurant")
    local ownsRestaurant = hasStation
    -- Replicated ownership also hides guidance while the private claim snapshot is in flight.
    for index = 1, Runtime.StationCount do
        local station = world and world:FindFirstChild("Station" .. index)
        if station and station:GetAttribute("OwnerUserId") == self.userId then ownsRestaurant = true end
    end
    for index = 1, Runtime.StationCount do
        local station = world and world:FindFirstChild("Station" .. index)
        local entry = self.entries[index]
        if entry and entry.station ~= station then
            entry.gui:Destroy()
            self.entries[index], entry = nil, nil
        end
        local entrance = station and station:FindFirstChild("ClaimPoint")
        local roof = station and station:FindFirstChild("RoofCap")
        local target = nil
        if entrance and roof then
            if not entry then entry = self:create(index, station); self.entries[index] = entry end
            local ownerId = station:GetAttribute("OwnerUserId") or 0
            if entry.ownerId ~= ownerId then
                entry.ownerId, entry.generation = ownerId, entry.generation + 1
                entry.pending, entry.attempts, entry.nextAttempt = false, 0, 0
                entry.avatar.Image, entry.avatar.Visible, entry.fallback.Visible = "", false, true
            end
            local claimed = ownerId ~= 0
            entry.owner.Visible, entry.available.Visible = claimed, not claimed and not ownsRestaurant
            if not claimed and not ownsRestaurant then target = entrance end
            entry.gui.Enabled = claimed or not ownsRestaurant
            entry.gui.Adornee = if claimed then roof else entrance
            entry.gui.StudsOffsetWorldSpace = Vector3.new(0, if claimed then 4 else 3, 0)
            if claimed then
                local username = station:GetAttribute("OwnerUsername") or "Player"
                entry.username.Text = "@" .. username
                entry.fallback.Text = string.upper(string.sub(username, 1, 1))
                self:loadPortrait(entry)
            end
        elseif entry then
            entry.gui.Enabled = false
        end
        self.guides:setTarget(index, target)
    end
end

return RestaurantMarkers
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00064">
            <Properties>
              <string name="Name">RestaurantView</string>
              <ProtectedString name="Source">-- EXPAND: opens at the kiosk in the player's restaurant and shows the next restaurant tier, the
-- machine it adds (with its top pet as a live portrait), and the Cash price. The server checks
-- the kiosk distance and the price and raises the tier; this view only displays and requests.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local PetConfig = require(Shared.config.Pets)
local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local PetPortrait = require(script.Parent.PetPortrait)
local RestaurantView = {}
RestaurantView.__index = RestaurantView
local PanelWidth, PanelHeight = 380, 372
function RestaurantView.new(gui, send)
    local self = setmetatable({ send = send, hasStation = false, ready = false }, RestaurantView)
    local frame = E.panel(gui, "RestaurantPanel", PanelWidth, PanelHeight, Theme.Gold)
    self.panel, self.scale, self.close, self.title, self.caption = frame.panel, frame.scale, frame.close, frame.title, frame.caption
    self.title.Text = "EXPAND"
    self.close.Activated:Connect(function() self:setOpen(false) end)

    local card = E.card(self.panel, "Next", UDim2.fromOffset(16, E.PanelTop + 10), UDim2.fromOffset(PanelWidth - 32, 206))
    self.card = card
    self.tierName = E.label(card, "", 34, Theme.Ink)
    self.tierName.Name, self.tierName.Position, self.tierName.Size = "TierName", UDim2.fromOffset(14, 10), UDim2.new(1, -28, 0, 34)
    self.tierName.Font, self.tierName.TextSize = Theme.Display, 28
    E.fit(self.tierName, 14, 28)
    self.tagline = E.label(card, "", 18, Theme.Muted)
    self.tagline.Name, self.tagline.Position, self.tagline.Size, self.tagline.TextSize = "Tagline", UDim2.fromOffset(14, 44), UDim2.new(1, -28, 0, 18), 13
    E.fit(self.tagline, 8, 13)
    E.dashes(card, "Divider", UDim2.fromOffset(14, 70), PanelWidth - 60)
    self.portrait = PetPortrait.make(card, "Portrait", UDim2.fromOffset(100, 100), UDim2.fromOffset(10, 82))
    self.adds = E.label(card, "", 22, Theme.Ink)
    self.adds.Name, self.adds.Position, self.adds.Size = "Adds", UDim2.fromOffset(118, 86), UDim2.new(1, -132, 0, 22)
    self.adds.Font, self.adds.TextSize = Theme.Display, 16
    E.fit(self.adds, 9, 16)
    self.spinPrice = E.label(card, "", 18, Theme.Accent)
    self.spinPrice.Name, self.spinPrice.Position, self.spinPrice.Size, self.spinPrice.TextSize = "SpinPrice", UDim2.fromOffset(118, 110), UDim2.new(1, -132, 0, 18), 13
    E.fit(self.spinPrice, 8, 13)
    self.topPet = E.label(card, "", 18, Theme.Muted)
    self.topPet.Name, self.topPet.Position, self.topPet.Size, self.topPet.TextSize = "TopPet", UDim2.fromOffset(118, 130), UDim2.new(1, -132, 0, 18), 12
    E.fit(self.topPet, 7, 12)
    local keeps = E.label(card, "Keeps every machine. Survives rebirth.", 18, Theme.Muted)
    keeps.Name, keeps.Position, keeps.Size, keeps.TextSize = "Keeps", UDim2.fromOffset(118, 158), UDim2.new(1, -132, 0, 32), 12
    keeps.TextWrapped = true

    self.confirm = E.button(self.panel, "EXPAND", function() self:expand() end, Theme.Green, 5)
    self.confirm.Name, self.confirm.Position, self.confirm.Size = "Confirm", UDim2.fromOffset(16, PanelHeight - 70), UDim2.fromOffset(PanelWidth - 37, 50)
    self.confirm.AutoButtonColor, self.confirm.TextColor3, self.confirm.TextSize = false, Theme.OnColor, 20
    self.confirmOutline = E.textStroke(self.confirm, Theme.Ink, 2)
    return self
end
function RestaurantView:setOpen(open) self.panel.Visible = open and self.hasStation end
function RestaurantView:toggle() if self.hasStation then self:setOpen(not self.panel.Visible) end end
function RestaurantView:expand()
    if self.hasStation and self.ready and self.panel.Visible then self.send("Expand") end
end
function RestaurantView:update(state)
    self.hasStation = state.hasStation
    if not state.hasStation then self.panel.Visible = false end
    -- Open at the kiosk, close on walking away.
    local near = state.hasStation and state.nearExpand == true
    if near ~= self.near then
        self.near = near
        self.panel.Visible = near
        if near then self.focusRequested = true end
    end
    local info = state.restaurant
    if not info then return end
    self.caption.Text = "Tier " .. info.tier .. " of " .. info.max .. "  ·  your " .. info.name
    local nextTier = info.nextTier
    if nextTier then
        self.tierName.Text = string.upper(nextTier.name)
        self.tagline.Text = nextTier.tagline
        self.adds.Text = "Adds the " .. string.upper(nextTier.machineName)
        self.spinPrice.Text = E.money(nextTier.spinPrice) .. " a spin  ·  8 new pets"
        PetPortrait.set(self.portrait, nextTier.legendary, false)
        local top = PetConfig.Types[nextTier.legendary]
        self.topPet.Text = "Top pet: " .. (if top then top.Name .. " (Legendary)" else "a new Legendary")
        self.portrait.Visible = true
    else
        self.tierName.Text = "FULLY UPGRADED"
        self.tagline.Text = "Your " .. info.name .. " is the finest on the plaza."
        self.adds.Text, self.spinPrice.Text, self.topPet.Text = "Every machine is unlocked", "", ""
        self.portrait.Visible = false
    end
    self.ready = state.hasStation and nextTier ~= nil and nextTier.affordable == true
    self.confirm.Active, self.confirm.Selectable = self.ready, self.ready
    self.confirm.Text = if not nextTier then "ALL UNLOCKED" elseif self.ready then "EXPAND  " .. E.money(nextTier.price)
        else "NEED " .. E.money(nextTier.price)
    self.confirm.BackgroundColor3 = if self.ready then Theme.Green else Theme.Disabled
    self.confirm.TextColor3 = if self.ready then Theme.OnColor else Theme.Muted
    self.confirmOutline.Enabled = self.ready
end
function RestaurantView:resize(viewport)
    self.scale.Scale = math.min(1, (viewport.X - 32) / PanelWidth, (viewport.Y - 60 - 24) / PanelHeight)
end
return RestaurantView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00065">
            <Properties>
              <string name="Name">SettingsView</string>
              <ProtectedString name="Source">-- Settings: a gear button beside Return to Counter and a panel of saved ON/OFF toggles.
-- The server saves each setting; this view only displays and requests changes.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Config = require(Shared.config.Settings)
local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local Icons = require(script.Parent.Icons)
local SettingsView = {}
SettingsView.__index = SettingsView
local PanelWidth, RowHeight = 350, 72
local PanelHeight = E.PanelTop + 16 + #Config.Order * (RowHeight + 10)
function SettingsView.new(gui, send)
    local self = setmetatable({ send = send, rows = {}, hasStation = true }, SettingsView)
    self.button = E.button(gui, "", function() self:toggle() end, Theme.Cream, 0)
    self.button.Name, self.button.Size = "SettingsButton", UDim2.fromOffset(48, 48)
    self.button:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, 24)
    E.sticker(self.button, 4, 5)
    local gear = Icons.make(self.button, "settings", 30, Theme.Ink)
    gear.AnchorPoint, gear.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)

    local frame = E.panel(gui, "SettingsPanel", PanelWidth, PanelHeight, Theme.Ink)
    self.panel, self.scale, self.close = frame.panel, frame.scale, frame.close
    frame.title.Text, frame.caption.Text = "SETTINGS", "Saved to your profile"
    self.close.BackgroundColor3 = Theme.Red
    self.close.Activated:Connect(function() self:setOpen(false) end)
    for index, key in ipairs(Config.Order) do
        local row = E.card(self.panel, key, UDim2.fromOffset(16, E.PanelTop + 12 + (index - 1) * (RowHeight + 10)), UDim2.fromOffset(PanelWidth - 32, RowHeight))
        local name = E.label(row, Config.Names[key], 24, Theme.Ink)
        name.Name, name.Position, name.Size = "SettingName", UDim2.fromOffset(14, 8), UDim2.fromOffset(PanelWidth - 140, 24)
        name.Font, name.TextSize = Theme.Display, 16
        E.fit(name, 9, 16)
        local hint = E.label(row, Config.Hints[key], 32, Theme.Muted)
        hint.Name, hint.Position, hint.Size, hint.TextSize = "Hint", UDim2.fromOffset(14, 34), UDim2.fromOffset(PanelWidth - 140, 32), 11
        local switch = E.button(row, "", function() self.send("ToggleSetting", key) end, Theme.Green)
        switch.Name, switch.AnchorPoint, switch.Position, switch.Size = "Toggle", Vector2.new(1, 0.5), UDim2.new(1, -14, 0.5, -1), UDim2.fromOffset(72, 36)
        switch.TextSize, switch.AutoButtonColor = 16, false
        switch:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, 18)
        self.rows[key] = switch
    end
    return self
end
function SettingsView:setOpen(open) self.panel.Visible = open end
function SettingsView:toggle() self:setOpen(not self.panel.Visible) end
function SettingsView:update(state)
    local values = state.settings or {}
    for key, switch in pairs(self.rows) do
        local on = values[key] ~= false
        switch.Text = if on then "ON" else "OFF"
        switch.BackgroundColor3 = if on then Theme.Green else Theme.Chip
        switch.TextColor3 = if on then Theme.OnColor else Theme.Muted
    end
end
function SettingsView:resize(viewport)
    self.scale.Scale = math.min(1, (viewport.X - 32) / PanelWidth, (viewport.Y - 60 - 24) / PanelHeight)
end
return SettingsView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00066">
            <Properties>
              <string name="Name">ShopView</string>
              <ProtectedString name="Source">-- Upgrade shop: an UPGRADES menu button and a panel with one row per gem upgrade track.
-- Rows display server-computed levels, values, and costs; the server decides purchases.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Upgrades = require(Shared.config.Upgrades)
local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local Icons = require(script.Parent.Icons)
local ShopView = {}
ShopView.__index = ShopView
ShopView.Accent = Theme.Orange
local PanelWidth, PanelHeight = 380, 350
local TrackIcons = { FriesPerClick = "upgrade-fries-per-click", MoneyPerFry = "upgrade-money-per-fry", BagCapacity = "upgrade-bag-capacity" }
local function describe(row)
    if row.id == "MoneyPerFry" then
        -- Cents matter below $1,000 ($1.00 » $1.10); larger amounts use the short format.
        local function dollars(v) return if v &lt; 1000 then string.format("$%.2f", v) else E.money(v) end
        return dollars(row.value) .. " » " .. dollars(row.nextValue) .. " per fry"
    elseif row.id == "FriesPerClick" then
        return E.number(row.value) .. " » " .. E.number(row.nextValue) .. " fries/click"
    end
    return E.number(row.value) .. " » " .. E.number(row.nextValue) .. " fries per bag"
end
function ShopView.new(gui, send)
    local self = setmetatable({ send = send, rows = {}, data = {}, hasStation = false }, ShopView)
    self.button = E.menuButton(gui, "UpgradesButton", "UPGRADES", "upgrades", ShopView.Accent, function() self:toggle() end)
    local frame = E.panel(gui, "UpgradeShop", PanelWidth, PanelHeight)
    self.panel, self.scale, self.close = frame.panel, frame.scale, frame.close
    frame.title.Text, frame.caption.Text = "UPGRADES", "Spend gems to boost your restaurant"
    self.close.Activated:Connect(function() self:setOpen(false) end)
    for index, id in ipairs(Upgrades.Order) do
        local row = E.card(self.panel, id, UDim2.fromOffset(16, E.PanelTop + 12 + (index - 1) * 88), UDim2.fromOffset(PanelWidth - 32, 78))
        local disc = E.box(row, "IconDisc", UDim2.fromOffset(12, 16), UDim2.fromOffset(46, 46), Theme.Cream, 23)
        Icons.make(disc, TrackIcons[id], 34, Theme.Ink, UDim2.fromOffset(6, 6))
        local name = E.label(row, Upgrades.Tracks[id].Name, 24, Theme.Ink)
        name.Name, name.Position, name.Size = "TrackName", UDim2.fromOffset(68, 8), UDim2.fromOffset(170, 24)
        name.Font, name.TextSize = Theme.Display, 17
        E.fit(name, 10, 17)
        local level = E.label(row, "LEVEL 0", 16, Theme.Muted)
        level.Name, level.Position, level.Size, level.TextSize = "Level", UDim2.fromOffset(68, 33), UDim2.fromOffset(170, 16), 12
        local value = E.label(row, "", 18, Theme.Accent)
        value.Name, value.Position, value.Size, value.TextSize = "Value", UDim2.fromOffset(68, 51), UDim2.fromOffset(176, 18), 13
        E.fit(value, 8, 13)
        local buy = E.button(row, "", function() self:buy(id) end, Theme.Gold)
        buy.Name, buy.Position, buy.Size = "Buy", UDim2.fromOffset(PanelWidth - 32 - 104, 17), UDim2.fromOffset(90, 42)
        buy.AutoButtonColor, buy.TextColor3 = false, Theme.Ink
        E.fit(buy, 9, 15)
        self.rows[id] = { level = level, value = value, buy = buy }
    end
    return self
end
function ShopView:setOpen(open)
    self.panel.Visible = open and self.hasStation
end
function ShopView:toggle()
    if self.hasStation then self:setOpen(not self.panel.Visible) end
end
function ShopView:buy(id)
    local data = self.data[id]
    if self.hasStation and data and data.affordable then self.send("Upgrade", id) end
end
function ShopView:update(state)
    self.hasStation = state.hasStation
    E.setMenuEnabled(self.button, state.hasStation, ShopView.Accent)
    if not state.hasStation then self.panel.Visible = false end
    for _, row in ipairs(state.shop or {}) do
        local view = self.rows[row.id]
        if view then
            local affordable = state.hasStation and (state.profile.gems or 0) &gt;= row.cost
            self.data[row.id] = { affordable = affordable }
            -- Each level adds the track's percent to that stat (levels add up).
            local percent = math.floor(row.level * Upgrades.Tracks[row.id].Percent * 100 + 0.5)
            view.level.Text = "LEVEL " .. row.level .. (if percent &gt; 0 then "  ·  +" .. E.count(percent) .. "%" else "")
            view.value.Text = describe(row)
            view.buy.Text = E.count(row.cost) .. (if row.cost == 1 then " GEM" else " GEMS")
            view.buy.TextSize = if #view.buy.Text &gt; 10 then 11 else 14
            view.buy.Active, view.buy.Selectable = affordable, affordable
            view.buy.BackgroundColor3 = if affordable then Theme.Gold else Theme.Disabled
            view.buy.TextColor3 = if affordable then Theme.Ink else Theme.Muted
        end
    end
end
-- AppView places the button; the panel scales to fit the screen.
function ShopView:resize(viewport)
    self.scale.Scale = math.min(1, (viewport.X - 32) / PanelWidth, (viewport.Y - 60 - 24) / PanelHeight)
end
return ShopView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00067">
            <Properties>
              <string name="Name">Theme</string>
              <ProtectedString name="Source">-- Diner Sticker palette and type (agreed 17 October 2026). See docs/STYLE_GUIDE.md.
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
return {
    -- Surfaces
    Cream = rgb(255, 244, 220), -- panel and card bodies
    Card = rgb(255, 255, 255), -- rows and tiles on cream
    Tan = rgb(229, 201, 163), -- dashed dividers, quiet borders
    Chip = rgb(247, 227, 191), -- inactive chips and empty tracks
    White = rgb(255, 255, 255), -- sticker borders
    -- Ink: text, outlines, and offset shadows
    Ink = rgb(61, 31, 31),
    Text = rgb(61, 31, 31),
    Muted = rgb(138, 90, 60),
    Accent = rgb(181, 101, 29), -- readable orange-brown for values on white or cream
    OnColor = rgb(255, 255, 255), -- text on ketchup, grape, blueberry, or teal
    -- Brand colours
    Red = rgb(230, 57, 70), -- ketchup: headers, Return to Counter, danger
    Gold = rgb(255, 183, 3), -- mustard: pack, buy, merge, highlights
    GoldLight = rgb(255, 209, 102),
    Green = rgb(42, 157, 143), -- teal: sell, equipped, ON
    GreenLight = rgb(82, 199, 184),
    Orange = rgb(247, 127, 0), -- upgrades
    Gem = rgb(123, 44, 191), -- grape: gems and rebirth
    GemLight = rgb(196, 161, 255),
    Blue = rgb(29, 111, 216), -- blueberry: pets
    Disabled = rgb(214, 196, 170),
    -- Back-compat names used by older modules
    Background = rgb(255, 244, 220),
    Shadow = rgb(61, 31, 31),
    -- Type: both fonts ship with Roblox
    Display = Enum.Font.LuckiestGuy, -- titles, numbers, button labels
    Body = Enum.Font.FredokaOne, -- body text
    -- Shape
    Border = 4, -- white sticker border
    ShadowOffset = 5, -- ink shadow, down and right
    Radius = 18,
}
</ProtectedString>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
