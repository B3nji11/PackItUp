<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <Item class="Workspace" referent="RBX00000">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="ReplicatedStorage" referent="RBX00001">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="RBX00002">
      <Properties>
        <string name="Name">FriesShared</string>
      </Properties>
      <Item class="Folder" referent="RBX00003">
        <Properties>
          <string name="Name">config</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00004">
          <Properties>
            <string name="Name">Actions</string>
            <ProtectedString name="Source">-- Only these actions are accepted. "none" takes no client argument; the others take exactly
-- one name or ID, which the server validates: an upgrade track, a machine, a pet ID, a pet
-- type, a bulk rarity (Common, Uncommon, Rare), or a setting name.
return table.freeze({ Pack = "none", Sell = "none", Return = "none", Sync = "none", Rebirth = "none",
    Expand = "none", VisitMachine = "none",
    Upgrade = "upgrade", Spin = "machine", Equip = "pet", Unequip = "pet", DeletePet = "pet",
    MergePets = "petType", DeleteRarity = "bulkRarity", ToggleAutoDelete = "bulkRarity", ToggleSetting = "setting" })
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00005">
          <Properties>
            <string name="Name">Economy</string>
            <ProtectedString name="Source">-- Base balance for the core filling-and-selling loop, before upgrades.
return table.freeze({
    BaseCapacity = 40,
    -- Money per fry, in cents. A bag sells for capacity x this value ($1.00 x 40 = $40).
    MoneyPerFryCents = 100,
    BaseClick = 2,
    BasicFryerPerSecond = 0.5,
    ClicksPerSecond = 4,
    -- No practical cap (owner, 20 October 2026). This safety limit only stops a number ever
    -- becoming infinity, which would corrupt a save; no player can reach it.
    MaxCurrency = 1e300,
})
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00006">
          <Properties>
            <string name="Name">Icons</string>
            <ProtectedString name="Source">-- Uploaded icon asset IDs, keyed by the file names in art/README.md (without ".png").
-- Leave an entry empty ("") until its image is uploaded and approved; the game then draws a
-- code-built fallback. Paste IDs as "rbxassetid://1234567890".
return table.freeze({
    ["cash"] = "",
    ["gem"] = "",
    ["fries"] = "",
    ["bag"] = "",
    ["upgrades"] = "",
    ["rebirth"] = "",
    ["spin"] = "",
    ["pets"] = "",
    ["settings"] = "",
    ["home"] = "",
    ["upgrade-fries-per-click"] = "",
    ["upgrade-money-per-fry"] = "",
    ["upgrade-bag-capacity"] = "",
    ["close"] = "",
    ["check"] = "",
    ["sparkle"] = "",
    ["star"] = "",
})
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00007">
          <Properties>
            <string name="Name">Machines</string>
            <ProtectedString name="Source">-- Gacha machines are data: a fixed Cash price, rarity odds, a pet pool, and pity. Each
-- machine belongs to a restaurant tier (config/Restaurants) and needs that tier to spin.
-- Pets in the same rarity share that rarity's chance equally. Prices from tools/simulate.py.
local Odds = table.freeze({ Common = 0.60, Uncommon = 0.25, Rare = 0.10, Epic = 0.04, Legendary = 0.01 })
local function machine(name, tier, price, accent, pool)
    return table.freeze({ Name = name, Tier = tier, Price = price, Odds = Odds, Pool = table.freeze(pool),
        -- The PityEvery-th spin in a row without PityRarity or better is guaranteed PityRarity or better.
        PityEvery = 50, PityRarity = "Epic",
        -- Theme colour name (client Theme) for the panel header and stand.
        Accent = accent })
end
local Machines = {
    StarterFryer = machine("Starter Fryer", 1, 150, "Green", { "CrinkleFry", "SaltShaker", "PaperCup", "PotatoPup", "KetchupPacket", "MayoJar", "FryerBot", "FryKing" }),
    DeluxeFryer = machine("Deluxe Fryer", 2, 150000, "Red", { "OnionRing", "PickleChip", "NapkinGhost", "HashBrownHamster", "Milkshake", "CurlyFryCat", "CheeseSlime", "FryPhoenix" }),
    DriveInGrill = machine("Drive-In Grill", 3, 1500000, "Orange", { "SesameBun", "MustardBottle", "PaperTray", "BurgerBear", "SodaSeal", "HotDogPup", "CarhopBot", "BurgerDragon" }),
    PierFryer = machine("Pier Fryer", 4, 25000000, "Blue", { "FishStick", "TartarTub", "NewspaperCone", "ChipCrab", "VinegarOwl", "SeagullThief", "BatterOctopus", "FryKraken" }),
    CosmicFryer = machine("Cosmic Fryer", 5, 200000000, "Gem", { "MoonFry", "StarSalt", "AstroCup", "AlienTot", "CometCola", "SaucerBurger", "RoboChef", "GalaxyFry" }),
    RoyalFryer = machine("Royal Fryer", 6, 4000000000, "Gold", { "TruffleFry", "PepperKnight", "VelvetBox", "ButlerSpud", "CrownKetchup", "DiamondDip", "FryUnicorn", "FryEmperor" }),
}
return table.freeze({ Order = table.freeze({ "StarterFryer", "DeluxeFryer", "DriveInGrill", "PierFryer", "CosmicFryer", "RoyalFryer" }), Machines = table.freeze(Machines) })
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00008">
          <Properties>
            <string name="Name">Pets</string>
            <ProtectedString name="Source">-- Fry Buddies (placeholder names). Every pet adds all three stats as flat amounts, with a lean
-- (click, money, or bag): effective stat = (base + equipped pets) x (1 + upgrade percent).
-- MoneyPerFry is in dollars. Golden pets give GoldenMultiplier x these stats.
local Rarities = {
    -- Colours are dark enough to read on cream and white (Diner Sticker style).
    Common = table.freeze({ Rank = 1, Name = "Common", Color = { 128, 108, 88 } }),
    Uncommon = table.freeze({ Rank = 2, Name = "Uncommon", Color = { 31, 138, 126 } }),
    Rare = table.freeze({ Rank = 3, Name = "Rare", Color = { 29, 111, 216 } }),
    Epic = table.freeze({ Rank = 4, Name = "Epic", Color = { 123, 44, 191 } }),
    Legendary = table.freeze({ Rank = 5, Name = "Legendary", Color = { 176, 118, 0 } }),
}
local function pet(name, rarity, click, money, bag)
    return table.freeze({ Name = name, Rarity = rarity,
        Stats = table.freeze({ FriesPerClick = click, MoneyPerFry = money, BagCapacity = bag }) })
end
-- Numbers from tools/simulate.py. Every machine's pets are 4x the machine before, slot for slot.
local Types = {
    -- Fry Stand (StarterFryer): stats x1 the Starter pet in the same slot
    CrinkleFry = pet("Crinkle Fry", "Common", 4, 1, 10),
    SaltShaker = pet("Salt Shaker", "Common", 2, 2, 10),
    PaperCup = pet("Paper Cup", "Common", 2, 1, 20),
    PotatoPup = pet("Potato Pup", "Uncommon", 6, 1.50, 15),
    KetchupPacket = pet("Ketchup Packet", "Uncommon", 3, 3, 15),
    MayoJar = pet("Mayo Jar", "Rare", 4, 4, 20),
    FryerBot = pet("Fryer Bot", "Epic", 6, 3, 60),
    FryKing = pet("Fry King", "Legendary", 12, 6, 60),
    -- Fry Diner (DeluxeFryer): stats x4 the Starter pet in the same slot
    OnionRing = pet("Onion Ring", "Common", 16, 4, 40),
    PickleChip = pet("Pickle Chip", "Common", 8, 8, 40),
    NapkinGhost = pet("Napkin Ghost", "Common", 8, 4, 80),
    HashBrownHamster = pet("Hash Brown Hamster", "Uncommon", 24, 6, 60),
    Milkshake = pet("Milkshake", "Uncommon", 12, 12, 60),
    CurlyFryCat = pet("Curly Fry Cat", "Rare", 16, 16, 80),
    CheeseSlime = pet("Cheese Sauce Slime", "Epic", 24, 12, 240),
    FryPhoenix = pet("Fry Phoenix", "Legendary", 48, 24, 240),
    -- Drive-In (DriveInGrill): stats x16 the Starter pet in the same slot
    SesameBun = pet("Sesame Bun", "Common", 64, 16, 160),
    MustardBottle = pet("Mustard Bottle", "Common", 32, 32, 160),
    PaperTray = pet("Paper Tray", "Common", 32, 16, 320),
    BurgerBear = pet("Burger Bear", "Uncommon", 96, 24, 240),
    SodaSeal = pet("Soda Seal", "Uncommon", 48, 48, 240),
    HotDogPup = pet("Hot Dog Pup", "Rare", 64, 64, 320),
    CarhopBot = pet("Carhop Bot", "Epic", 96, 48, 960),
    BurgerDragon = pet("Burger Dragon", "Legendary", 192, 96, 960),
    -- Fish &amp; Chips Pier (PierFryer): stats x64 the Starter pet in the same slot
    FishStick = pet("Fish Stick", "Common", 256, 64, 640),
    TartarTub = pet("Tartar Tub", "Common", 128, 128, 640),
    NewspaperCone = pet("Newspaper Cone", "Common", 128, 64, 1280),
    ChipCrab = pet("Chip Crab", "Uncommon", 384, 96, 960),
    VinegarOwl = pet("Vinegar Owl", "Uncommon", 192, 192, 960),
    SeagullThief = pet("Seagull Thief", "Rare", 256, 256, 1280),
    BatterOctopus = pet("Battered Octopus", "Epic", 384, 192, 3840),
    FryKraken = pet("Fry Kraken", "Legendary", 768, 384, 3840),
    -- Cosmic Diner (CosmicFryer): stats x256 the Starter pet in the same slot
    MoonFry = pet("Moon Fry", "Common", 1024, 256, 2560),
    StarSalt = pet("Star Salt", "Common", 512, 512, 2560),
    AstroCup = pet("Astro Cup", "Common", 512, 256, 5120),
    AlienTot = pet("Alien Tot", "Uncommon", 1536, 384, 3840),
    CometCola = pet("Comet Cola", "Uncommon", 768, 768, 3840),
    SaucerBurger = pet("Saucer Burger", "Rare", 1024, 1024, 5120),
    RoboChef = pet("Robo Chef", "Epic", 1536, 768, 15360),
    GalaxyFry = pet("Galaxy Fry Lord", "Legendary", 3072, 1536, 15360),
    -- Fry Palace (RoyalFryer): stats x1024 the Starter pet in the same slot
    TruffleFry = pet("Truffle Fry", "Common", 4096, 1024, 10240),
    PepperKnight = pet("Pepper Knight", "Common", 2048, 2048, 10240),
    VelvetBox = pet("Velvet Box", "Common", 2048, 1024, 20480),
    ButlerSpud = pet("Butler Spud", "Uncommon", 6144, 1536, 15360),
    CrownKetchup = pet("Crown Ketchup", "Uncommon", 3072, 3072, 15360),
    DiamondDip = pet("Diamond Dip", "Rare", 4096, 4096, 20480),
    FryUnicorn = pet("Fry Unicorn", "Epic", 6144, 3072, 61440),
    FryEmperor = pet("Fry Emperor", "Legendary", 12288, 6144, 61440),
}
return table.freeze({
    RarityOrder = table.freeze({ "Common", "Uncommon", "Rare", "Epic", "Legendary" }),
    Rarities = table.freeze(Rarities),
    Types = table.freeze(Types),
    StatOrder = table.freeze({ "FriesPerClick", "MoneyPerFry", "BagCapacity" }),
    MaxPets = 50,
    EquipSlots = 3,
    -- MergeCount unequipped copies of one pet merge into one Golden pet with GoldenMultiplier x bonus.
    MergeCount = 5,
    GoldenMultiplier = 2,
    -- Rarities that can be bulk deleted or auto-deleted. Epic and Legendary are protected.
    BulkRarities = table.freeze({ "Common", "Uncommon", "Rare" }),
})
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00009">
          <Properties>
            <string name="Name">Rebirth</string>
            <ProtectedString name="Source">-- Rebirth balance. Threshold = BaseThreshold x Growth ^ rebirths (rounded, in Cash).
-- Gems = BaseGems + GemsPerRebirth x rebirths. Rebirth resets Cash and the current bag only.
return table.freeze({
    BaseThreshold = 250000,
    Growth = 2.0,
    BaseGems = 10,
    GemsPerRebirth = 5,
})
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00010">
          <Properties>
            <string name="Name">Restaurants</string>
            <ProtectedString name="Source">-- Restaurant tiers (owner, 20 October 2026). Each tier is bought with Cash at the EXPAND kiosk,
-- keeps every earlier machine, adds one gacha machine, and dresses the restaurant in its theme.
-- Tiers are permanent and survive rebirth. Prices from tools/simulate.py (--calibrate).
local function rgb(r, g, b) return { r, g, b } end
local function tier(id, name, price, machine, tagline, theme)
    return table.freeze({ Id = id, Name = name, Price = price, Machine = machine, Tagline = tagline,
        Theme = table.freeze(theme) })
end
-- Theme colours (RGB lists, so this module needs no engine types): Main for the roof, fascia,
-- and stand body; Trim for edges and stripes; Glow for neon; Floor for the restaurant floor.
local Tiers = {
    tier("FryStand", "Fry Stand", 0, "StarterFryer", "Where every fry empire starts.",
        { Main = rgb(245, 112, 113), Trim = rgb(255, 247, 226), Glow = rgb(255, 214, 102), Floor = rgb(255, 247, 226) }),
    tier("FryDiner", "Fry Diner", 5e6, "DeluxeFryer", "Chrome, neon, and milkshakes.",
        { Main = rgb(230, 57, 70), Trim = rgb(214, 226, 233), Glow = rgb(255, 92, 168), Floor = rgb(250, 250, 250) }),
    tier("DriveIn", "Drive-In", 30e6, "DriveInGrill", "Burgers served right to your car.",
        { Main = rgb(42, 157, 143), Trim = rgb(247, 127, 0), Glow = rgb(255, 183, 3), Floor = rgb(255, 236, 200) }),
    tier("FishPier", "Fish &amp; Chips Pier", 750e6, "PierFryer", "Salty sea air and golden chips.",
        { Main = rgb(29, 53, 87), Trim = rgb(255, 255, 255), Glow = rgb(72, 202, 228), Floor = rgb(196, 150, 104) }),
    tier("CosmicDiner", "Cosmic Diner", 10e9, "CosmicFryer", "Fries that are out of this world.",
        { Main = rgb(60, 26, 110), Trim = rgb(123, 44, 191), Glow = rgb(76, 201, 240), Floor = rgb(40, 34, 70) }),
    tier("FryPalace", "Fry Palace", 350e9, "RoyalFryer", "Fit for the Fry Emperor.",
        { Main = rgb(90, 24, 154), Trim = rgb(255, 183, 3), Glow = rgb(255, 230, 140), Floor = rgb(244, 238, 228) }),
}
return table.freeze({ Tiers = table.freeze(Tiers), Max = #Tiers })
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00011">
          <Properties>
            <string name="Name">Runtime</string>
            <ProtectedString name="Source">return table.freeze({
    StationCount = 6,
    StationDistance = 16,
    ClaimDistance = 10,
    -- How close to a gacha stand pad or the EXPAND kiosk a player must be to use it.
    StandDistance = 6,
    SnapshotInterval = 0.2,
    StudioUseDataStore = false,
    LiveStoreName = "FriesProfiles_v1",
    StudioStoreName = "FriesProfiles_TEST_v1",
    AutoSaveSeconds = 45,
    LeaseSeconds = 180,
    LeaseSafetySeconds = 30,
    SaveAttempts = 3,
})
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00012">
          <Properties>
            <string name="Name">Settings</string>
            <ProtectedString name="Source">-- Player settings, saved per profile. Defaults apply when a setting has never been changed.
return table.freeze({
    Order = table.freeze({ "PetsFollow", "ShowOtherPets" }),
    Names = table.freeze({ PetsFollow = "Pets follow me", ShowOtherPets = "Show other players' pets" }),
    Hints = table.freeze({
        PetsFollow = "When off, nobody sees your equipped pets. Bonuses still apply.",
        ShowOtherPets = "Only changes what you see. Turn off for a cleaner or faster view.",
    }),
    Defaults = table.freeze({ PetsFollow = true, ShowOtherPets = true }),
})
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00013">
          <Properties>
            <string name="Name">Upgrades</string>
            <ProtectedString name="Source">-- Gem upgrade tracks, in shop order. Cost in gems = round(BaseCost x Growth ^ level).
-- Each level adds Percent to the track's multiplier: stat = (base + pets) x (1 + Percent x level).
-- Levels add up (level 5 = +50%), they do not compound. There are no level caps;
-- MaxLevel only bounds saved data, far beyond any affordable level.
local Tracks = {
    FriesPerClick = table.freeze({ Name = "Fries per click", BaseCost = 3, Growth = 1.25, Percent = 0.10 }),
    MoneyPerFry = table.freeze({ Name = "Money per fry", BaseCost = 4, Growth = 1.25, Percent = 0.10 }),
    BagCapacity = table.freeze({ Name = "Bag capacity", BaseCost = 5, Growth = 1.25, Percent = 0.10 }),
}
return table.freeze({
    Order = table.freeze({ "FriesPerClick", "MoneyPerFry", "BagCapacity" }),
    Tracks = table.freeze(Tracks),
    MaxLevel = 10000,
})
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="RBX00014">
        <Properties>
          <string name="Name">domain</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00015">
          <Properties>
            <string name="Name">Gacha</string>
            <ProtectedString name="Source">-- Gacha spins. Pure rules: the server injects `random` (returns 0 &lt;= x &lt; 1).
local Machines = require(script.Parent.Parent.config.Machines)
local PetConfig = require(script.Parent.Parent.config.Pets)
local Pets = require(script.Parent.Pets)
local Restaurant = require(script.Parent.Restaurant)
local Gacha = {}
function Gacha.isMachine(id) return type(id) == "string" and Machines.Machines[id] ~= nil end
function Gacha.pity(p, id)
    local counts = type(p.pity) == "table" and p.pity
    local count = counts and counts[id]
    return if type(count) == "number" then count else 0
end
local function rank(rarity) return PetConfig.Rarities[rarity].Rank end
-- Rarity odds for the next spin; when pity triggers, only PityRarity or better (renormalised).
function Gacha.odds(p, id)
    local machine = Machines.Machines[id]
    local forced = Gacha.pity(p, id) &gt;= machine.PityEvery - 1
    local odds, total = {}, 0
    for _, rarity in ipairs(PetConfig.RarityOrder) do
        local chance = machine.Odds[rarity] or 0
        if forced and rank(rarity) &lt; rank(machine.PityRarity) then chance = 0 end
        odds[rarity] = chance; total += chance
    end
    for rarity, chance in pairs(odds) do odds[rarity] = chance / total end
    return odds, forced
end
local function poolOf(machine, rarity)
    local pool = {}
    for _, petType in ipairs(machine.Pool) do
        if PetConfig.Types[petType].Rarity == rarity then table.insert(pool, petType) end
    end
    return pool
end
function Gacha.roll(p, id, random)
    local machine = Machines.Machines[id]
    local odds = Gacha.odds(p, id)
    local pick, chosen = random(), nil
    for _, rarity in ipairs(PetConfig.RarityOrder) do
        if odds[rarity] &gt; 0 and #poolOf(machine, rarity) &gt; 0 then
            chosen = rarity
            pick -= odds[rarity]
            if pick &lt; 0 then break end
        end
    end
    local pool = poolOf(machine, chosen)
    local index = math.clamp(math.floor(random() * #pool) + 1, 1, #pool)
    return pool[index], chosen
end
-- Price, roll, new pet, and pity change together in one non-yielding step.
function Gacha.spin(p, id, random)
    local machine = Machines.Machines[id]
    if not machine then return false, "That machine is unavailable." end
    if not Restaurant.unlocked(p, id) then return false, "Expand your restaurant to unlock this machine." end
    if Pets.full(p) then return false, "Your pet inventory is full. Delete a pet to spin again." end
    if p.cash &lt; machine.Price then return false, "Not enough Cash to spin." end
    local petType, rarity = Gacha.roll(p, id, random)
    p.cash -= machine.Price
    if type(p.pity) ~= "table" then p.pity = {} end
    p.pity[id] = if rank(rarity) &gt;= rank(machine.PityRarity) then 0 else Gacha.pity(p, id) + 1
    -- Auto-deleted rarities still cost the spin and count for pity, but are not kept.
    if Pets.autoDeletes(p, rarity) then return true, { type = petType, rarity = rarity, autoDeleted = true } end
    return true, Pets.add(p, petType, id)
end
-- Display data for the client: price, odds per rarity with pet names, and pity progress.
function Gacha.snapshot(p, id)
    local machine = Machines.Machines[id]
    local rows = {}
    for _, rarity in ipairs(PetConfig.RarityOrder) do
        local names, types = {}, {}
        for _, petType in ipairs(poolOf(machine, rarity)) do
            table.insert(names, PetConfig.Types[petType].Name); table.insert(types, petType)
        end
        if #names &gt; 0 then table.insert(rows, { rarity = rarity, chance = machine.Odds[rarity] or 0, pets = names, types = types }) end
    end
    return { id = id, name = machine.Name, price = machine.Price, odds = rows, pity = Gacha.pity(p, id),
        pityEvery = machine.PityEvery, pityRarity = machine.PityRarity, tier = machine.Tier, accent = machine.Accent,
        unlocked = Restaurant.unlocked(p, id) }
end
return Gacha
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00016">
          <Properties>
            <string name="Name">Packing</string>
            <ProtectedString name="Source">local Pricing = require(script.Parent.Pricing)
local Profile = require(script.Parent.Profile)
local Packing = {}
function Packing.add(p, amount)
    local capacity = Pricing.capacity(p)
    if type(amount) ~= "number" or amount ~= amount or amount == math.huge or amount &lt;= 0
        or p.bag.fries &gt;= capacity then return false end
    p.bag.fries = math.min(capacity, p.bag.fries + amount)
    return p.bag.fries == capacity
end
function Packing.sell(p)
    if p.bag.fries &lt; Pricing.capacity(p) then return false, "Fill your bag first." end
    local value = Pricing.sale(p)
    Pricing.credit(p, "cash", value)
    Pricing.credit(p, "lifetimeCash", value)
    Pricing.credit(p, "sales", 1)
    p.bag = Profile.emptyBag()
    return true, value
end
return Packing
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00017">
          <Properties>
            <string name="Name">Pets</string>
            <ProtectedString name="Source">-- Owned pets, equipping, deleting, and equipped stat bonuses. Pure rules.
local Config = require(script.Parent.Parent.config.Pets)
local Pets = {}
function Pets.list(p) return if type(p) == "table" and type(p.pets) == "table" then p.pets else {} end
function Pets.equipped(p) return if type(p) == "table" and type(p.equippedPets) == "table" then p.equippedPets else {} end
function Pets.find(p, id)
    for index, owned in ipairs(Pets.list(p)) do if owned.id == id then return owned, index end end
    return nil
end
function Pets.isEquipped(p, id)
    for index, equippedId in ipairs(Pets.equipped(p)) do if equippedId == id then return true, index end end
    return false
end
function Pets.isPetId(id) return type(id) == "string" and #id &lt;= 16 and string.match(id, "^P%d+$") ~= nil end
-- Golden pets give GoldenMultiplier x their normal stats.
function Pets.multiplier(owned) return if owned.golden then Config.GoldenMultiplier else 1 end
-- One pet's flat amount for a stat (fries per click, dollars per fry, or bag slots).
function Pets.petStat(owned, stat)
    local kind = Config.Types[owned.type]
    return if kind then (kind.Stats[stat] or 0) * Pets.multiplier(owned) else 0
end
-- Total flat amount the equipped pets add to a stat.
function Pets.total(p, stat)
    local total = 0
    for _, id in ipairs(Pets.equipped(p)) do
        local owned = Pets.find(p, id)
        if owned then total += Pets.petStat(owned, stat) end
    end
    return total
end
function Pets.full(p) return #Pets.list(p) &gt;= Config.MaxPets end
-- Adds a new pet with the next unique ID and returns it.
function Pets.add(p, petType, machine, golden)
    if type(p.pets) ~= "table" then p.pets = {} end
    local number = (if type(p.nextPetId) == "number" then p.nextPetId else 0) + 1
    p.nextPetId = number
    local owned = { id = "P" .. number, type = petType, machine = machine }
    if golden then owned.golden = true end
    table.insert(p.pets, owned)
    return owned
end
function Pets.equip(p, id)
    if not Pets.find(p, id) then return false, "You do not own that pet." end
    if Pets.isEquipped(p, id) then return false, "That pet is already equipped." end
    if #Pets.equipped(p) &gt;= Config.EquipSlots then return false, "All pet slots are full. Unequip a pet first." end
    if type(p.equippedPets) ~= "table" then p.equippedPets = {} end
    table.insert(p.equippedPets, id)
    return true
end
function Pets.unequip(p, id)
    local equipped, index = Pets.isEquipped(p, id)
    if not equipped then return false, "That pet is not equipped." end
    table.remove(p.equippedPets, index)
    return true
end
function Pets.delete(p, id)
    local owned, index = Pets.find(p, id)
    if not owned then return false, "You do not own that pet." end
    if Pets.isEquipped(p, id) then return false, "Unequip this pet before deleting it." end
    table.remove(p.pets, index)
    return true, owned
end
local function isBulkRarity(rarity)
    return type(rarity) == "string" and table.find(Config.BulkRarities, rarity) ~= nil
end
Pets.isBulkRarity = isBulkRarity
function Pets.isPetType(petType) return type(petType) == "string" and Config.Types[petType] ~= nil end
-- Unequipped, non-golden copies of a pet type, oldest first.
local function mergeCandidates(p, petType)
    local list = {}
    for _, owned in ipairs(Pets.list(p)) do
        if owned.type == petType and not owned.golden and not Pets.isEquipped(p, owned.id) then table.insert(list, owned) end
    end
    return list
end
-- Pet types that can be merged now, rarest first.
function Pets.mergeable(p)
    local rows = {}
    for petType, kind in pairs(Config.Types) do
        local count = #mergeCandidates(p, petType)
        if count &gt;= Config.MergeCount then
            table.insert(rows, { type = petType, name = kind.Name, count = count, rank = Config.Rarities[kind.Rarity].Rank })
        end
    end
    table.sort(rows, function(a, b) if a.rank ~= b.rank then return a.rank &gt; b.rank end return a.name &lt; b.name end)
    return rows
end
-- MergeCount unequipped copies become one Golden pet with a new ID.
function Pets.merge(p, petType)
    local candidates = mergeCandidates(p, petType)
    if #candidates &lt; Config.MergeCount then
        return false, "You need " .. Config.MergeCount .. " unequipped copies of that pet to merge."
    end
    local machine = candidates[1].machine
    for n = 1, Config.MergeCount do
        local _, index = Pets.find(p, candidates[n].id)
        table.remove(p.pets, index)
    end
    return true, Pets.add(p, petType, machine, true)
end
-- Deletes every unequipped, non-golden pet of a bulk rarity. Returns how many.
function Pets.deleteRarity(p, rarity)
    if not isBulkRarity(rarity) then return false, "That rarity cannot be bulk deleted." end
    local kept, removed = {}, 0
    for _, owned in ipairs(Pets.list(p)) do
        local kind = Config.Types[owned.type]
        if kind.Rarity == rarity and not owned.golden and not Pets.isEquipped(p, owned.id) then removed += 1
        else table.insert(kept, owned) end
    end
    if removed == 0 then return false, "No unequipped " .. rarity .. " pets to delete." end
    p.pets = kept
    return true, removed
end
function Pets.autoDeletes(p, rarity) return type(p.autoDelete) == "table" and p.autoDelete[rarity] == true end
function Pets.toggleAutoDelete(p, rarity)
    if not isBulkRarity(rarity) then return false, "That rarity cannot be auto-deleted." end
    if type(p.autoDelete) ~= "table" then p.autoDelete = {} end
    p.autoDelete[rarity] = if Pets.autoDeletes(p, rarity) then nil else true
    return true, p.autoDelete[rarity] == true
end
return Pets
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00018">
          <Properties>
            <string name="Name">Pricing</string>
            <ProtectedString name="Source">-- Effective stats: (base + equipped pets' flat stats) x (1 + upgrade percent). Old prototype
-- fields (such as `upgrades`) are never read; only `upgradeLevels` and equipped pets count.
local Economy = require(script.Parent.Parent.config.Economy)
local Upgrades = require(script.Parent.Parent.config.Upgrades)
local Pets = require(script.Parent.Pets)
local Pricing = {}
function Pricing.level(p, id)
    local levels = type(p) == "table" and p.upgradeLevels
    local level = type(levels) == "table" and levels[id]
    return if type(level) == "number" then level else 0
end
-- The upgrade multiplier for a track: 1 + Percent x level (levels add up, they do not compound).
function Pricing.multiplier(p, id) return 1 + Pricing.level(p, id) * Upgrades.Tracks[id].Percent end
local function stepped(p, id, base, petScale)
    return (base + Pets.total(p, id) * (petScale or 1)) * Pricing.multiplier(p, id)
end
function Pricing.click(p) return stepped(p, "FriesPerClick", Economy.BaseClick) end
-- Pets list money in dollars; Economy keeps it in cents.
function Pricing.perFryCents(p) return stepped(p, "MoneyPerFry", Economy.MoneyPerFryCents, 100) end
function Pricing.perFry(p) return Pricing.perFryCents(p) / 100 end
-- Capacity is whole fries.
function Pricing.capacity(p) return math.floor(stepped(p, "BagCapacity", Economy.BaseCapacity) + 1e-9) end
function Pricing.automatic() return Economy.BasicFryerPerSecond end
-- Sale value scales with the fries in a full bag, rounded down to whole Cash.
function Pricing.sale(p) return math.floor(Pricing.capacity(p) * Pricing.perFryCents(p) / 100 + 1e-9) end
function Pricing.credit(p, currency, amount)
    p[currency] = math.min(Economy.MaxCurrency, p[currency] + amount)
end
return Pricing
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00019">
          <Properties>
            <string name="Name">Profile</string>
            <ProtectedString name="Source">local Economy = require(script.Parent.Parent.config.Economy)
local Upgrades = require(script.Parent.Parent.config.Upgrades)
local PetConfig = require(script.Parent.Parent.config.Pets)
local Machines = require(script.Parent.Parent.config.Machines)
local SettingsConfig = require(script.Parent.Parent.config.Settings)
local Restaurants = require(script.Parent.Parent.config.Restaurants)
local Pricing = require(script.Parent.Pricing)
local Profile = {}
function Profile.emptyBag() return { fries = 0 } end
function Profile.new()
    return { version = 1, cash = 0, sales = 0, lifetimeCash = 0, bag = Profile.emptyBag(),
        upgradeLevels = {}, gems = 0, rebirths = 0, pets = {}, equippedPets = {}, nextPetId = 0, pity = {}, settings = {}, autoDelete = {},
        restaurantTier = 1 }
end
local function numberIn(value, low, high, integer)
    return type(value) == "number" and value == value and value &gt;= low and value &lt;= high
        and (not integer or value % 1 == 0)
end
local function validPets(p)
    if p.pets ~= nil then
        if type(p.pets) ~= "table" or #p.pets &gt; PetConfig.MaxPets then return false end
        local count, seen = 0, {}
        for _ in pairs(p.pets) do count += 1 end
        if count ~= #p.pets then return false end -- a plain list
        for _, owned in ipairs(p.pets) do
            if type(owned) ~= "table" or type(owned.id) ~= "string" or not string.match(owned.id, "^P%d+$")
                or seen[owned.id] or not PetConfig.Types[owned.type] or not Machines.Machines[owned.machine]
                or (owned.golden ~= nil and owned.golden ~= true) then
                return false
            end
            seen[owned.id] = true
        end
        if p.equippedPets ~= nil then
            if type(p.equippedPets) ~= "table" or #p.equippedPets &gt; PetConfig.EquipSlots then return false end
            local equippedCount, equippedSeen = 0, {}
            for _ in pairs(p.equippedPets) do equippedCount += 1 end
            if equippedCount ~= #p.equippedPets then return false end
            for _, id in ipairs(p.equippedPets) do
                if not seen[id] or equippedSeen[id] then return false end
                equippedSeen[id] = true
            end
        end
    elseif p.equippedPets ~= nil and (type(p.equippedPets) ~= "table" or next(p.equippedPets) ~= nil) then
        return false
    end
    if p.nextPetId ~= nil and not numberIn(p.nextPetId, 0, Economy.MaxCurrency, true) then return false end
    if p.pity ~= nil then
        if type(p.pity) ~= "table" then return false end
        for id, count in pairs(p.pity) do
            local machine = type(id) == "string" and Machines.Machines[id]
            if not machine or not numberIn(count, 0, machine.PityEvery, true) then return false end
        end
    end
    if p.settings ~= nil then
        if type(p.settings) ~= "table" then return false end
        for key, value in pairs(p.settings) do
            if type(key) ~= "string" or SettingsConfig.Defaults[key] == nil or type(value) ~= "boolean" then return false end
        end
    end
    if p.autoDelete ~= nil then
        if type(p.autoDelete) ~= "table" then return false end
        for rarity, value in pairs(p.autoDelete) do
            if type(rarity) ~= "string" or not table.find(PetConfig.BulkRarities, rarity) or value ~= true then return false end
        end
    end
    return true
end
-- Version 1 core fields, plus optional upgradeLevels, gems, rebirths, pets, equippedPets,
-- nextPetId, pity, settings, autoDelete, and restaurantTier (missing means none, defaults, or tier 1). Extra fields from the earlier prototype,
-- such as `upgrades`, stay in storage but are never used or sent to clients.
function Profile.validate(p)
    if type(p) ~= "table" or p.version ~= 1 then return false end
    for _, key in ipairs({ "cash", "sales", "lifetimeCash" }) do
        if not numberIn(p[key], 0, Economy.MaxCurrency, true) then return false end
    end
    for _, key in ipairs({ "gems", "rebirths" }) do
        if p[key] ~= nil and not numberIn(p[key], 0, Economy.MaxCurrency, true) then return false end
    end
    if p.upgradeLevels ~= nil then
        if type(p.upgradeLevels) ~= "table" then return false end
        for id, level in pairs(p.upgradeLevels) do
            if type(id) ~= "string" or not Upgrades.Tracks[id] or not numberIn(level, 0, Upgrades.MaxLevel, true) then
                return false
            end
        end
    end
    if p.restaurantTier ~= nil and not numberIn(p.restaurantTier, 1, Restaurants.Max, true) then return false end
    if not validPets(p) then return false end
    -- Capacity depends on balance data that may change between releases, so a bag only
    -- needs a sane size here; normalize() trims it to the current capacity on load.
    return type(p.bag) == "table" and numberIn(p.bag.fries, 0, Economy.MaxCurrency, false)
end
-- Keeps the bag within the current capacity (after unequipping, deleting, or a balance change).
function Profile.normalize(p)
    p.bag.fries = math.min(p.bag.fries, Pricing.capacity(p))
end
-- Saves from before gems existed (no `gems` field) bought upgrades with Cash. The owner
-- chose to reset those levels to 0 (16 Oct 2026, no live players). Runs once per save,
-- after a validated load; returns true when it changed the profile.
function Profile.migrate(p)
    local changed = false
    if p.gems == nil then
        p.gems, p.rebirths, p.upgradeLevels = 0, 0, {}
        changed = true
    end
    Profile.normalize(p)
    return changed
end
return Profile
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00020">
          <Properties>
            <string name="Name">Rebirth</string>
            <ProtectedString name="Source">-- Rebirth: convert Cash into gems at a rising threshold. Pure rules: no Instances,
-- messages, or DataStores. Gems, upgrade levels, and the rebirth count are kept.
local Config = require(script.Parent.Parent.config.Rebirth)
local Economy = require(script.Parent.Parent.config.Economy)
local Profile = require(script.Parent.Profile)
local Rebirth = {}
function Rebirth.count(p) return if type(p.rebirths) == "number" then p.rebirths else 0 end
function Rebirth.threshold(p)
    return math.floor(Config.BaseThreshold * Config.Growth ^ Rebirth.count(p) + 0.5)
end
function Rebirth.reward(p) return Config.BaseGems + Config.GemsPerRebirth * Rebirth.count(p) end
function Rebirth.ready(p) return p.cash &gt;= Rebirth.threshold(p) end
-- One non-yielding step: reset Cash and the bag, add gems, count the rebirth.
function Rebirth.perform(p)
    local threshold = Rebirth.threshold(p)
    if p.cash &lt; threshold then return false, "Reach the rebirth threshold first." end
    local gems = Rebirth.reward(p)
    p.cash = 0
    p.bag = Profile.emptyBag()
    p.gems = math.min(Economy.MaxCurrency, (p.gems or 0) + gems)
    p.rebirths = Rebirth.count(p) + 1
    return true, gems
end
function Rebirth.snapshot(p)
    return { count = Rebirth.count(p), threshold = Rebirth.threshold(p), reward = Rebirth.reward(p), ready = Rebirth.ready(p) }
end
return Rebirth
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00021">
          <Properties>
            <string name="Name">Restaurant</string>
            <ProtectedString name="Source">-- Restaurant tiers: which machines a player has, and buying the next tier with Cash. Pure rules.
local Config = require(script.Parent.Parent.config.Restaurants)
local Machines = require(script.Parent.Parent.config.Machines)
local Restaurant = {}
-- Saved in `restaurantTier`; missing (older saves) means tier 1.
function Restaurant.tier(p)
    local tier = type(p) == "table" and p.restaurantTier
    return if type(tier) == "number" and tier &gt;= 1 and tier &lt;= Config.Max and tier % 1 == 0 then tier else 1
end
function Restaurant.info(tier) return Config.Tiers[tier] end
function Restaurant.nextTier(p)
    local tier = Restaurant.tier(p)
    return if tier &lt; Config.Max then Config.Tiers[tier + 1] else nil
end
-- A machine can be used once the restaurant has reached that machine's tier.
function Restaurant.unlocked(p, machineId)
    local machine = Machines.Machines[machineId]
    return machine ~= nil and machine.Tier &lt;= Restaurant.tier(p)
end
-- The best machine the player has (the one the SPIN button visits).
function Restaurant.bestMachine(p) return Config.Tiers[Restaurant.tier(p)].Machine end
-- Pays the next tier's price and raises the tier in one non-yielding step. Tiers are never lost.
function Restaurant.expand(p)
    local nextTier = Restaurant.nextTier(p)
    if not nextTier then return false, "Your restaurant is fully upgraded." end
    if p.cash &lt; nextTier.Price then return false, "Not enough Cash to expand." end
    p.cash -= nextTier.Price
    p.restaurantTier = Restaurant.tier(p) + 1
    return true, nextTier
end
-- Display data for the client: current tier and what the next one costs and adds.
function Restaurant.snapshot(p)
    local tier = Restaurant.tier(p)
    local nextTier = Restaurant.nextTier(p)
    local row = { tier = tier, max = Config.Max, name = Config.Tiers[tier].Name, id = Config.Tiers[tier].Id }
    if nextTier then
        local machine = Machines.Machines[nextTier.Machine]
        row.nextTier = { tier = tier + 1, id = nextTier.Id, name = nextTier.Name, price = nextTier.Price,
            tagline = nextTier.Tagline, machine = nextTier.Machine, machineName = machine.Name,
            spinPrice = machine.Price, legendary = machine.Pool[#machine.Pool],
            affordable = (p.cash or 0) &gt;= nextTier.Price }
    end
    return row
end
return Restaurant
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00022">
          <Properties>
            <string name="Name">Settings</string>
            <ProtectedString name="Source">-- Saved player settings. Pure rules.
local Config = require(script.Parent.Parent.config.Settings)
local Settings = {}
function Settings.isSetting(key) return type(key) == "string" and Config.Defaults[key] ~= nil end
function Settings.get(p, key)
    local saved = type(p.settings) == "table" and p.settings[key]
    if type(saved) == "boolean" then return saved end
    return Config.Defaults[key]
end
function Settings.toggle(p, key)
    if not Settings.isSetting(key) then return false, "That setting is unavailable." end
    if type(p.settings) ~= "table" then p.settings = {} end
    p.settings[key] = not Settings.get(p, key)
    return true, p.settings[key]
end
function Settings.snapshot(p)
    local values = {}
    for _, key in ipairs(Config.Order) do values[key] = Settings.get(p, key) end
    return values
end
return Settings
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00023">
          <Properties>
            <string name="Name">Upgrades</string>
            <ProtectedString name="Source">-- Gem upgrade purchases. Pure rules: no Instances, messages, or DataStores.
local Config = require(script.Parent.Parent.config.Upgrades)
local Pricing = require(script.Parent.Pricing)
local Upgrades = {}
function Upgrades.isTrack(id) return type(id) == "string" and Config.Tracks[id] ~= nil end
function Upgrades.cost(id, level)
    local track = Config.Tracks[id]
    return math.floor(track.BaseCost * track.Growth ^ level + 0.5)
end
function Upgrades.nextCost(p, id) return Upgrades.cost(id, Pricing.level(p, id)) end
-- The current effective value of a track for display (fries, dollars per fry, or capacity).
function Upgrades.value(p, id)
    if id == "FriesPerClick" then return Pricing.click(p)
    elseif id == "MoneyPerFry" then return Pricing.perFry(p) end
    return Pricing.capacity(p)
end
-- Deducts the cost and raises the level in one non-yielding step.
function Upgrades.buy(p, id)
    if not Upgrades.isTrack(id) then return false, "That upgrade is unavailable." end
    local level = Pricing.level(p, id)
    if level &gt;= Config.MaxLevel then return false, "That upgrade is maxed out." end
    local cost = Upgrades.cost(id, level)
    local gems = if type(p.gems) == "number" then p.gems else 0
    if gems &lt; cost then return false, "Not enough gems for this upgrade." end
    p.gems = gems - cost
    if type(p.upgradeLevels) ~= "table" then p.upgradeLevels = {} end
    p.upgradeLevels[id] = level + 1
    return true, cost
end
-- Server-computed shop rows for the client to display, in shop order.
function Upgrades.snapshot(p)
    local rows = {}
    for _, id in ipairs(Config.Order) do
        local level = Pricing.level(p, id)
        -- The next value includes the same equipped pets, so it matches what the player will get.
        local nextProfile = { upgradeLevels = { [id] = level + 1 }, pets = p.pets, equippedPets = p.equippedPets }
        table.insert(rows, { id = id, name = Config.Tracks[id].Name, level = level,
            cost = Upgrades.cost(id, level), value = Upgrades.value(p, id),
            nextValue = Upgrades.value(nextProfile, id) })
    end
    return rows
end
return Upgrades
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="RBX00024">
        <Properties>
          <string name="Name">util</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00025">
          <Properties>
            <string name="Name">Copy</string>
            <ProtectedString name="Source">local function copy(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for key, child in pairs(value) do result[key] = copy(child) end
    return result
end
return copy
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00026">
          <Properties>
            <string name="Name">Format</string>
            <ProtectedString name="Source">-- Short number text for Cash, prices, and stats: 950, 1.25K, 12.5K, 125K, 1.25M, ... 1.2Dc, then
-- scientific notation (1.2e36). Three significant digits, trailing zeros dropped. Pure.
local Format = {}
local Suffixes = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
Format.Suffixes = Suffixes
local function trim(text)
    if string.find(text, "%.") then text = string.gsub(string.gsub(text, "0+$", ""), "%.$", "") end
    return text
end
-- Three significant digits for a value from 1 to 999.9...
local function significant(v)
    if v &lt; 10 then return trim(string.format("%.2f", v)) end
    if v &lt; 100 then return trim(string.format("%.1f", v)) end
    return string.format("%.0f", v)
end
-- `decimals` is used below 1,000 for values that are not whole (2 for money, else up to 2).
function Format.short(value, decimals)
    if type(value) ~= "number" or value ~= value then return "0" end
    if value == math.huge or value == -math.huge then return "MAX" end
    local sign = if value &lt; 0 then "-" else ""
    local n = math.abs(value)
    if n &lt; 1000 then
        if math.abs(n - math.floor(n + 0.5)) &lt; 1e-6 then return sign .. string.format("%d", math.floor(n + 0.5)) end
        local text = string.format("%." .. (decimals or 2) .. "f", n)
        return sign .. (if decimals then text else trim(text))
    end
    local tier = math.floor(math.log10(n) / 3 + 1e-9)
    local v = n / 1000 ^ tier
    -- 999.96K rounds to 1000K; show it as 1M instead.
    if tonumber(significant(v)) &gt;= 1000 then tier += 1; v = n / 1000 ^ tier end
    if tier &gt; #Suffixes then
        local text = string.format("%.2e", n)
        local mantissa, exponent = string.match(text, "^([%d%.]+)e%+?(%-?%d+)$")
        return sign .. trim(mantissa) .. "e" .. tostring(tonumber(exponent))
    end
    return sign .. significant(v) .. Suffixes[tier]
end
-- Dollars: "$40", "$1.50", "$1.25K", "$3.4B".
function Format.money(value) return "$" .. Format.short(value, 2) end
return Format
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00027">
          <Properties>
            <string name="Name">RateLimiter</string>
            <ProtectedString name="Source">-- Token bucket used only with server-owned timestamps and server-owned limits.
local RateLimiter = {}
RateLimiter.__index = RateLimiter
function RateLimiter.new(rate, burst)
    return setmetatable({ rate = rate, burst = burst, buckets = {} }, RateLimiter)
end
function RateLimiter:allow(key, now)
    local bucket = self.buckets[key] or { tokens = self.burst, time = now }
    bucket.tokens = math.min(self.burst, bucket.tokens + math.max(0, now - bucket.time) * self.rate)
    bucket.time = now
    self.buckets[key] = bucket
    if bucket.tokens &lt; 1 then return false end
    bucket.tokens -= 1
    return true
end
function RateLimiter:remove(key) self.buckets[key] = nil end
return RateLimiter
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX00028">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX00029">
      <Properties>
        <string name="Name">FriesServer</string>
      </Properties>
      <Item class="Script" referent="RBX00030">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">-- Composition root: connects independently testable game rules to Roblox services.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Runtime = require(Shared.config.Runtime)
local Packing = require(Shared.domain.Packing)
local Pricing = require(Shared.domain.Pricing)
local RateLimiter = require(Shared.util.RateLimiter)
local Network = require(script.Parent.Network)
local DataService = require(script.Parent.services.DataService)
local StationService = require(script.Parent.services.StationService)
local SnapshotService = require(script.Parent.services.SnapshotService)
local ActionService = require(script.Parent.services.ActionService)
local WorldBuilder = require(script.Parent.world.WorldBuilder)

local stations = WorldBuilder(Runtime.StationCount)
local data = DataService.new()
local stationService = StationService.new(stations)
local network = Network.new()
local snapshots = SnapshotService.new(data, stationService, network)
local actions = ActionService.new(data, stationService, network, snapshots)
local connections = {}
local joining = {}
local shuttingDown = false
local admitted, admittedCount = {}, 0
local claimLimit = RateLimiter.new(2, 3)
local function releaseAdmission(player)
    if admitted[player] then admitted[player] = nil; admittedCount -= 1 end
end

for index, station in ipairs(stations) do
    station.prompt.Triggered:Connect(function(player)
        if shuttingDown then return end
        if not claimLimit:allow(player, workspace:GetServerTimeNow()) then return end
        local p = data:get(player)
        if not p then return end
        local ok, message = stationService:claim(player, index)
        if ok then stationService:render(player, p) else network:notice(player, message, false) end
        snapshots:send(player)
    end)
end

local function moveCharacter(player, character)
    if character:WaitForChild("HumanoidRootPart", 10) and player.Character == character then
        stationService:teleport(player)
    end
end
local function join(player)
    if joining[player] or data.entries[player] or shuttingDown then return end
    joining[player] = true
    if admittedCount &gt;= Runtime.StationCount then
        joining[player] = nil
        player:Kick("All player spaces are taken. Please join another server.")
        return
    end
    admitted[player], admittedCount = true, admittedCount + 1
    if not data:load(player) then
        releaseAdmission(player)
        joining[player] = nil
        return
    end
    joining[player] = nil
    if shuttingDown or not player.Parent then
        releaseAdmission(player)
        data:close(player)
        return
    end
    connections[player] = player.CharacterAdded:Connect(function(character)
        task.spawn(moveCharacter, player, character)
    end)
    if player.Character then task.spawn(moveCharacter, player, player.Character) end
    snapshots:send(player)
end
Players.PlayerAdded:Connect(function(player) task.spawn(join, player) end)
Players.PlayerRemoving:Connect(function(player)
    if connections[player] then connections[player]:Disconnect(); connections[player] = nil end
    actions:remove(player)
    claimLimit:remove(player)
    stationService:release(player)
    releaseAdmission(player)
    data:close(player)
end)
network.Action.OnServerEvent:Connect(function(player, action, argument)
    if not shuttingDown then actions:handle(player, action, argument) end
end)
for _, player in ipairs(Players:GetPlayers()) do task.spawn(join, player) end

local accumulated = 0
RunService.Heartbeat:Connect(function(dt)
    if shuttingDown then return end
    for _, player in ipairs(Players:GetPlayers()) do
        local p = data:get(player)
        if p and stationService:hasStation(player) then
            -- Full bags halt production. There is no offline production in this version.
            Packing.add(p, Pricing.automatic() * math.min(dt, 0.5))
        end
    end
    accumulated += dt
    if accumulated &gt;= Runtime.SnapshotInterval then
        accumulated = 0
        for _, player in ipairs(Players:GetPlayers()) do
            local p = data:get(player)
            if p then stationService:render(player, p); snapshots:send(player) end
        end
        data:tick()
    end
end)
game:BindToClose(function() shuttingDown = true; data:shutdown() end)
print("[Fries] Restaurant ready. Studio memory mode:", data.volatile)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00031">
        <Properties>
          <string name="Name">Network</string>
          <ProtectedString name="Source">-- Transport only. All permissions and game rules are handled by ActionService.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Network = {}
Network.__index = Network
function Network.new()
    local folder = Instance.new("Folder")
    folder.Name = "FriesRemotes"
    local self = setmetatable({}, Network)
    for _, name in ipairs({ "Action", "State", "Notice" }) do
        local remote = Instance.new("RemoteEvent")
        remote.Name, remote.Parent = name, folder
        self[name] = remote
    end
    folder.Parent = ReplicatedStorage
    return self
end
function Network:notice(player, text, success)
    if player.Parent then self.Notice:FireClient(player, text, success) end
end
return Network
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX00032">
        <Properties>
          <string name="Name">services</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00033">
          <Properties>
            <string name="Name">ActionService</string>
            <ProtectedString name="Source">local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Economy = require(Shared.config.Economy)
local AllowedActions = require(Shared.config.Actions)
local RateLimiter = require(Shared.util.RateLimiter)
local Packing = require(Shared.domain.Packing)
local Pricing = require(Shared.domain.Pricing)
local Upgrades = require(Shared.domain.Upgrades)
local Rebirth = require(Shared.domain.Rebirth)
local Gacha = require(Shared.domain.Gacha)
local Pets = require(Shared.domain.Pets)
local Profile = require(Shared.domain.Profile)
local Settings = require(Shared.domain.Settings)
local Restaurant = require(Shared.domain.Restaurant)
local ActionService = {}
ActionService.__index = ActionService
function ActionService.new(data, stations, network, snapshots)
    return setmetatable({ data = data, stations = stations, network = network, snapshots = snapshots,
        generalLimit = RateLimiter.new(12, 18), clickLimit = RateLimiter.new(Economy.ClicksPerSecond, 1),
        cooldowns = {}, random = Random.new() }, ActionService)
end
function ActionService:remove(player)
    self.generalLimit:remove(player)
    self.clickLimit:remove(player)
    self.cooldowns[player] = nil
end
local function validArgument(action, argument)
    local kind = AllowedActions[action]
    if kind == "none" then return argument == nil end
    -- Upgrade takes only a known track name; never prices, levels, or Cash amounts.
    if kind == "upgrade" then return Upgrades.isTrack(argument) end
    if kind == "machine" then return Gacha.isMachine(argument) end
    if kind == "pet" then return Pets.isPetId(argument) end
    if kind == "petType" then return Pets.isPetType(argument) end
    if kind == "bulkRarity" then return Pets.isBulkRarity(argument) end
    if kind == "setting" then return Settings.isSetting(argument) end
    return false
end
function ActionService:handle(player, action, argument)
    local now = workspace:GetServerTimeNow()
    if not self.generalLimit:allow(player, now) then return end
    if type(action) ~= "string" or #action &gt; 24 or not validArgument(action, argument) then return end
    local p = self.data:get(player)
    if not p then return end
    -- Settings can change before claiming; everything else needs a restaurant.
    if action ~= "Sync" and action ~= "ToggleSetting" and not self.stations:hasStation(player) then
        self.network:notice(player, "Choose an available restaurant and press E at its entrance.", false)
        return
    end
    if (action == "Pack" or action == "Sell") and not self.stations:near(player) then
        self.network:notice(player, "Return to your counter to work.", false)
        return
    end
    -- Machines spin only at their own stand; the restaurant expands only at its kiosk.
    if action == "Spin" and self.stations:nearMachine(player) ~= argument then
        self.network:notice(player, "Walk up to that machine's stand to spin.", false)
        return
    end
    if action == "Expand" and not self.stations:nearExpand(player) then
        self.network:notice(player, "Walk to the EXPAND kiosk in your restaurant.", false)
        return
    end
    if action == "Pack" then
        if self.clickLimit:allow(player, now) then Packing.add(p, Pricing.click(p)) end
        return -- Periodic snapshots coalesce rapid input.
    end
    local delay = if action == "Sell" then 0.2 elseif action == "Upgrade" or action == "Spin" then 0.25
        elseif action == "Rebirth" or action == "Expand" then 2
        elseif action == "Return" or action == "Sync" or action == "VisitMachine" then 1
        elseif action == "DeleteRarity" or action == "MergePets" then 0.5 else 0.15
    local cooldowns = self.cooldowns[player] or {}
    self.cooldowns[player] = cooldowns
    if now &lt; (cooldowns[action] or 0) then return end
    cooldowns[action] = now + delay
    if action == "Return" then self.stations:teleport(player)
    elseif action == "VisitMachine" then self.stations:visitMachine(player, Restaurant.bestMachine(p))
    elseif action == "Expand" then
        -- Price and tier change together in one non-yielding step; the world follows.
        local ok, result = Restaurant.expand(p)
        if ok then
            self.stations:render(player, p)
            self.network:notice(player, "Welcome to your " .. result.Name .. "!", true)
        else self.network:notice(player, result, false) end
    elseif action == "Sell" then
        local ok, result = Packing.sell(p)
        if not ok then self.network:notice(player, result, false) end
    elseif action == "Upgrade" then
        -- Purchase and level change happen in one non-yielding step.
        local ok, result = Upgrades.buy(p, argument)
        if ok then self.stations:render(player, p) else self.network:notice(player, result, false) end
    elseif action == "Rebirth" then
        -- Cash, bag, gems, and count change together in one non-yielding step.
        local ok, result = Rebirth.perform(p)
        if ok then self.stations:render(player, p) else self.network:notice(player, result, false) end
    elseif action == "Spin" then
        -- Price, roll, pet, and pity change together; the roll happens only here.
        local ok, result = Gacha.spin(p, argument, function() return self.random:NextNumber() end)
        if not ok then self.network:notice(player, result, false)
        else
            self.spins = (self.spins or 0) + 1
            self.snapshots:send(player, { spin = { serial = self.spins, id = result.id, type = result.type, autoDeleted = result.autoDeleted } })
            return
        end
    elseif action == "ToggleSetting" then
        Settings.toggle(p, argument)
    elseif action == "ToggleAutoDelete" then
        Pets.toggleAutoDelete(p, argument)
    else -- Equip, Unequip, DeletePet, MergePets, DeleteRarity
        local operation = if action == "Equip" then Pets.equip elseif action == "Unequip" then Pets.unequip
            elseif action == "DeletePet" then Pets.delete elseif action == "MergePets" then Pets.merge else Pets.deleteRarity
        local ok, result = operation(p, argument)
        if ok then
            Profile.normalize(p) -- removing a capacity bonus trims an over-full bag
            self.stations:render(player, p)
        else self.network:notice(player, result, false) end
    end
    self.snapshots:send(player)
end
return ActionService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00034">
          <Properties>
            <string name="Name">DataService</string>
            <ProtectedString name="Source">local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Runtime = require(Shared.config.Runtime)
local Profile = require(Shared.domain.Profile)
local Copy = require(Shared.util.Copy)
local ProfileStore = require(script.Parent.Parent.storage.ProfileStore)
local DataService = {}
DataService.__index = DataService
function DataService.new()
    local volatile = RunService:IsStudio() and not Runtime.StudioUseDataStore
    local self = setmetatable({ entries = {}, loading = {}, closing = false, volatile = volatile }, DataService)
    if not volatile then
        local name = if RunService:IsStudio() then Runtime.StudioStoreName else Runtime.LiveStoreName
        self.repository = ProfileStore.new(DataStoreService:GetDataStore(name), {
            validate = Profile.validate, newProfile = Profile.new, copy = Copy,
            now = os.time, wait = task.wait, attempts = Runtime.SaveAttempts, leaseSeconds = Runtime.LeaseSeconds,
        })
    end
    return self
end
function DataService:load(player)
    if self.closing or self.loading[player] or self.entries[player] then return false end
    self.loading[player] = true
    local token = HttpService:GenerateGUID(false)
    local key = "Player_" .. player.UserId
    local data, expires
    if self.volatile then data, expires = Profile.new(), math.huge
    else data, expires = self.repository:load(key, token) end
    if data then Profile.migrate(data) end
    if not data then
        self.loading[player] = nil
        warn("[Fries] Load failed for", player.UserId, expires)
        if player.Parent then player:Kick("Could not safely load your progress. Please rejoin shortly.") end
        return false
    end
    self.entries[player] = { data = data, key = key, token = token, expires = expires,
        saving = false, closing = false, nextSave = os.clock() + Runtime.AutoSaveSeconds + math.random() * 10 }
    self.loading[player] = nil
    if self.closing or not player.Parent then self:close(player); return false end
    return true
end
function DataService:get(player)
    local entry = self.entries[player]
    if not entry or entry.closing or entry.lost then return nil end
    if not self.volatile and os.time() &gt;= entry.expires - Runtime.LeaseSafetySeconds then
        entry.lost = true
        player:Kick("Saving is unavailable. Please rejoin to protect your saved progress.")
        return nil
    end
    return entry.data
end
function DataService:save(player, release)
    local entry = self.entries[player]
    if not entry then return end
    if not release and (entry.saving or entry.closing or entry.lost) then return end
    while entry.saving do task.wait(0.05) end
    if self.entries[player] ~= entry then return end
    entry.saving = true
    local ok, result = true, math.huge
    if not self.volatile then
        ok, result = self.repository:save(entry.key, entry.token, entry.data, release)
    end
    entry.saving = false
    if ok then entry.expires = result
    else
        warn("[Fries] Save failed for", player.UserId, result)
        if result == "Lost session lock." then
            entry.lost = true
            if player.Parent then player:Kick("Your session moved. Please rejoin.") end
        end
    end
    if release then self.entries[player] = nil end
end
function DataService:close(player)
    local entry = self.entries[player]
    if not entry or entry.closing then return end
    entry.closing = true
    self:save(player, true)
end
function DataService:tick()
    if self.closing then return end
    for player, entry in pairs(self.entries) do
        if not entry.closing and not entry.saving and os.clock() &gt;= entry.nextSave then
            entry.nextSave = os.clock() + Runtime.AutoSaveSeconds
            task.spawn(function() self:save(player, false) end)
        end
    end
end
function DataService:shutdown()
    self.closing = true
    for player in pairs(self.entries) do task.spawn(function() self:close(player) end) end
    local deadline = os.clock() + 25
    while (next(self.entries) or next(self.loading)) and os.clock() &lt; deadline do task.wait(0.1) end
    if next(self.entries) or next(self.loading) then warn("[Fries] Shutdown save deadline reached.") end
end
return DataService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00035">
          <Properties>
            <string name="Name">SnapshotService</string>
            <ProtectedString name="Source">local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Pricing = require(Shared.domain.Pricing)
local Upgrades = require(Shared.domain.Upgrades)
local Rebirth = require(Shared.domain.Rebirth)
local Gacha = require(Shared.domain.Gacha)
local Pets = require(Shared.domain.Pets)
local PetConfig = require(Shared.config.Pets)
local Machines = require(Shared.config.Machines)
local Settings = require(Shared.domain.Settings)
local Restaurant = require(Shared.domain.Restaurant)
local SnapshotService = {}
SnapshotService.__index = SnapshotService
function SnapshotService.new(data, stations, network)
    return setmetatable({ data = data, stations = stations, network = network }, SnapshotService)
end
-- Owned pets for display: name, rarity, bonuses, and equipped state. Server-computed.
local function petRows(p)
    local rows = {}
    for _, owned in ipairs(Pets.list(p)) do
        local kind = PetConfig.Types[owned.type]
        local bonuses = {}
        for _, stat in ipairs(PetConfig.StatOrder) do
            if kind.Stats[stat] then table.insert(bonuses, { stat = stat, amount = Pets.petStat(owned, stat) }) end
        end
        table.insert(rows, { id = owned.id, type = owned.type, name = (if owned.golden then "Golden " else "") .. kind.Name,
            rarity = kind.Rarity, golden = owned.golden == true,
            rank = PetConfig.Rarities[kind.Rarity].Rank, bonuses = bonuses, equipped = Pets.isEquipped(p, owned.id) })
    end
    return rows
end
-- Public: the equipped pets other clients draw following this player ("Type" or "Type*" for
-- Golden, comma-separated). Empty when the player turned Pets follow me off.
local function followText(p)
    if not Settings.get(p, "PetsFollow") then return "" end
    local parts = {}
    for _, id in ipairs(Pets.equipped(p)) do
        local owned = Pets.find(p, id)
        if owned then table.insert(parts, owned.type .. (if owned.golden then "*" else "")) end
    end
    return table.concat(parts, ",")
end
SnapshotService.followText = followText
local function machineRows(p)
    local rows = {}
    for _, id in ipairs(Machines.Order) do rows[id] = Gacha.snapshot(p, id) end
    return rows
end
function SnapshotService:send(player, extra)
    local p = self.data:get(player)
    if not p or not player.Parent then return end
    local follow = followText(p)
    if player:GetAttribute("FollowPets") ~= follow then player:SetAttribute("FollowPets", follow) end
    self.network.State:FireClient(player, {
        profile = { cash = p.cash, gems = p.gems or 0, sales = p.sales, bag = { fries = p.bag.fries } },
        hasStation = self.stations:hasStation(player), nearStation = self.stations:near(player), volatile = self.data.volatile,
        stats = { perClick = Pricing.click(p), perSecond = Pricing.automatic(), perFry = Pricing.perFry(p),
            capacity = Pricing.capacity(p), saleValue = Pricing.sale(p) },
        shop = Upgrades.snapshot(p),
        rebirth = Rebirth.snapshot(p),
        -- Every machine with its locked state; the panel shows the one whose stand the player is at.
        machines = machineRows(p), machineOrder = Machines.Order,
        nearMachine = self.stations.nearMachine and self.stations:nearMachine(player) or nil,
        nearExpand = self.stations.nearExpand and self.stations:nearExpand(player) or false,
        restaurant = Restaurant.snapshot(p),
        pets = { owned = petRows(p), equipped = #Pets.equipped(p), slots = PetConfig.EquipSlots, max = PetConfig.MaxPets,
            mergeable = Pets.mergeable(p), mergeCount = PetConfig.MergeCount, autoDelete = table.clone(p.autoDelete or {}) },
        settings = Settings.snapshot(p),
        spin = extra and extra.spin,
    })
end
return SnapshotService
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00036">
          <Properties>
            <string name="Name">StationService</string>
            <ProtectedString name="Source">local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Pricing = require(Shared.domain.Pricing)
local Runtime = require(Shared.config.Runtime)
local Restaurant = require(Shared.domain.Restaurant)
local TierBuilder = require(script.Parent.Parent.world.TierBuilder)
local StationService = {}
StationService.__index = StationService
function StationService.new(stations) return setmetatable({ stations = stations, assigned = {} }, StationService) end
local function livingRoot(player)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not player.Parent or not root or not humanoid or humanoid.Health &lt;= 0 then return nil end
    return root
end
function StationService:claim(player, index)
    local station = self.stations[index]
    if not station then return false, "That restaurant is unavailable." end
    if self.assigned[player] then return false, "You already have a restaurant. Use Return to Counter." end
    if station.owner then return false, "Someone has already claimed this restaurant." end
    local root = livingRoot(player)
    if not root or (root.Position - station.claimPart.Position).Magnitude &gt; Runtime.ClaimDistance then
        return false, "Walk to the entrance to claim this restaurant."
    end
    -- No yields between availability and assignment: only one claimant can win.
    station.owner, self.assigned[player] = player, station
    station.prompt.Enabled = false
    station.sign.Text = player.DisplayName .. "'s\nRESTAURANT"
    station.shownTier = nil -- the next render dresses the plot in the owner's tier
    station.model:SetAttribute("OwnerUsername", player.Name)
    station.model:SetAttribute("OwnerUserId", player.UserId)
    self:teleport(player)
    return true, "Your restaurant is ready."
end
function StationService:hasStation(player) return self.assigned[player] ~= nil end
function StationService:release(player)
    local station = self.assigned[player]
    if station then
        station.owner = nil
        station.sign.Text = "RESTAURANT " .. station.index .. "\nAVAILABLE"
        station.model:SetAttribute("OwnerUsername", nil)
        station.model:SetAttribute("OwnerUserId", 0)
        station.prompt.Enabled = true
        for _, fry in ipairs(station.fries) do fry.Transparency = 1 end
        if station.stands then TierBuilder.apply(station, 1) end
    end
    self.assigned[player] = nil
end
function StationService:teleport(player)
    local station, character = self.assigned[player], player.Character
    if station and character and character:FindFirstChild("HumanoidRootPart") then
        character:PivotTo(station.spawn)
        return true
    end
    return false
end
function StationService:near(player)
    local station, root = self.assigned[player], livingRoot(player)
    return station ~= nil and root ~= nil and (root.Position - station.origin).Magnitude &lt;= Runtime.StationDistance
end
-- The id of the gacha stand whose pad the player is standing at (locked stands count, so the
-- panel can show what it needs), or nil.
function StationService:nearMachine(player)
    local station, root = self.assigned[player], livingRoot(player)
    if not station or not root or not station.stands then return nil end
    local best, bestDistance = nil, Runtime.StandDistance
    for _, stand in ipairs(station.standOrder) do
        local distance = (root.Position - stand.front).Magnitude
        if distance &lt;= bestDistance then best, bestDistance = stand.id, distance end
    end
    return best
end
function StationService:nearExpand(player)
    local station, root = self.assigned[player], livingRoot(player)
    return station ~= nil and root ~= nil and station.kiosk ~= nil
        and (root.Position - station.kiosk.front).Magnitude &lt;= Runtime.StandDistance
end
-- Moves the player onto a stand's pad, facing the stand (the SPIN menu button).
function StationService:visitMachine(player, machineId)
    local station, character = self.assigned[player], player.Character
    local stand = station and station.stands and station.stands[machineId]
    if stand and character and character:FindFirstChild("HumanoidRootPart") then
        character:PivotTo(CFrame.lookAt(stand.front, stand.facing))
        return true
    end
    return false
end
function StationService:render(player, p)
    local station = self.assigned[player]
    if not station then return end
    -- Restaurant tier visuals follow the owner's saved tier (claiming, expanding).
    local tier = Restaurant.tier(p)
    if station.stands and station.shownTier ~= tier then TierBuilder.apply(station, tier, player.DisplayName) end
    local visible = math.floor(p.bag.fries / Pricing.capacity(p) * #station.fries)
    for n, fry in ipairs(station.fries) do fry.Transparency = if n &lt;= visible then 0 else 1 end
end
return StationService
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="RBX00037">
        <Properties>
          <string name="Name">storage</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00038">
          <Properties>
            <string name="Name">ProfileStore</string>
            <ProtectedString name="Source">-- Persistence transaction rules. No Roblox globals; the store/clock are injected.
local ProfileStore = {}
ProfileStore.__index = ProfileStore
function ProfileStore.new(store, options)
    return setmetatable({ store = store, options = options, serial = 0 }, ProfileStore)
end
function ProfileStore:load(key, token)
    local o = self.options
    local lastError = "Could not load saved progress."
    for attempt = 1, o.attempts do
        local reason = nil
        local ok, result = pcall(function()
            return self.store:UpdateAsync(key, function(old)
                reason = nil
                local now = o.now()
                if old ~= nil and (type(old) ~= "table" or not o.validate(old.data)) then
                    reason = "Saved profile is invalid or uses a newer version."
                    return nil
                end
                if old and old.lease then
                    if type(old.lease) ~= "table" or type(old.lease.expires) ~= "number"
                        or old.lease.expires ~= old.lease.expires or old.lease.expires == math.huge
                        or old.lease.expires &lt; 0 or type(old.lease.token) ~= "string" then
                        reason = "Invalid saved session lock."
                        return nil
                    end
                    if old.lease.token ~= token and old.lease.expires &gt; now then
                        reason = "Your previous session is still saving. Please rejoin shortly."
                        return nil
                    end
                end
                return { data = if old then o.copy(old.data) else o.newProfile(),
                    lease = { token = token, expires = now + o.leaseSeconds }, writeId = "load:" .. token }
            end)
        end)
        if ok and result and result.lease and result.lease.token == token then
            return o.copy(result.data), result.lease.expires
        end
        lastError = reason or (if ok then "Session acquisition was cancelled." else tostring(result))
        if reason and string.find(reason, "invalid") then break end
        if attempt &lt; o.attempts then o.wait(2 ^ (attempt - 1)) end
    end
    return nil, lastError
end
function ProfileStore:save(key, token, data, release)
    local o = self.options
    if not o.validate(data) then return false, "Refusing to save invalid profile." end
    local snapshot = o.copy(data)
    self.serial += 1
    local writeId = token .. ":" .. tostring(self.serial)
    local lastError = "Could not save progress."
    for attempt = 1, o.attempts do
        local reason = nil
        local ok, result = pcall(function()
            return self.store:UpdateAsync(key, function(old)
                reason = nil
                -- A request may have committed even if its response was lost.
                if type(old) == "table" and old.writeId == writeId then return old end
                if type(old) ~= "table" or type(old.lease) ~= "table"
                    or old.lease.token ~= token or type(old.lease.expires) ~= "number"
                    or old.lease.expires &lt;= o.now() then
                    reason = "Lost session lock."
                    return nil
                end
                return { data = o.copy(snapshot), writeId = writeId,
                    lease = if release then nil else { token = token, expires = o.now() + o.leaseSeconds } }
            end)
        end)
        if ok and result and result.writeId == writeId then
            return true, if result.lease then result.lease.expires else 0
        end
        lastError = reason or tostring(result)
        if reason then break end
        if attempt &lt; o.attempts then o.wait(2 ^ (attempt - 1)) end
    end
    return false, lastError
end
return ProfileStore
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="RBX00039">
        <Properties>
          <string name="Name">world</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00040">
          <Properties>
            <string name="Name">Primitives</string>
            <ProtectedString name="Source">local Primitives = {}
function Primitives.part(parent, name, size, position, color, material)
    local part = Instance.new("Part")
    part.Name, part.Size, part.Position = name, size, position
    part.Anchored = true
    part.Color = color
    -- Smooth, untextured surfaces are the default art direction for new world pieces.
    part.Material = material or Enum.Material.SmoothPlastic
    part.Reflectance = 0
    part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    part.Parent = parent
    return part
end
function Primitives.surfaceLabel(parent, text, face, color)
    local gui = Instance.new("SurfaceGui")
    gui.Name, gui.Face = "WallArt", face
    gui.SizingMode, gui.PixelsPerStud = Enum.SurfaceGuiSizingMode.PixelsPerStud, 40
    gui.AlwaysOnTop, gui.LightInfluence = false, 0.5
    gui.Parent = parent
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.TextWrapped = true
    label.Text = text
    label.Parent = gui
    return label
end
return Primitives
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00041">
          <Properties>
            <string name="Name">StationBuilder</string>
            <ProtectedString name="Source">local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Runtime = require(Shared.config.Runtime)
local P = require(script.Parent.Primitives)
local TierBuilder = require(script.Parent.TierBuilder)
return function(parent, index, origin, yaw)
    local model = Instance.new("Model")
    model.Name, model.Parent = "Station" .. index, parent
    model:SetAttribute("OwnerUserId", 0)
    local transform = CFrame.new(origin) * CFrame.Angles(0, yaw or 0, 0)
    local function part(name, size, offset, color)
        local object = P.part(model, name, size, transform:PointToWorldSpace(offset), color)
        object.CFrame = transform * CFrame.new(offset)
        return object
    end
    local cream, coral = Color3.fromRGB(255, 247, 226), Color3.fromRGB(245, 112, 113)
    local accent = if index % 2 == 0 then Color3.fromRGB(81, 193, 181) else coral
    local wallHeight, wallBottom = 18, 0.5
    local wallCenter = wallBottom + wallHeight / 2
    local ceilingBottom = wallBottom + wallHeight
    part("Plot", Vector3.new(52, 0.4, 52), Vector3.new(0, 0.05, 0), Color3.fromRGB(141, 217, 111))
    part("RestaurantFloor", Vector3.new(42, 0.5, 34), Vector3.new(0, 0.35, -3), cream)
    part("EntrancePath", Vector3.new(12, 0.25, 12), Vector3.new(0, 0.25, 20), Color3.fromRGB(190, 137, 88))
    part("BackWall", Vector3.new(42, wallHeight, 0.8), Vector3.new(0, wallCenter, -20), cream)
    part("LeftWall", Vector3.new(0.8, wallHeight, 34), Vector3.new(-21, wallCenter, -3), cream)
    part("RightWall", Vector3.new(0.8, wallHeight, 34), Vector3.new(21, wallCenter, -3), cream)
    -- A high ceiling meets the walls while leaving the frontage open for entry.
    part("Ceiling", Vector3.new(44, 1, 36), Vector3.new(0, ceilingBottom + 0.5, -3), cream)
    part("RoofCap", Vector3.new(44.5, 0.4, 36.5), Vector3.new(0, ceilingBottom + 1.2, -3), accent)
    part("Fascia", Vector3.new(43, 3.25, 1.2), Vector3.new(0, ceilingBottom - 1.625, 14), accent)
    for _, x in ipairs({-20, 20}) do
        part("FrontPost", Vector3.new(1, wallHeight, 1), Vector3.new(x, wallCenter, 14), accent)
        part("Hedge", Vector3.new(1.5, 2, 50), Vector3.new(x / 20 * 25, 1.3, 0), Color3.fromRGB(73, 178, 51))
    end
    for n = 1, 10 do
        part("AwningStripe" .. n, Vector3.new(4.2, 0.3, 4), Vector3.new(-23.1 + n * 4.2, ceilingBottom - 0.7, 13),
            if n % 2 == 0 then cream else accent)
    end
    local plaque = part("RestaurantPlaque", Vector3.new(15, 2, 0.2), Vector3.new(0, ceilingBottom - 2, 14.7), accent)
    local sign = P.surfaceLabel(plaque, "RESTAURANT " .. index .. "\nAVAILABLE", Enum.NormalId.Back, cream)
    local claimPart = part("ClaimPoint", Vector3.new(0.5, 0.5, 0.5), Vector3.new(0, 3, 18), accent)
    claimPart.Transparency, claimPart.CanCollide = 1, false
    local prompt = Instance.new("ProximityPrompt")
    prompt.Name, prompt.ActionText, prompt.ObjectText = "ClaimRestaurant", "Claim restaurant", "Restaurant " .. index
    prompt.KeyboardKeyCode, prompt.GamepadKeyCode = Enum.KeyCode.E, Enum.KeyCode.ButtonX
    prompt.HoldDuration, prompt.MaxActivationDistance = 0, Runtime.ClaimDistance
    prompt.RequiresLineOfSight, prompt.ClickablePrompt, prompt.Enabled = false, true, true
    prompt.Parent = claimPart

    -- Four broad downward lights cover the work area, dining tables, and entrance.
    -- Unshadowed local lighting keeps the cartoon interior soft and limits rendering cost.
    local fixtureIndex = 0
    for _, x in ipairs({-10, 10}) do
        for _, z in ipairs({-11, 6}) do
            fixtureIndex += 1
            local trim = part("LightTrim" .. fixtureIndex, Vector3.new(6.8, 0.3, 3.8),
                Vector3.new(x, ceilingBottom - 0.15, z), Color3.fromRGB(189, 212, 230))
            local panel = part("LightPanel" .. fixtureIndex, Vector3.new(6, 0.15, 3),
                Vector3.new(x, ceilingBottom - 0.375, z), Color3.fromRGB(255, 251, 235))
            for _, piece in ipairs({trim, panel}) do
                piece.CanCollide, piece.CanTouch, piece.CanQuery, piece.CastShadow = false, false, false, false
            end
            local light = Instance.new("SurfaceLight")
            light.Name, light.Face = "InteriorLight", Enum.NormalId.Bottom
            light.Color = Color3.fromRGB(255, 244, 225)
            light.Brightness, light.Range, light.Angle = 0.8, 28, 140
            light.Shadows, light.Enabled, light.Parent = false, true, panel
        end
    end

    part("Counter", Vector3.new(16, 3, 3), Vector3.new(0, 2, -1), accent)
    part("Worktop", Vector3.new(16.5, 0.3, 3.5), Vector3.new(0, 3.65, -1), cream)
    local machine = part("Machine", Vector3.new(3, 2.2, 2.4), Vector3.new(-3.5, 4.9, -1), Color3.fromRGB(189, 212, 230))
    part("MachineScreen", Vector3.new(1.8, 0.7, 0.1), Vector3.new(-3.5, 5.1, 0.25), Color3.fromRGB(126, 245, 215))
    part("FryerBasket", Vector3.new(2.3, 0.15, 1.6), Vector3.new(-3.5, 6.1, -1), Color3.fromRGB(103, 137, 163))
    local bag = part("Bag", Vector3.new(1.8, 1.7, 1.3), Vector3.new(1, 4.65, -1), Color3.fromRGB(245, 195, 106))
    local fries = {}
    for n = 1, 10 do
        local fry = part("Fry" .. n, Vector3.new(0.22, 1.2 + n % 3 * 0.15, 0.22),
            Vector3.new(0.4 + (n - 1) % 5 * 0.29, 5.35, -1.3 + math.floor((n - 1) / 5) * 0.5),
            Color3.fromRGB(255, 208, 63))
        fry.CanCollide, fry.Transparency = false, 1
        table.insert(fries, fry)
    end
    -- No floating equipment labels, including on future fryers.
    part("CustomerBody", Vector3.new(1.8, 2.4, 1), Vector3.new(3.5, 2.8, -5), Color3.fromRGB(96, 190, 239))
    local head = part("CustomerHead", Vector3.new(1.4, 1.4, 1.4), Vector3.new(3.5, 4.7, -5), Color3.fromRGB(255, 205, 163))
    head.Shape = Enum.PartType.Ball
    for _, x in ipairs({3, 4}) do
        part("CustomerLeg", Vector3.new(0.7, 1.4, 0.8), Vector3.new(x, 1.2, -5), Color3.fromRGB(71, 94, 139))
    end
    for _, x in ipairs({-14, 14}) do
        part("DiningTable", Vector3.new(6, 0.4, 5), Vector3.new(x, 3, -11), Color3.fromRGB(255, 221, 158))
        part("TableBase", Vector3.new(1, 2.5, 1), Vector3.new(x, 1.6, -11), accent)
        for _, z in ipairs({-15, -7}) do
            part("DiningBench", Vector3.new(6, 1.6, 1.5), Vector3.new(x, 1.3, z), accent)
        end
    end
    local station = { model = model, index = index, origin = origin, spawn = transform * CFrame.new(Vector3.new(0, 4, 4)),
        machine = machine, bag = bag, fries = fries, sign = sign, claimPart = claimPart, prompt = prompt,
        transform = transform, accent = accent }
    -- Gacha stands, the EXPAND kiosk, and tier themes (shown at tier 1 until claimed).
    TierBuilder.build(station)
    return station
end
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00042">
          <Properties>
            <string name="Name">TierBuilder</string>
            <ProtectedString name="Source">-- Restaurant tiers in the world: one gacha stand per machine along the front of the plot, the
-- EXPAND kiosk inside, and themed decoration for tiers 2 and up. Stands for tiers the owner has
-- not reached yet stay visible but grey and LOCKED, so everyone can see what comes next.
-- Everything here is cosmetic and anchored; the server checks distances to the stand and kiosk
-- fronts before it spins or expands.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Restaurants = require(Shared.config.Restaurants)
local Machines = require(Shared.config.Machines)
local Format = require(Shared.util.Format)
local P = require(script.Parent.Primitives)
local TierBuilder = {}
local function color(list) return Color3.fromRGB(list[1], list[2], list[3]) end
local Upright = CFrame.Angles(0, 0, math.pi / 2) -- Cylinders run along X; this stands them on Y
local Locked, Ink, White = Color3.fromRGB(150, 140, 130), Color3.fromRGB(61, 31, 31), Color3.fromRGB(255, 255, 255)
local CeilingBottom = 18.5
-- Stand slots in plot space (the restaurant faces +Z): nearest the entrance path first.
local StandX = { -9, 9, -15, 15, -21, 21 }
local StandZ, PadZ = 21, 24
local KioskOffset, KioskPad = Vector3.new(-15, 0, 9), Vector3.new(-15, 0.62, 11.6)
TierBuilder.StandX = StandX

-- Adds an anchored, non-colliding part at a plot-space offset. `options`: shape, material,
-- transparency, rotation (CFrame), collide.
local function adder(station, parent)
    return function(name, size, offset, tint, options)
        options = options or {}
        local part = P.part(parent, name, size, station.transform:PointToWorldSpace(offset), tint, options.material)
        part.CFrame = station.transform * CFrame.new(offset) * (options.rotation or CFrame.new())
        if options.shape == "Ball" then part.Shape = Enum.PartType.Ball
        elseif options.shape == "Cylinder" then part.Shape = Enum.PartType.Cylinder end
        part.Transparency = options.transparency or 0
        part.CanCollide = options.collide == true
        part.CanTouch, part.CanQuery, part.CastShadow = false, false, options.shadow == true
        return part
    end
end
local function sign(part, text, tint)
    local label = P.surfaceLabel(part, text, Enum.NormalId.Back, tint)
    label.Font = Enum.Font.LuckiestGuy
    return label
end

-- One gacha stand: plinth, body, a glass dome of capsules, a sign, and a glowing pad in front.
local function buildStand(station, folder, machineId, slot)
    local machine = Machines.Machines[machineId]
    local theme = Restaurants.Tiers[machine.Tier].Theme
    local model = Instance.new("Model")
    model.Name = machineId
    model:SetAttribute("Machine", machineId)
    model.Parent = folder
    local add = adder(station, model)
    local x = StandX[slot]
    local stand = { id = machineId, model = model, theme = theme, capsules = {} }
    add("Plinth", Vector3.new(5, 0.6, 4), Vector3.new(x, 0.55, StandZ), color(theme.Trim), { collide = true })
    stand.body = add("Body", Vector3.new(4.2, 4.4, 3), Vector3.new(x, 3.05, StandZ), color(theme.Main), { collide = true, shadow = true })
    add("Chute", Vector3.new(2.6, 1.4, 0.1), Vector3.new(x, 2.2, StandZ + 1.55), Ink)
    stand.dome = add("Dome", Vector3.new(3.6, 3.6, 3.6), Vector3.new(x, 6.6, StandZ), Color3.fromRGB(200, 235, 255),
        { shape = "Ball", material = Enum.Material.Glass, transparency = 0.45 })
    for n, tint in ipairs({ { 42, 157, 143 }, { 123, 44, 191 }, { 255, 183, 3 } }) do
        table.insert(stand.capsules, add("Capsule", Vector3.new(0.9, 0.9, 0.9), Vector3.new(x - 1.4 + n * 0.7, 6.1, StandZ), color(tint), { shape = "Ball" }))
    end
    stand.cap = add("Cap", Vector3.new(0.6, 1.6, 1.6), Vector3.new(x, 8.6, StandZ), color(theme.Main), { shape = "Cylinder", rotation = Upright })
    stand.board = add("Sign", Vector3.new(5.4, 1.8, 0.3), Vector3.new(x, 10.2, StandZ), color(theme.Main))
    stand.label = sign(stand.board, machine.Name, color(theme.Trim))
    stand.pad = add("Pad", Vector3.new(0.12, 3.4, 3.4), Vector3.new(x, 0.32, PadZ), color(theme.Glow),
        { shape = "Cylinder", material = Enum.Material.Neon, rotation = Upright })
    stand.front = station.transform:PointToWorldSpace(Vector3.new(x, 3, PadZ))
    stand.facing = station.transform:PointToWorldSpace(Vector3.new(x, 3, StandZ))
    return stand
end

-- Shows a stand as usable or LOCKED for the given tier.
local function showStand(stand, tier)
    local machine = Machines.Machines[stand.id]
    local open = machine.Tier &lt;= tier
    stand.model:SetAttribute("Unlocked", open)
    stand.body.Color = if open then color(stand.theme.Main) else Locked
    stand.cap.Color = stand.body.Color
    stand.board.Color = stand.body.Color
    stand.dome.Transparency = if open then 0.45 else 0.8
    for _, capsule in ipairs(stand.capsules) do capsule.Transparency = if open then 0 else 1 end
    stand.pad.Transparency = if open then 0 else 0.7
    stand.label.Text = if open then string.upper(machine.Name) .. "\n" .. Format.money(machine.Price) .. " A SPIN"
        else "LOCKED\nNEEDS " .. string.upper(Restaurants.Tiers[machine.Tier].Name)
end

-- Builds the stands and the kiosk once per station, and remembers the base colours.
function TierBuilder.build(station)
    local folder = Instance.new("Folder")
    folder.Name, folder.Parent = "MachineStands", station.model
    station.stands, station.standOrder = {}, {}
    for slot, machineId in ipairs(Machines.Order) do
        local stand = buildStand(station, folder, machineId, slot)
        station.stands[machineId] = stand
        table.insert(station.standOrder, stand)
    end
    local kioskModel = Instance.new("Model")
    kioskModel.Name, kioskModel.Parent = "ExpandKiosk", station.model
    local add = adder(station, kioskModel)
    local k = KioskOffset
    station.kiosk = {
        model = kioskModel,
        podium = add("Podium", Vector3.new(3, 3.5, 2), k + Vector3.new(0, 2.35, 0), station.accent, { collide = true, shadow = true }),
        board = add("Board", Vector3.new(4.6, 2.6, 0.3), k + Vector3.new(0, 5.4, 0.4), Color3.fromRGB(255, 183, 3)),
        pad = add("Pad", Vector3.new(0.12, 3, 3), KioskPad, Color3.fromRGB(255, 214, 102),
            { shape = "Cylinder", material = Enum.Material.Neon, rotation = Upright }),
        front = station.transform:PointToWorldSpace(KioskPad + Vector3.new(0, 2.5, 0)),
    }
    station.kiosk.label = sign(station.kiosk.board, "EXPAND", Ink)
    -- Parts the theme recolours, with their tier 1 colours so a released plot can be reset.
    station.themed = {}
    for _, part in ipairs(station.model:GetChildren()) do
        local name = part.Name
        if part:IsA("BasePart") and (name == "RoofCap" or name == "Fascia" or name == "FrontPost" or name == "RestaurantPlaque"
            or name == "Counter" or name == "TableBase" or name == "DiningBench" or name == "RestaurantFloor"
            or string.sub(name, 1, 12) == "AwningStripe") then
            table.insert(station.themed, { part = part, original = part.Color })
        end
    end
    TierBuilder.apply(station, 1)
end

-- Themed decoration for one tier. Every piece is cosmetic.
local Decor = {}
Decor[2] = function(add, theme) -- Fry Diner: chrome stools, a jukebox, a checkered entrance
    for _, x in ipairs({ -6, -2, 2, 6 }) do
        add("StoolPole", Vector3.new(1.6, 0.3, 0.3), Vector3.new(x, 1.4, 2.4), color(theme.Trim), { shape = "Cylinder", rotation = Upright })
        add("StoolSeat", Vector3.new(0.4, 1.7, 1.7), Vector3.new(x, 2.4, 2.4), color(theme.Main), { shape = "Cylinder", rotation = Upright })
    end
    add("Jukebox", Vector3.new(3, 4.6, 2), Vector3.new(16.5, 2.9, 9), color(theme.Main), { collide = true })
    add("JukeboxTop", Vector3.new(3, 3, 3), Vector3.new(16.5, 5.2, 9), color(theme.Glow), { shape = "Ball", material = Enum.Material.Neon })
    for row = 0, 3 do
        for column = 0, 3 do
            local dark = (row + column) % 2 == 0
            add("CheckerTile", Vector3.new(3, 0.06, 3), Vector3.new(-4.5 + column * 3, 0.4, 15.5 + row * 3), if dark then Ink else White)
        end
    end
end
Decor[3] = function(add, theme) -- Drive-In: a giant burger and a classic car on the roof, string lights
    local top = CeilingBottom + 1.4
    add("BurgerBun", Vector3.new(1.4, 8, 8), Vector3.new(-4, top + 0.7, -6), Color3.fromRGB(226, 156, 72), { shape = "Cylinder", rotation = Upright })
    add("BurgerPatty", Vector3.new(1.1, 8.6, 8.6), Vector3.new(-4, top + 1.9, -6), Color3.fromRGB(110, 60, 35), { shape = "Cylinder", rotation = Upright })
    add("BurgerCheese", Vector3.new(8.4, 0.3, 8.4), Vector3.new(-4, top + 2.55, -6), Color3.fromRGB(255, 200, 40), { rotation = CFrame.Angles(0, math.pi / 4, 0) })
    add("BurgerLettuce", Vector3.new(0.4, 8.8, 8.8), Vector3.new(-4, top + 2.9, -6), Color3.fromRGB(110, 200, 70), { shape = "Cylinder", rotation = Upright })
    add("BurgerTop", Vector3.new(7.6, 7.6, 7.6), Vector3.new(-4, top + 3.6, -6), Color3.fromRGB(232, 168, 82), { shape = "Ball" })
    add("CarBody", Vector3.new(7, 1.6, 3.4), Vector3.new(12, top + 1.4, -6), color(theme.Trim))
    add("CarCabin", Vector3.new(3.8, 1.4, 3), Vector3.new(11.6, top + 2.9, -6), color(theme.Main))
    for _, wx in ipairs({ 9.6, 14.4 }) do
        for _, wz in ipairs({ -7.7, -4.3 }) do
            add("CarWheel", Vector3.new(0.7, 1.6, 1.6), Vector3.new(wx, top + 0.7, wz), Ink, { shape = "Cylinder", rotation = CFrame.Angles(0, math.pi / 2, 0) })
        end
    end
    for n = 0, 9 do
        add("StringLight", Vector3.new(0.7, 0.7, 0.7), Vector3.new(-18 + n * 4, CeilingBottom - 3.6, 15.1),
            if n % 2 == 0 then color(theme.Glow) else color(theme.Trim), { shape = "Ball", material = Enum.Material.Neon })
    end
end
Decor[4] = function(add, theme) -- Fish &amp; Chips Pier: a lighthouse, a giant fish, life rings
    local top = CeilingBottom + 1.4
    for n = 0, 2 do
        add("Lighthouse", Vector3.new(3, 3, 3), Vector3.new(14, top + 1.5 + n * 3, -10), if n % 2 == 0 then Color3.fromRGB(230, 57, 70) else White,
            { shape = "Cylinder", rotation = Upright })
    end
    add("LighthouseLamp", Vector3.new(2.6, 2.6, 2.6), Vector3.new(14, top + 10.2, -10), color(theme.Glow), { shape = "Ball", material = Enum.Material.Neon })
    add("LighthouseCap", Vector3.new(0.6, 3.4, 3.4), Vector3.new(14, top + 11.6, -10), color(theme.Main), { shape = "Cylinder", rotation = Upright })
    add("FishBody", Vector3.new(5, 5, 5), Vector3.new(-8, top + 3, -6), Color3.fromRGB(255, 160, 70), { shape = "Ball" })
    add("FishTail", Vector3.new(0.6, 3.4, 3.4), Vector3.new(-11.6, top + 3, -6), Color3.fromRGB(255, 130, 50), { rotation = CFrame.Angles(0, math.pi / 2, math.pi / 4) })
    add("FishEye", Vector3.new(1.2, 1.2, 1.2), Vector3.new(-6.2, top + 3.8, -3.9), White, { shape = "Ball" })
    add("FishPupil", Vector3.new(0.6, 0.6, 0.6), Vector3.new(-6, top + 3.8, -3.4), Ink, { shape = "Ball" })
    for _, x in ipairs({ -20, 20 }) do
        add("LifeRing", Vector3.new(0.5, 3.2, 3.2), Vector3.new(x, 8, 14.8), Color3.fromRGB(230, 57, 70), { shape = "Cylinder", rotation = CFrame.Angles(0, math.pi / 2, 0) })
        add("LifeRingCentre", Vector3.new(0.6, 1.6, 1.6), Vector3.new(x, 8, 14.8), color(theme.Main), { shape = "Cylinder", rotation = CFrame.Angles(0, math.pi / 2, 0) })
    end
end
Decor[5] = function(add, theme) -- Cosmic Diner: a ringed planet, a satellite dish, floating stars
    local top = CeilingBottom + 1.4
    add("Planet", Vector3.new(7, 7, 7), Vector3.new(-9, top + 6, -8), color(theme.Trim), { shape = "Ball" })
    add("PlanetRing", Vector3.new(0.3, 11.5, 11.5), Vector3.new(-9, top + 6, -8), color(theme.Glow),
        { shape = "Cylinder", material = Enum.Material.Neon, rotation = CFrame.Angles(0, 0, math.pi / 2 - 0.35) })
    add("DishBase", Vector3.new(2.4, 1.4, 1.4), Vector3.new(11, top + 1.2, -8), Color3.fromRGB(200, 205, 220), { shape = "Cylinder", rotation = Upright })
    add("Dish", Vector3.new(0.5, 6, 6), Vector3.new(11, top + 3.6, -8), Color3.fromRGB(225, 230, 240), { shape = "Cylinder", rotation = CFrame.Angles(0, 0, math.pi / 2 - 0.6) })
    add("DishAntenna", Vector3.new(0.3, 0.3, 3.2), Vector3.new(11, top + 4.6, -7), color(theme.Glow), { material = Enum.Material.Neon })
    for n, offset in ipairs({ { -16, 6, 2 }, { -2, 9, -2 }, { 4, 7, 6 }, { 17, 10, 2 }, { 8, 12, -12 }, { -14, 11, -14 } }) do
        add("Star" .. n, Vector3.new(0.9, 0.9, 0.9), Vector3.new(offset[1], top + offset[2], offset[3]), color(theme.Glow), { shape = "Ball", material = Enum.Material.Neon })
    end
end
Decor[6] = function(add, theme) -- Fry Palace: gold columns, a crown on the roof, a red carpet, banners
    local top = CeilingBottom + 1.4
    for _, x in ipairs({ -20, 20 }) do
        add("Column", Vector3.new(CeilingBottom, 2.4, 2.4), Vector3.new(x, CeilingBottom / 2 + 0.5, 15.4), color(theme.Trim), { shape = "Cylinder", rotation = Upright, collide = true })
        add("Banner", Vector3.new(3, 8, 0.2), Vector3.new(x * 0.6, 11, 14.9), color(theme.Main))
        add("BannerStripe", Vector3.new(3, 0.6, 0.25), Vector3.new(x * 0.6, 7.3, 14.95), color(theme.Trim))
    end
    add("CrownBase", Vector3.new(2, 10, 10), Vector3.new(0, top + 1, -5), color(theme.Trim), { shape = "Cylinder", rotation = Upright })
    for n = 0, 5 do
        local angle = n * math.pi / 3
        local x, z = math.cos(angle) * 4.2, -5 + math.sin(angle) * 4.2
        add("CrownSpike", Vector3.new(1.4, 3.2, 1.4), Vector3.new(x, top + 3.4, z), color(theme.Trim), { rotation = CFrame.Angles(0, -angle, 0) })
        add("CrownJewel", Vector3.new(1.2, 1.2, 1.2), Vector3.new(x, top + 5.4, z), if n % 2 == 0 then Color3.fromRGB(230, 57, 70) else color(theme.Main),
            { shape = "Ball", material = Enum.Material.Neon })
    end
    add("RedCarpet", Vector3.new(6, 0.08, 12), Vector3.new(0, 0.42, 20), Color3.fromRGB(196, 30, 58))
end

-- Dresses the station for a tier: stands, theme colours, roof sign, decoration, and kiosk.
function TierBuilder.apply(station, tier, ownerName)
    tier = math.clamp(tier or 1, 1, Restaurants.Max)
    local info = Restaurants.Tiers[tier]
    for _, stand in ipairs(station.standOrder) do showStand(stand, tier) end
    for _, entry in ipairs(station.themed) do
        local name = entry.part.Name
        if tier == 1 then entry.part.Color = entry.original
        elseif name == "RestaurantFloor" then entry.part.Color = color(info.Theme.Floor)
        elseif string.sub(name, 1, 12) == "AwningStripe" and tonumber(string.sub(name, 13)) % 2 == 0 then entry.part.Color = color(info.Theme.Trim)
        else entry.part.Color = color(info.Theme.Main) end
    end
    local old = station.model:FindFirstChild("TierDecor")
    if old then old:Destroy() end
    if tier &gt;= 2 then
        local folder = Instance.new("Folder")
        folder.Name, folder.Parent = "TierDecor", station.model
        local add = adder(station, folder)
        local board = add("RoofSign", Vector3.new(22, 4.5, 0.6), Vector3.new(0, CeilingBottom + 4.6, 12), color(info.Theme.Main))
        sign(board, string.upper(info.Name), color(info.Theme.Glow))
        for _, x in ipairs({ -8, 8 }) do add("RoofSignPost", Vector3.new(0.6, 3, 0.6), Vector3.new(x, CeilingBottom + 2.4, 12), color(info.Theme.Trim)) end
        add("NeonStrip", Vector3.new(42, 0.3, 0.3), Vector3.new(0, CeilingBottom - 3.4, 14.8), color(info.Theme.Glow), { material = Enum.Material.Neon })
        Decor[tier](add, info.Theme)
    end
    local kiosk, nextTier = station.kiosk, Restaurants.Tiers[tier + 1]
    kiosk.podium.Color = if tier == 1 then station.accent else color(info.Theme.Main)
    kiosk.label.Text = if nextTier then "EXPAND\n" .. string.upper(nextTier.Name) .. "  " .. Format.money(nextTier.Price) else "FULLY\nUPGRADED"
    if ownerName then station.sign.Text = ownerName .. "'s\n" .. string.upper(info.Name) end
    station.model:SetAttribute("RestaurantTier", tier)
    station.shownTier = tier
end
return TierBuilder
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00043">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <ProtectedString name="Source">local Lighting = game:GetService("Lighting")
local P = require(script.Parent.Primitives)
local StationBuilder = require(script.Parent.StationBuilder)
return function(count)
    assert(count &lt;= 6, "Expand the plot layout before adding more restaurants.")
    local previous = workspace:FindFirstChild("FriesRestaurant")
    if previous then previous:Destroy() end
    local model = Instance.new("Model")
    model.Name, model.Parent = "FriesRestaurant", workspace
    P.part(model, "Ground", Vector3.new(220, 1, 192), Vector3.new(0, -0.5, 0), Color3.fromRGB(112, 198, 91))
    -- Rolling grass beyond the hedge out to the horizon, so the district never floats in the sky.
    local outskirts = P.part(model, "Outskirts", Vector3.new(2048, 1, 2048), Vector3.new(0, -0.62, 0), Color3.fromRGB(126, 204, 98))
    outskirts.CastShadow = false
    P.part(model, "CentralPlaza", Vector3.new(198, 0.25, 48), Vector3.new(0, 0.1, 0), Color3.fromRGB(166, 113, 73))
    local pathBrown = Color3.fromRGB(190, 137, 88)
    P.part(model, "Promenade", Vector3.new(198, 0.05, 12), Vector3.new(0, 0.25, 0), pathBrown)
    -- Continuous solid hedges sit at the ground edges, outside all six plots.
    local boundary = Instance.new("Model")
    boundary.Name, boundary.Parent = "Boundary", model
    for _, edge in ipairs({
        {"North", Vector3.new(220, 12, 2), Vector3.new(0, 6, -95)},
        {"South", Vector3.new(220, 12, 2), Vector3.new(0, 6, 95)},
        {"West", Vector3.new(2, 12, 192), Vector3.new(-109, 6, 0)},
        {"East", Vector3.new(2, 12, 192), Vector3.new(109, 6, 0)},
    }) do
        local wall = P.part(boundary, edge[1], edge[2], edge[3], Color3.fromRGB(73, 156, 83))
        wall.CanCollide = true
        P.part(boundary, edge[1] .. "Cap", Vector3.new(edge[2].X, 1, edge[2].Z),
            Vector3.new(edge[3].X, 12.5, edge[3].Z), Color3.fromRGB(101, 186, 92))
    end
    for _, x in ipairs({-109, 109}) do
        for _, z in ipairs({-95, 95}) do
            P.part(boundary, "CornerPost", Vector3.new(2, 14, 2), Vector3.new(x, 7, z), Color3.fromRGB(255, 218, 147))
        end
    end
    -- The title belongs to a physical wall and follows its perspective.
    local muralWall = P.part(model, "MuralWall", Vector3.new(1.2, 14, 38), Vector3.new(-104, 7, 0), Color3.fromRGB(245, 112, 113))
    P.surfaceLabel(muralWall, "PUT THE FRIES\nIN THE BAG", Enum.NormalId.Right, Color3.fromRGB(255, 235, 181))
    local spawn = Instance.new("SpawnLocation")
    spawn.Name, spawn.Anchored, spawn.Neutral = "PlazaEntrance", true, true
    spawn.Size, spawn.Position = Vector3.new(8, 0.3, 8), Vector3.new(0, 0.35, 0)
    spawn.Color, spawn.Duration, spawn.Transparency = pathBrown, 0, 1
    spawn.Parent = model
    local stations = {}
    for index = 1, count do
        local column = (index - 1) % 3
        local south = index &gt; 3
        stations[index] = StationBuilder(model, index, Vector3.new((column - 1) * 64, 0, if south then 60 else -60),
            if south then math.pi else 0)
        P.part(model, "PlotPath" .. index, Vector3.new(12, 0.2, 12),
            Vector3.new((column - 1) * 64, 0.2, if south then 30 else -30), pathBrown)
    end
    -- Central space stays open for meeting and future, separately agreed features.
    for _, x in ipairs({-84, -32, 32, 84}) do
        for _, z in ipairs({-17, 17}) do
            P.part(model, "Planter", Vector3.new(7, 1.1, 5), Vector3.new(x, 0.8, z), Color3.fromRGB(255, 218, 147))
            local greenery = P.part(model, "Greenery", Vector3.new(6, 2, 4), Vector3.new(x, 2.1, z), Color3.fromRGB(86, 196, 73))
            greenery.Shape = Enum.PartType.Ball
        end
    end
    for _, x in ipairs({-48, 48}) do
        P.part(model, "PlazaBench", Vector3.new(8, 1.5, 2.5), Vector3.new(x, 1, 12), Color3.fromRGB(250, 183, 101))
    end
    -- Broad, soft lighting keeps the solid cartoon colors readable indoors and out.
    -- Dimmed on owner review (8 Oct 2026): the earlier values washed out the colors.
    -- LightingStyle is saved by the place builder/Rojo; runtime writes stop startup.
    Lighting.ClockTime, Lighting.Brightness = 13.5, 1.5
    Lighting.Ambient = Color3.fromRGB(136, 146, 162)
    Lighting.OutdoorAmbient = Color3.fromRGB(148, 159, 176)
    Lighting.EnvironmentDiffuseScale, Lighting.EnvironmentSpecularScale = 0.3, 0.12
    Lighting.GlobalShadows, Lighting.ShadowSoftness = true, 1
    Lighting.ExposureCompensation = -0.25
    -- A warm, hazy atmosphere softens the default blue sky into the Diner Sticker palette and
    -- blends the outskirts into the horizon.
    local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
    atmosphere.Name, atmosphere.Density, atmosphere.Offset = "DinerHaze", 0.34, 0.2
    atmosphere.Color, atmosphere.Decay = Color3.fromRGB(255, 236, 205), Color3.fromRGB(150, 205, 232)
    atmosphere.Glare, atmosphere.Haze = 0, 1.8
    atmosphere.Parent = Lighting
    return stations
end
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX00044">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX00045">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX00046">
        <Properties>
          <string name="Name">FriesClient</string>
        </Properties>
        <Item class="LocalScript" referent="RBX00047">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source">-- Client composition root. Cash and sales are determined by the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local AppView = require(script.Parent.ui.AppView)
local RestaurantMarkers = require(script.Parent.ui.RestaurantMarkers)
local PetFollower = require(script.Parent.ui.PetFollower)
local InputController = require(script.Parent.controllers.InputController)
local remotes = ReplicatedStorage:WaitForChild("FriesRemotes")
local action = remotes:WaitForChild("Action")
local stateRemote = remotes:WaitForChild("State")
local noticeRemote = remotes:WaitForChild("Notice")
local state = nil
local function send(name, argument) action:FireServer(name, argument) end
local app = AppView.new(Players.LocalPlayer:WaitForChild("PlayerGui"), send)
local markers = RestaurantMarkers.new(Players.LocalPlayer.PlayerGui, Players.LocalPlayer.UserId)
local pets = PetFollower.new(Players.LocalPlayer)
stateRemote.OnClientEvent:Connect(function(snapshot)
    state = snapshot
    app:update(snapshot)
    markers:update(snapshot.hasStation)
    pets:setShowOthers(snapshot.settings == nil or snapshot.settings.ShowOtherPets)
end)
noticeRemote.OnClientEvent:Connect(function(text, success) app:notice(text, success) end)
InputController(app.hud, send, function() return state end)
RunService.RenderStepped:Connect(function(dt)
    markers.guides:step(Players.LocalPlayer.Character, dt)
    pets:step(dt)
    local camera = workspace.CurrentCamera
    if camera then app:resize(camera.ViewportSize) end
end)
task.spawn(function()
    while not state do
        send("Sync")
        task.wait(2)
    end
end)
</ProtectedString>
          </Properties>
        </Item>
        <Item class="Folder" referent="RBX00048">
          <Properties>
            <string name="Name">controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX00049">
            <Properties>
              <string name="Name">InputController</string>
              <ProtectedString name="Source">local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Economy = require(Shared.config.Economy)
-- Holding and tapping both use the same rate-limited Pack request on the server.
return function(hud, send, getState)
    local heldInput = nil
    local holdingKey = false
    local nextPack = 0
    local function pack()
        local state = getState()
        if not state or not state.hasStation or not state.nearStation or state.profile.bag.fries &gt;= state.stats.capacity then return end
        local now = os.clock()
        if now &lt; nextPack then return end
        nextPack = now + 1 / Economy.ClicksPerSecond + 0.02
        send("Pack")
    end
    hud.pack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            heldInput = input
            pack()
        end
    end)
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or UserInputService:GetFocusedTextBox() then return end
        if input.KeyCode == Enum.KeyCode.F then holdingKey = true; pack()
        elseif input.KeyCode == Enum.KeyCode.R then hud:sellBag()
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input == heldInput or input.UserInputType == Enum.UserInputType.MouseButton1 then heldInput = nil end
        if input.KeyCode == Enum.KeyCode.F then holdingKey = false end
    end)
    UserInputService.WindowFocusReleased:Connect(function() heldInput = nil; holdingKey = false end)
    RunService.RenderStepped:Connect(function()
        if heldInput and not hud.frame.Visible then heldInput = nil end
        if heldInput or holdingKey then pack() end
    end)
end
</ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="RBX00050">
          <Properties>
            <string name="Name">ui</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX00051">
            <Properties>
              <string name="Name">AppView</string>
              <ProtectedString name="Source">-- Screen layout in the Diner Sticker style: a receipt-style wallet (Cash and Gems) at the top
-- left, the menu below it (labelled pills, or labelled tiles on short screens), Return
-- to Counter and Settings at the top, guidance above Pack and Sell at the bottom centre.
local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local Icons = require(script.Parent.Icons)
local HudView = require(script.Parent.HudView)
local ShopView = require(script.Parent.ShopView)
local RebirthView = require(script.Parent.RebirthView)
local GachaView = require(script.Parent.GachaView)
local PetsView = require(script.Parent.PetsView)
local SettingsView = require(script.Parent.SettingsView)
local RestaurantView = require(script.Parent.RestaurantView)
local AppView = {}
AppView.__index = AppView
local Margin, TopBar = 16, 48
function AppView.new(playerGui, send)
    local self = setmetatable({}, AppView)
    local gui = Instance.new("ScreenGui")
    gui.Name, gui.ResetOnSpawn, gui.ZIndexBehavior = "FriesInterface", false, Enum.ZIndexBehavior.Sibling
    gui.Parent = playerGui
    -- Wallet: a cream receipt card with a coin row, a dashed divider, and a gem row.
    self.cashCard = E.box(gui, "CashCard", UDim2.fromOffset(Margin, 12), UDim2.fromOffset(220, 112), Theme.Cream, 20)
    self.cashCard.AnchorPoint = Vector2.new(0, 0)
    E.sticker(self.cashCard, 4, 6)
    local coin = Icons.make(self.cashCard, "cash", 40, Theme.Ink, UDim2.fromOffset(12, 10))
    coin.Name = "Coin"
    self.wallet = E.label(self.cashCard, "$0", 40, Theme.Ink)
    self.wallet.Name, self.wallet.Position, self.wallet.Size = "Cash", UDim2.fromOffset(60, 10), UDim2.new(1, -72, 0, 40)
    self.wallet.Font, self.wallet.TextSize = Theme.Display, 30
    E.fit(self.wallet, 12, 30)
    self.divider = E.dashes(self.cashCard, "Divider", UDim2.fromOffset(12, 56), 196)
    local gem = Icons.make(self.cashCard, "gem", 36, Theme.Gem, UDim2.fromOffset(14, 64))
    gem.Name = "GemIcon"
    self.gems = E.label(self.cashCard, "0", 36, Theme.Ink)
    self.gems.Name, self.gems.Position, self.gems.Size = "Gems", UDim2.fromOffset(60, 64), UDim2.new(1, -124, 0, 36)
    self.gems.Font, self.gems.TextSize = Theme.Display, 26
    E.fit(self.gems, 10, 26)
    local gemCaption = E.label(self.cashCard, "GEMS", 18, Theme.Muted)
    gemCaption.Name, gemCaption.AnchorPoint = "GemCaption", Vector2.new(1, 0)
    gemCaption.Position, gemCaption.Size, gemCaption.TextSize = UDim2.new(1, -12, 0, 74), UDim2.fromOffset(52, 18), 13
    gemCaption.TextXAlignment = Enum.TextXAlignment.Right
    -- Studio-only label in the bottom-left corner, below every control.
    self.mode = E.label(gui, "", 16, Theme.Ink)
    self.mode.Name, self.mode.Position, self.mode.Size, self.mode.TextSize = "Mode", UDim2.new(0, Margin, 1, -21), UDim2.fromOffset(220, 15), 11
    -- Return to Counter: a ketchup sticker pill with a home icon.
    self.teleport = E.button(gui, "RETURN TO COUNTER", function()
        if self.hasStation then send("Return") end
    end, Theme.Red, 0)
    self.teleport.Name, self.teleport.TextColor3, self.teleport.TextSize = "Teleport", Theme.OnColor, 16
    self.teleport:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, 24)
    E.sticker(self.teleport, 4, 5)
    E.textStroke(self.teleport, Theme.Ink, 2)
    E.fit(self.teleport, 9, 16)
    local padding = Instance.new("UIPadding")
    padding.PaddingLeft, padding.PaddingRight, padding.Parent = UDim.new(0, 44), UDim.new(0, 12), self.teleport
    local home = Icons.make(self.teleport, "home", 26, Theme.White, UDim2.new(0, -32, 0.5, -13))
    home.Name = "HomeIcon"
    -- Guidance and errors: a cream sticker strip.
    self.guidance = E.label(gui, "", 48, Theme.Ink)
    self.guidance.Name, self.guidance.AnchorPoint = "Guidance", Vector2.new(0.5, 0)
    self.guidance.TextXAlignment, self.guidance.TextSize = Enum.TextXAlignment.Center, 14
    self.guidance.BackgroundColor3, self.guidance.BackgroundTransparency = Theme.Cream, 0
    E.corner(self.guidance, 16)
    E.stroke(self.guidance, Theme.White, 3, 0)
    self.hud = HudView.new(gui, send)
    self.shop = ShopView.new(gui, send)
    self.rebirth = RebirthView.new(gui, send)
    self.gacha = GachaView.new(gui, send)
    self.pets = PetsView.new(gui, send)
    -- Menu order: Upgrades, Rebirth, Spin, Pets.
    self.menus = { self.shop, self.rebirth, self.gacha, self.pets }
    self.settings = SettingsView.new(gui, send)
    -- The EXPAND panel has no menu button: it opens at the kiosk in the restaurant.
    self.restaurant = RestaurantView.new(gui, send)
    -- Opening one panel closes the others so they never stack.
    self.panels = { self.shop, self.rebirth, self.gacha, self.pets, self.settings, self.restaurant }
    for _, menu in ipairs(self.panels) do
        if menu.button then menu.button.Activated:Connect(function()
            if not menu.panel.Visible then return end
            for _, other in ipairs(self.panels) do if other ~= menu then other:setOpen(false) end end
        end) end
    end
    self:resize(Vector2.new(1280, 720))
    return self
end
function AppView:update(state)
    self.hasStation = state.hasStation
    self.wallet.Text = E.money(state.profile.cash)
    self.gems.Text = E.count(state.profile.gems or 0)
    self.mode.Text = if state.volatile then "STUDIO TEST / resets on stop" else ""
    self.teleport.Active, self.teleport.Selectable = state.hasStation, state.hasStation
    self.teleport.Text = if state.hasStation then "RETURN TO COUNTER" else "CHOOSE A RESTAURANT"
    self.teleport.AutoButtonColor = state.hasStation
    self.teleport.BackgroundColor3 = if state.hasStation then Theme.Red else Theme.Muted
    if not self.errorUntil or os.clock() &gt;= self.errorUntil then
        local nextTier = state.restaurant and state.restaurant.nextTier
        local canExpand = state.hasStation and nextTier ~= nil and nextTier.affordable and not state.nearExpand
        self.guidance.Visible = not state.hasStation or canExpand
        self.guidance.Text = if canExpand then "You can afford the " .. nextTier.name .. "! Walk to the EXPAND kiosk inside your restaurant."
            else "Follow an AVAILABLE arrow. Press E or tap the entrance prompt to claim."
        self.guidance.TextColor3 = Theme.Ink
    end
    self.hud:update(state)
    for _, menu in ipairs(self.panels) do menu:update(state) end
    -- A panel that opened itself (walking up to a stand or the kiosk) closes the others.
    for _, menu in ipairs(self.panels) do
        if menu.focusRequested then
            menu.focusRequested = nil
            for _, other in ipairs(self.panels) do if other ~= menu then other:setOpen(false) end end
        end
    end
end
function AppView:notice(text, success)
    -- Sales are acknowledged by the wallet and bag reset, without a bottom toast.
    if success then return end
    self.errorUntil = os.clock() + 4
    self.guidance.Visible, self.guidance.Text, self.guidance.TextColor3 = true, text, Theme.Red
end
function AppView:resize(viewport)
    if self.viewportX == viewport.X and self.viewportY == viewport.Y then return end
    self.viewportX, self.viewportY = viewport.X, viewport.Y
    local width, height = viewport.X, viewport.Y - 60
    local portrait = viewport.X &lt; 760 and viewport.Y &gt;= 500
    local short = viewport.Y &lt; 500
    local compact = viewport.X &lt; 760 and short
    -- Wallet, top left.
    local cardWidth, cardHeight = if compact then 184 else 220, if compact then 100 else 112
    self.cashCard.Size = UDim2.fromOffset(cardWidth, cardHeight)
    self.divider.Position = UDim2.fromOffset(12, if compact then 50 else 56)
    self.divider.Size = UDim2.fromOffset(cardWidth - 24, 3)
    local walletRight = Margin + cardWidth
    local teleportWidth = if compact then 150 elseif portrait then math.min(220, width - Margin * 2 - TopBar - 10) else 220
    local groupWidth = teleportWidth + 10 + TopBar
    local groupLeft, groupTop, guidanceLeft, guidanceRight, guidanceTop, guidanceHeight, menuTop, menuMode
    local hudScale = math.min(1, (width - 24) / HudView.Width)
    if short then
        -- Short screens: labelled tiles in a row at the top right, the top bar under them,
        -- guidance between the wallet and the tiles, and Pack and Sell scaled to fit below.
        local tileWidth, tileHeight, tileGap = 58, 64, 6
        local tilesLeft = width - Margin - #self.menus * tileWidth - (#self.menus - 1) * tileGap
        for index, menu in ipairs(self.menus) do
            E.setMenuMode(menu.button, "tile", tileWidth, tileHeight)
            menu.button.AnchorPoint = Vector2.new(0, 0)
            menu.button.Position = UDim2.fromOffset(tilesLeft + (index - 1) * (tileWidth + tileGap), 12)
        end
        groupLeft, groupTop = width - Margin - groupWidth, 12 + tileHeight + 12
        guidanceLeft, guidanceRight = walletRight + 18, math.min(tilesLeft, groupLeft) - 12
        guidanceTop, guidanceHeight = 12, 76
        local topBottom = math.max(12 + cardHeight + 6, groupTop + TopBar + 5)
        hudScale = math.min(hudScale, (height - 22 - topBottom - 12) / HudView.Height)
    else
        if portrait then
            groupLeft, groupTop = Margin, 12 + cardHeight + 14
            menuTop = groupTop + TopBar + 16
        else
            groupLeft, groupTop = math.max(walletRight + 20, math.floor(width / 2 - groupWidth / 2)), 12
            menuTop = 12 + cardHeight + 16
        end
        local actionTop = height - 22 - HudView.Height * hudScale
        if portrait then
            -- Portrait: guidance sits just above Pack and Sell.
            guidanceLeft, guidanceRight, guidanceHeight = Margin, width - Margin, 48
            guidanceTop = actionTop - 12 - guidanceHeight
        else
            -- Wide screens: guidance under the top bar, clear of the wallet.
            local half = math.min(230, width / 2 - walletRight - 18)
            guidanceLeft, guidanceRight, guidanceHeight = width / 2 - half, width / 2 + half, 48
            guidanceTop = groupTop + TopBar + 14
        end
        -- Labelled pills when the column fits; otherwise labelled tiles in a 2x2 grid.
        local limit = if portrait then guidanceTop - 12 else actionTop - 12
        local pillHeight, pillGap = 50, 9
        menuMode = if menuTop + #self.menus * (pillHeight + pillGap) - pillGap &lt;= limit then "pill" else "tile"
        for index, menu in ipairs(self.menus) do
            local button = menu.button
            button.AnchorPoint = Vector2.new(0, 0)
            if menuMode == "pill" then
                E.setMenuMode(button, "pill", cardWidth, pillHeight)
                button.Position = UDim2.fromOffset(Margin, menuTop + (index - 1) * (pillHeight + pillGap))
            else
                local column, row = (index - 1) % 2, math.floor((index - 1) / 2)
                local tileWidth = math.floor((cardWidth - 10) / 2)
                E.setMenuMode(button, "tile", tileWidth, 70)
                button.Position = UDim2.fromOffset(Margin + column * (tileWidth + 10), menuTop + row * 80)
            end
        end
    end
    self.teleport.AnchorPoint = Vector2.new(0, 0)
    self.teleport.Size = UDim2.fromOffset(teleportWidth, TopBar)
    self.teleport.Position = UDim2.fromOffset(groupLeft, groupTop)
    self.settings.button.AnchorPoint = Vector2.new(0, 0)
    self.settings.button.Size = UDim2.fromOffset(TopBar, TopBar)
    self.settings.button.Position = UDim2.fromOffset(groupLeft + teleportWidth + 10, groupTop)
    local guidanceWidth = math.max(120, guidanceRight - guidanceLeft)
    self.guidance.Position = UDim2.fromOffset(guidanceLeft + guidanceWidth / 2, guidanceTop)
    self.guidance.Size = UDim2.fromOffset(guidanceWidth, guidanceHeight)
    self.guidance.TextSize = if guidanceWidth &gt;= 300 then 14 else 12
    for _, menu in ipairs(self.panels) do menu:resize(viewport) end
    self.hud.scale.Scale = hudScale
end
return AppView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00052">
            <Properties>
              <string name="Name">Elements</string>
              <ProtectedString name="Source">-- Shared widgets in the Diner Sticker style: white sticker borders, solid ink shadows
-- offset down and right, Luckiest Guy labels on buttons, and one panel frame.
local Theme = require(script.Parent.Theme)
local Format = require(game:GetService("ReplicatedStorage"):WaitForChild("FriesShared").util.Format)
local Elements = {}
-- Numbers use the shared short format: 950, 1.25K, 3.4M, 1.25B, 2T, ... (see shared/util/Format).
function Elements.count(value) return Format.short(value) end
function Elements.money(value) return Format.money(value) end
-- Whole numbers stay whole; upgrade percentages can make stats fractional (2.2 fries per click).
function Elements.number(value) return Format.short(value) end
-- Shrinks text to fit on one line, between min and max sizes.
function Elements.fit(label, min, max)
    label.TextScaled, label.TextWrapped = true, false
    local constraint = Instance.new("UITextSizeConstraint")
    constraint.Name, constraint.MinTextSize, constraint.MaxTextSize, constraint.Parent = "Fit", min, max, label
    return constraint
end
function Elements.stroke(parent, color, thickness, transparency)
    local stroke = Instance.new("UIStroke")
    stroke.Color, stroke.Thickness, stroke.Transparency = color, thickness, transparency or 0
    stroke.ApplyStrokeMode, stroke.Parent = Enum.ApplyStrokeMode.Border, parent
    return stroke
end
-- An outline around the letters themselves (for white titles on colour).
function Elements.textStroke(label, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Name, stroke.Color, stroke.Thickness = "TextOutline", color or Theme.Ink, thickness or 2
    stroke.ApplyStrokeMode, stroke.Parent = Enum.ApplyStrokeMode.Contextual, label
    return stroke
end
function Elements.corner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius, corner.Parent = UDim.new(0, radius or 10), parent
    return corner
end
function Elements.box(parent, name, position, size, color, radius)
    local frame = Instance.new("Frame")
    frame.Name, frame.Position, frame.Size = name, position, size
    frame.BackgroundColor3, frame.BorderSizePixel, frame.Parent = color, 0, parent
    Elements.corner(frame, radius)
    return frame
end
function Elements.label(parent, text, height, color)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, height or 42)
    label.BackgroundTransparency = 1
    label.Font = Theme.Body
    label.TextSize = 15
    label.TextColor3 = color or Theme.Text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextWrapped = true
    label.Text = text
    label.Parent = parent
    return label
end
-- A solid ink "shadow" sibling that follows its target's position, size, visibility, and
-- layer. Roblox draws children above their parent, so a drop shadow must be a sibling.
-- Never use on a direct child of a list layout (the shadow would become a list item).
local Followed = { "Position", "Size", "AnchorPoint", "Visible", "ZIndex", "Name", "Parent" }
function Elements.shadow(target, offset, color)
    offset = offset or Theme.ShadowOffset
    local shadow = Instance.new("Frame")
    shadow.BackgroundColor3, shadow.BorderSizePixel = color or Theme.Ink, 0
    local corner = Elements.corner(shadow, 0)
    if target.ZIndex == nil or target.ZIndex &lt; 2 then target.ZIndex = 2 end
    local function sync()
        local p = target.Position or UDim2.new()
        shadow.Name = target.Name .. "Shadow"
        shadow.AnchorPoint, shadow.Size = target.AnchorPoint or Vector2.new(0, 0), target.Size
        shadow.Position = UDim2.new(p.X.Scale, p.X.Offset + offset, p.Y.Scale, p.Y.Offset + offset)
        shadow.Visible = target.Visible
        shadow.ZIndex = (target.ZIndex or 2) - 1
        local targetCorner = target:FindFirstChildOfClass("UICorner")
        corner.CornerRadius = if targetCorner then targetCorner.CornerRadius else UDim.new(0, 0)
        shadow.Parent = target.Parent
    end
    for _, property in ipairs(Followed) do target:GetPropertyChangedSignal(property):Connect(sync) end
    sync()
    return shadow
end
-- Sticker look: white border plus an offset ink shadow.
function Elements.sticker(target, border, offset)
    Elements.stroke(target, Theme.White, border or Theme.Border, 0)
    return Elements.shadow(target, offset or Theme.ShadowOffset)
end
-- A sticker button with a Luckiest Guy label. Pass shadowOffset = 0 for a flat button.
function Elements.button(parent, text, callback, color, shadowOffset)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 44)
    button.BackgroundColor3 = color or Theme.Gold
    button.TextColor3 = Theme.Ink
    button.Font = Theme.Display
    button.TextSize = 16
    button.TextWrapped = true
    button.Text = text
    button.BorderSizePixel = 0
    button.Parent = parent
    Elements.corner(button, 14)
    if shadowOffset ~= 0 then
        Elements.stroke(button, Theme.White, 3, 0)
        Elements.shadow(button, shadowOffset or 3)
    end
    if callback then button.Activated:Connect(callback) end
    return button
end
function Elements.column(parent, name)
    local frame = Instance.new("ScrollingFrame")
    frame.Name = name
    frame.Size = UDim2.fromScale(1, 1)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.ScrollBarThickness = 6
    frame.ScrollBarImageColor3 = Theme.Muted
    frame.CanvasSize = UDim2.new()
    frame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    frame.Parent = parent
    local padding = Instance.new("UIPadding")
    padding.PaddingRight = UDim.new(0, 10)
    padding.PaddingBottom = UDim.new(0, 12)
    padding.PaddingTop = UDim.new(0, 4)
    padding.PaddingLeft = UDim.new(0, 4)
    padding.Parent = frame
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 10)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = frame
    return frame
end
function Elements.bar(parent, color, height)
    local outer = Instance.new("Frame")
    outer.Size = UDim2.new(1, 0, 0, height or 18)
    outer.BackgroundColor3 = Theme.Chip
    outer.BorderSizePixel = 0
    outer.Parent = parent
    Elements.corner(outer, 5)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BackgroundColor3 = color or Theme.Gold
    fill.BorderSizePixel = 0
    fill.Parent = outer
    Elements.corner(fill, 5)
    return outer, fill
end
-- A dashed tan divider, like a receipt.
function Elements.dashes(parent, name, position, width)
    local holder = Instance.new("Frame")
    holder.Name, holder.Position, holder.Size = name, position, UDim2.fromOffset(width, 3)
    holder.BackgroundTransparency, holder.ClipsDescendants, holder.Parent = 1, true, parent
    for x = 0, width - 6, 12 do
        Elements.box(holder, "Dash", UDim2.fromOffset(x, 0), UDim2.fromOffset(6, 3), Theme.Tan, 1)
    end
    return holder
end
-- The shared modal frame: cream body with a white sticker border and shadow, a ketchup
-- header with a white Luckiest Guy title, a red-and-cream checker strip, and a close button.
-- Content starts at Elements.PanelTop. Title, Caption, and Close are direct panel children.
Elements.PanelTop = 70
function Elements.panel(gui, name, width, height, accent)
    local panel = Elements.box(gui, name, UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(width, height), Theme.Cream, 26)
    panel.AnchorPoint, panel.Visible = Vector2.new(0.5, 0.5), false
    Elements.stroke(panel, Theme.White, 5, 0)
    panel.ZIndex = 6
    local panelShadow = Elements.shadow(panel, 8)
    local headerColor = accent or Theme.Red
    local header = Elements.box(panel, "Header", UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 58), headerColor, 22)
    header.ZIndex = 0
    local square = Elements.box(header, "Square", UDim2.new(0, 0, 1, -22), UDim2.new(1, 0, 0, 22), headerColor, 0)
    square.ZIndex = 0
    local checker = Instance.new("Frame")
    checker.Name, checker.Position, checker.Size = "Checker", UDim2.fromOffset(0, 58), UDim2.new(1, 0, 0, 10)
    checker.BackgroundColor3, checker.BorderSizePixel, checker.ClipsDescendants = Theme.Cream, 0, true
    checker.ZIndex, checker.Parent = 0, panel
    -- Enough cells for the widest a resizable panel gets; the strip clips the rest.
    for index = 0, math.ceil(math.max(width, 760) / 10) - 1 do
        if index % 2 == 0 then
            local cell = Instance.new("Frame")
            cell.Name, cell.Position, cell.Size = "Cell", UDim2.fromOffset(index * 10, 0), UDim2.fromOffset(10, 10)
            cell.BackgroundColor3, cell.BorderSizePixel, cell.ZIndex, cell.Parent = headerColor, 0, 0, checker
        end
    end
    local title = Elements.label(panel, string.upper(name), 34, Theme.OnColor)
    title.Name, title.Position, title.Size = "Title", UDim2.fromOffset(20, 7), UDim2.new(1, -96, 0, 34)
    title.Font, title.TextSize = Theme.Display, 28
    Elements.textStroke(title, Theme.Ink, 2)
    Elements.fit(title, 14, 28)
    local caption = Elements.label(panel, "", 16, Color3.fromRGB(255, 232, 214))
    caption.Name, caption.Position, caption.Size, caption.TextSize = "Caption", UDim2.fromOffset(20, 38), UDim2.new(1, -96, 0, 16), 12
    Elements.fit(caption, 8, 12)
    local close = Elements.button(panel, "X", nil, Theme.Ink, 0)
    close.Name, close.Position, close.Size = "Close", UDim2.new(1, -50, 0, 10), UDim2.fromOffset(38, 38)
    close.TextColor3, close.TextSize = Theme.White, 18
    close:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, 19)
    Elements.stroke(close, Theme.White, 3, 0)
    local scale = Instance.new("UIScale")
    scale.Parent = panel
    -- The shadow is a sibling, so it needs its own UIScale that mirrors the panel's.
    local shadowScale = Instance.new("UIScale")
    shadowScale.Parent = panelShadow
    scale:GetPropertyChangedSignal("Scale"):Connect(function() shadowScale.Scale = scale.Scale end)
    return { panel = panel, title = title, caption = caption, close = close, scale = scale }
end
-- Menu buttons: a coloured sticker pill with a cream icon disc and a white outlined label.
-- setMenuMode switches between the wide pill and a round icon-only button.
function Elements.menuButton(parent, name, text, icon, accent, callback)
    local Icons = require(script.Parent.Icons)
    local button = Elements.button(parent, "", callback, accent, 0)
    button.Name, button.AutoButtonColor = name, true
    Elements.stroke(button, Theme.White, 4, 0)
    Elements.shadow(button, 5)
    local disc = Elements.box(button, "Disc", UDim2.new(0, 7, 0.5, 0), UDim2.fromOffset(36, 36), Theme.Cream, 18)
    disc.AnchorPoint = Vector2.new(0, 0.5)
    local glyph = Icons.make(disc, icon, 26, accent)
    glyph.AnchorPoint, glyph.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
    local label = Elements.label(button, text, 30, Theme.OnColor)
    label.Name, label.Position, label.Size = "Label", UDim2.new(0, 52, 0.5, -15), UDim2.new(1, -60, 0, 30)
    label.Font, label.TextSize = Theme.Display, 19
    Elements.textStroke(label, Theme.Ink, 2)
    Elements.fit(label, 7, 19)
    local badge = Elements.box(button, "Badge", UDim2.new(1, -14, 0, -8), UDim2.fromOffset(22, 22), Theme.Gold, 11)
    Elements.stroke(badge, Theme.White, 2, 0)
    local mark = Elements.label(badge, "!", 22, Theme.Ink)
    mark.Size, mark.Font, mark.TextSize, mark.TextXAlignment = UDim2.fromScale(1, 1), Theme.Display, 15, Enum.TextXAlignment.Center
    badge.Visible = false
    return button
end
-- Menu buttons always show their name. "pill": icon disc on the left, label beside it.
-- "tile": icon disc on top, label underneath (Pet Simulator style, for short screens).
function Elements.setMenuMode(button, mode, width, height)
    local pill = mode == "pill"
    button:SetAttribute("MenuMode", mode)
    button.Size = UDim2.fromOffset(width, height)
    button:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, if pill then math.floor(height / 2) else 16)
    local disc, label = button.Disc, button.Label
    local discSize = if pill then 36 else math.min(width - 18, height - 28)
    disc.Size = UDim2.fromOffset(discSize, discSize)
    disc:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, math.floor(discSize / 2))
    disc.AnchorPoint = if pill then Vector2.new(0, 0.5) else Vector2.new(0.5, 0)
    disc.Position = if pill then UDim2.new(0, 7, 0.5, 0) else UDim2.new(0.5, 0, 0, 6)
    label.Visible = true
    if pill then
        label.Position, label.Size = UDim2.new(0, 52, 0.5, -15), UDim2.new(1, -60, 0, 30)
        label.TextXAlignment, label.Fit.MaxTextSize = Enum.TextXAlignment.Left, 19
    else
        label.Position, label.Size = UDim2.new(0, 3, 1, -21), UDim2.new(1, -6, 0, 16)
        label.TextXAlignment, label.Fit.MaxTextSize = Enum.TextXAlignment.Center, 12
    end
end
function Elements.setMenuEnabled(button, enabled, accent)
    button.BackgroundColor3 = if enabled then accent else Theme.Disabled
    button.Active, button.Selectable, button.AutoButtonColor = enabled, enabled, enabled
end
-- A scrolling grid of fixed-size cells (tiles). Never give its children sibling shadows.
function Elements.grid(parent, name, cellWidth, cellHeight, gap)
    local frame = Instance.new("ScrollingFrame")
    frame.Name, frame.BackgroundTransparency, frame.BorderSizePixel = name, 1, 0
    frame.Size, frame.ScrollBarThickness, frame.ScrollBarImageColor3 = UDim2.fromScale(1, 1), 6, Theme.Muted
    frame.CanvasSize, frame.AutomaticCanvasSize = UDim2.new(), Enum.AutomaticSize.Y
    frame.Parent = parent
    local padding = Instance.new("UIPadding")
    padding.PaddingTop, padding.PaddingLeft = UDim.new(0, 6), UDim.new(0, 4)
    padding.PaddingRight, padding.PaddingBottom = UDim.new(0, 10), UDim.new(0, 10)
    padding.Parent = frame
    local layout = Instance.new("UIGridLayout")
    layout.CellSize, layout.CellPadding = UDim2.fromOffset(cellWidth, cellHeight), UDim2.fromOffset(gap or 10, gap or 10)
    layout.SortOrder, layout.Parent = Enum.SortOrder.LayoutOrder, frame
    return frame, layout
end
-- Stretches grid cells so the columns fill `areaWidth` (no empty strip on the right). Cells
-- stay between minWidth and 1.3x minWidth wide; the height stays as built.
function Elements.fitGrid(layout, areaWidth, minWidth)
    local gap = layout.CellPadding.X.Offset
    local usable = areaWidth - 14 -- the grid's left and right padding
    local columns = math.max(1, math.floor((usable + gap) / (minWidth + gap)))
    local cell = math.min(math.floor(minWidth * 1.3), math.floor((usable - gap * (columns - 1)) / columns))
    layout.CellSize = UDim2.fromOffset(cell, layout.CellSize.Y.Offset)
    return columns
end
-- A card for content inside panels: white with a quiet tan border (no sibling shadow, so it
-- is safe inside list layouts).
function Elements.card(parent, name, position, size, radius)
    local card = Elements.box(parent, name, position, size, Theme.Card, radius or 16)
    Elements.stroke(card, Theme.Tan, 2, 0)
    return card
end
return Elements
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00053">
            <Properties>
              <string name="Name">GachaView</string>
              <ProtectedString name="Source">-- Gacha machine: the last pull (live portrait, rarity tag, bonus), a pity progress bar, the
-- SPIN button, and every pet in the machine as a tile with its own chance. Two columns on
-- wide screens, stacked on narrow ones. The server rolls; this view only displays and requests.
-- Machines are physical stands in the player's restaurant: the panel opens for a machine when
-- the server reports the player at its stand, and closes when they walk away. The SPIN menu
-- button asks the server to move the player to their best machine.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local PetConfig = require(Shared.config.Pets)
local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local PetText = require(script.Parent.PetText)
local PetPortrait = require(script.Parent.PetPortrait)
local GachaView = {}
GachaView.__index = GachaView
GachaView.Accent = Theme.Green
local MinWidth, MaxWidth, MinHeight, MaxHeight, NarrowMaxHeight = 340, 680, 440, 540, 680
local WideAt, LeftWidth = 560, 240
local PoolTileWidth, PoolTileHeight = 88, 112
function GachaView.new(gui, send)
    local self = setmetatable({ send = send, hasStation = false, canSpin = false, poolTiles = {} }, GachaView)
    self.button = E.menuButton(gui, "SpinButton", "SPIN", "spin", GachaView.Accent, function() self:visit() end)
    local frame = E.panel(gui, "GachaPanel", MaxWidth, MaxHeight, Theme.Green)
    self.panel, self.scale, self.close, self.title, self.caption = frame.panel, frame.scale, frame.close, frame.title, frame.caption
    self.title.Text = "STARTER FRYER"
    self.close.Activated:Connect(function() self:setOpen(false) end)
    local panel = self.panel

    -- The last pull.
    self.result = E.card(panel, "Result", UDim2.fromOffset(16, E.PanelTop + 12), UDim2.fromOffset(LeftWidth, 196), 18)
    self.portrait = PetPortrait.make(self.result, "Portrait", UDim2.fromOffset(110, 110))
    self.mystery = E.label(self.result, "?", 110, Theme.Tan)
    self.mystery.Name, self.mystery.Font, self.mystery.TextSize = "Mystery", Theme.Display, 72
    self.mystery.TextXAlignment = Enum.TextXAlignment.Center
    self.tag = E.label(self.result, "", 22, Theme.OnColor)
    self.tag.Name, self.tag.Font, self.tag.TextSize = "Tag", Theme.Display, 13
    self.tag.TextXAlignment, self.tag.BackgroundTransparency, self.tag.Visible = Enum.TextXAlignment.Center, 0, false
    E.corner(self.tag, 11)
    self.resultName = E.label(self.result, "Spin to get a Fry Buddy!", 26, Theme.Ink)
    self.resultName.Name, self.resultName.Font, self.resultName.TextSize = "PetName", Theme.Display, 18
    E.fit(self.resultName, 9, 18)
    self.resultBonus = E.label(self.result, "Pets you win appear in PETS.", 18, Theme.Muted)
    self.resultBonus.Name, self.resultBonus.TextSize = "Bonus", 12
    E.fit(self.resultBonus, 7, 12)

    -- Pity progress, count, and the SPIN button.
    self.pity = Instance.new("Frame")
    self.pity.Name, self.pity.BackgroundTransparency, self.pity.Parent = "Pity", 1, panel
    self.pityText = E.label(self.pity, "", 16, Theme.Gem)
    self.pityText.Name, self.pityText.Font, self.pityText.TextSize = "PityText", Theme.Display, 12
    self.pityText.Size = UDim2.new(1, 0, 0, 16)
    E.fit(self.pityText, 7, 12)
    local track
    track, self.pityFill = E.bar(self.pity, Theme.Gem, 10)
    track.Name, track.Position, track.Size = "Progress", UDim2.fromOffset(0, 20), UDim2.new(1, 0, 0, 10)
    self.count = E.label(panel, "", 16, Theme.Muted)
    self.count.Name, self.count.TextSize = "Count", 12
    self.spin = E.button(panel, "SPIN", function() self:spinOnce() end, Theme.Green, 5)
    self.spin.Name, self.spin.AutoButtonColor, self.spin.TextColor3, self.spin.TextSize = "Spin", false, Theme.OnColor, 22
    self.spinOutline = E.textStroke(self.spin, Theme.Ink, 2)

    -- Every pet in the machine.
    self.poolLabel = E.label(panel, "IN THIS MACHINE", 20, Theme.Ink)
    self.poolLabel.Name, self.poolLabel.Font, self.poolLabel.TextSize = "PoolLabel", Theme.Display, 15
    self.poolArea = E.box(panel, "PoolArea", UDim2.new(), UDim2.new(), Theme.Cream, 0)
    self.pool, self.poolLayout = E.grid(self.poolArea, "Pool", PoolTileWidth, PoolTileHeight, 8)
    self.wide = nil
    return self
end
function GachaView:setOpen(open) self.panel.Visible = open and self.hasStation and self.machineId ~= nil end
function GachaView:toggle() if self.hasStation then self:setOpen(not self.panel.Visible) end end
-- SPIN in the menu walks the player to their best machine (the server moves them).
function GachaView:visit() if self.hasStation then self.send("VisitMachine") end end
function GachaView:spinOnce()
    if self.canSpin and self.panel.Visible and self.machineId then self.send("Spin", self.machineId) end
end
-- Header, checker strip, and SPIN button follow the machine's theme colour.
function GachaView:setAccent(color)
    self.accent = color
    local header = self.panel:FindFirstChild("Header")
    if header then
        header.BackgroundColor3 = color
        local square = header:FindFirstChild("Square")
        if square then square.BackgroundColor3 = color end
    end
    local checker = self.panel:FindFirstChild("Checker")
    for _, cell in ipairs(if checker then checker:GetChildren() else {}) do cell.BackgroundColor3 = color end
end
-- Shows a different machine: new title, colour, pool tiles, and a fresh result card.
function GachaView:showMachine(machine)
    self.machineId = machine.id
    self:setAccent(Theme[machine.accent or "Green"] or Theme.Green)
    self.title.Text = string.upper(machine.name)
    for _, tile in pairs(self.poolTiles) do tile:Destroy() end
    self.poolTiles = {}
    local order = 0
    for _, row in ipairs(machine.odds) do
        for _, petType in ipairs(row.types or {}) do
            order += 1
            self.poolTiles[petType] = self:poolTile(petType, row.rarity, row.chance * 100 / #row.types, order)
        end
    end
    self.mystery.Visible, self.tag.Visible = true, false
    PetPortrait.set(self.portrait, nil)
    self.resultName.Text, self.resultName.TextColor3 = "Spin to get a Fry Buddy!", Theme.Ink
    self.resultBonus.Text = "Pets you win appear in PETS."
end
-- One tile per pet in the machine, with that pet's own chance.
function GachaView:poolTile(petType, rarity, chance, order)
    local color = PetText.color(rarity)
    local tile = E.box(self.pool, petType, UDim2.new(), UDim2.new(), Theme.Card, 14)
    tile.LayoutOrder = order
    E.stroke(tile, color, 3, 0)
    E.box(tile, "Band", UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 8), color, 8)
    PetPortrait.set(PetPortrait.make(tile, "Portrait", UDim2.fromOffset(60, 60), UDim2.new(0.5, -30, 0, 10)), petType, false)
    local name = E.label(tile, PetConfig.Types[petType].Name, 16, Theme.Ink)
    name.Name, name.Position, name.Size = "PetName", UDim2.new(0, 4, 0, 72), UDim2.new(1, -8, 0, 16)
    name.Font, name.TextSize, name.TextXAlignment = Theme.Display, 12, Enum.TextXAlignment.Center
    E.fit(name, 7, 12)
    local odds = E.label(tile, E.number(chance) .. "%", 18, color)
    odds.Name, odds.Position, odds.Size = "Chance", UDim2.new(0, 4, 0, 90), UDim2.new(1, -8, 0, 18)
    odds.Font, odds.TextSize, odds.TextXAlignment = Theme.Display, 14, Enum.TextXAlignment.Center
    return tile
end
function GachaView:showResult(pet, rarity, autoDeleted)
    local color = PetText.color(rarity)
    PetPortrait.set(self.portrait, pet.type, pet.golden)
    self.mystery.Visible = false
    self.tag.Visible = true
    self.tag.Text = if autoDeleted then "AUTO-DELETED" else string.upper(rarity) .. "!"
    self.tag.BackgroundColor3 = if autoDeleted then Theme.Muted else color
    self.resultName.Text = if autoDeleted then "Auto-deleted " .. pet.name else "You got " .. pet.name .. "!"
    self.resultName.TextColor3 = if autoDeleted then Theme.Muted else color
    self.resultBonus.Text = if autoDeleted then "Turn auto-delete off in PETS to keep these." else PetText.bonus(pet.bonuses)
end
function GachaView:update(state)
    self.hasStation = state.hasStation
    E.setMenuEnabled(self.button, state.hasStation, GachaView.Accent)
    if not state.hasStation then self.panel.Visible = false end
    local pets, machines = state.pets, state.machines
    if not machines or not pets then return end
    -- Open at a stand, close on walking away (only if the stand opened it).
    local near = state.hasStation and state.nearMachine or nil
    if near ~= self.nearId then
        self.nearId = near
        if near and machines[near] then
            if self.machineId ~= near then self:showMachine(machines[near]) end
            self.panel.Visible = true
            self.focusRequested = true -- AppView closes the other panels
        elseif self.panel.Visible then
            self.panel.Visible = false
        end
    end
    local machine = self.machineId and machines[self.machineId]
    if not machine then return end
    local left = machine.pityEvery - machine.pity
    self.caption.Text = if machine.unlocked then E.money(machine.price) .. " per spin  ·  " .. machine.pityRarity
        .. " or better within " .. left .. (if left == 1 then " spin" else " spins")
        else "Locked  ·  expand your restaurant to use this machine"
    self.pityText.Text = string.upper(machine.pityRarity) .. "+ GUARANTEED IN " .. left .. (if left == 1 then " SPIN" else " SPINS")
    self.pityFill.Size = UDim2.fromScale(math.clamp(machine.pity / machine.pityEvery, 0, 1), 1)
    if not next(self.poolTiles) then
        local order = 0
        for _, row in ipairs(machine.odds) do
            for _, petType in ipairs(row.types or {}) do
                order += 1
                self.poolTiles[petType] = self:poolTile(petType, row.rarity, row.chance * 100 / #row.types, order)
            end
        end
    end
    local full = #pets.owned &gt;= pets.max
    local affordable = state.profile.cash &gt;= machine.price
    local here = state.nearMachine == machine.id
    self.canSpin = state.hasStation and here and machine.unlocked and affordable and not full
    self.count.Text = "PETS " .. #pets.owned .. " / " .. pets.max .. (if full then "  ·  inventory full" else "")
    self.spin.Active, self.spin.Selectable = self.canSpin, self.canSpin
    self.spin.Text = if not machine.unlocked then "LOCKED" elseif full then "INVENTORY FULL"
        elseif not here then "WALK TO THE STAND" elseif affordable then "SPIN  " .. E.money(machine.price) else "NEED " .. E.money(machine.price)
    self.spin.BackgroundColor3 = if self.canSpin then Theme.Green else Theme.Disabled
    self.spin.TextColor3 = if self.canSpin then Theme.OnColor else Theme.Muted
    self.spinOutline.Enabled = self.canSpin
    -- A new spin result shows the pet large in its rarity colour.
    local spin = state.spin
    if spin and spin.serial ~= self.lastSerial then
        self.lastSerial = spin.serial
        if spin.autoDeleted then
            local kind = PetConfig.Types[spin.type]
            self:showResult({ type = spin.type, name = kind.Name, golden = false, bonuses = {} }, kind.Rarity, true)
        else
            for _, owned in ipairs(pets.owned) do
                if owned.id == spin.id then self:showResult(owned, owned.rarity, false) end
            end
        end
    end
end
-- Two columns on wide panels, stacked on narrow ones; the panel grows with the screen.
function GachaView:resize(viewport)
    local availableWidth, availableHeight = viewport.X - 32, viewport.Y - 60 - 24
    local width = math.clamp(availableWidth, MinWidth, MaxWidth)
    local wide = width &gt;= WideAt
    -- Stacked (phone portrait) panels may grow taller so more of the pool shows.
    local height = math.clamp(availableHeight, MinHeight, if wide then MaxHeight else NarrowMaxHeight)
    self.panel.Size = UDim2.fromOffset(width, height)
    self.scale.Scale = math.min(1, availableWidth / width, availableHeight / height)
    local top = E.PanelTop + 12
    local spinTop = height - 74
    if wide then
        self.result.Position, self.result.Size = UDim2.fromOffset(16, top), UDim2.fromOffset(LeftWidth, 196)
        self.portrait.Position, self.portrait.Size = UDim2.new(0.5, -55, 0, 8), UDim2.fromOffset(110, 110)
        self.mystery.Position, self.mystery.Size = UDim2.new(0.5, -55, 0, 8), UDim2.fromOffset(110, 110)
        self.tag.Position, self.tag.Size = UDim2.new(0.5, -60, 0, 114), UDim2.fromOffset(120, 22)
        self.resultName.Position, self.resultName.Size = UDim2.fromOffset(10, 140), UDim2.new(1, -20, 0, 26)
        self.resultName.TextXAlignment = Enum.TextXAlignment.Center
        self.resultBonus.Position, self.resultBonus.Size = UDim2.fromOffset(10, 168), UDim2.new(1, -20, 0, 18)
        self.resultBonus.TextXAlignment = Enum.TextXAlignment.Center
        self.pity.Position, self.pity.Size = UDim2.fromOffset(16, top + 210), UDim2.fromOffset(LeftWidth, 32)
        self.count.Position, self.count.Size = UDim2.fromOffset(16, spinTop - 24), UDim2.fromOffset(LeftWidth, 16)
        self.spin.Position, self.spin.Size = UDim2.fromOffset(16, spinTop), UDim2.fromOffset(LeftWidth, 54)
        self.poolLabel.Position, self.poolLabel.Size = UDim2.fromOffset(LeftWidth + 34, top - 2), UDim2.fromOffset(width - LeftWidth - 50, 20)
        self.poolArea.Position = UDim2.fromOffset(LeftWidth + 28, top + 22)
        self.poolArea.Size = UDim2.fromOffset(width - LeftWidth - 40, height - top - 22 - 14)
    else
        self.result.Position, self.result.Size = UDim2.fromOffset(16, top), UDim2.new(1, -32, 0, 104)
        self.portrait.Position, self.portrait.Size = UDim2.fromOffset(6, 6), UDim2.fromOffset(92, 92)
        self.mystery.Position, self.mystery.Size = UDim2.fromOffset(6, 6), UDim2.fromOffset(92, 92)
        self.tag.Position, self.tag.Size = UDim2.fromOffset(106, 12), UDim2.fromOffset(120, 22)
        self.resultName.Position, self.resultName.Size = UDim2.fromOffset(106, 40), UDim2.new(1, -116, 0, 26)
        self.resultName.TextXAlignment = Enum.TextXAlignment.Left
        self.resultBonus.Position, self.resultBonus.Size = UDim2.fromOffset(106, 70), UDim2.new(1, -116, 0, 18)
        self.resultBonus.TextXAlignment = Enum.TextXAlignment.Left
        self.poolLabel.Position, self.poolLabel.Size = UDim2.fromOffset(20, top + 114), UDim2.new(1, -40, 0, 20)
        self.poolArea.Position = UDim2.fromOffset(12, top + 136)
        self.poolArea.Size = UDim2.new(1, -24, 0, math.max(60, spinTop - 70 - (top + 136)))
        self.pity.Position, self.pity.Size = UDim2.fromOffset(16, spinTop - 64), UDim2.new(1, -32, 0, 32)
        self.count.Position, self.count.Size = UDim2.fromOffset(16, spinTop - 24), UDim2.new(1, -32, 0, 16)
        self.spin.Position, self.spin.Size = UDim2.fromOffset(16, spinTop), UDim2.new(1, -37, 0, 54)
    end
    E.fitGrid(self.poolLayout, if wide then width - LeftWidth - 40 else width - 24, PoolTileWidth)
    self.wide = wide
end
return GachaView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00054">
            <Properties>
              <string name="Name">HudView</string>
              <ProtectedString name="Source">-- Pack and Sell: two big Diner Sticker buttons at the bottom centre.
local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local Icons = require(script.Parent.Icons)
local HudView = {}
HudView.__index = HudView
-- Two 232 x 104 buttons, a 14 px gap, and the 7 px sticker shadow. Wide enough that
-- Luckiest Guy titles such as "CLAIM FIRST" fit with room to spare.
local ButtonWidth, ButtonHeight, Shadow, Gap = 232, 104, 7, 14
HudView.Width, HudView.Height = ButtonWidth * 2 + Gap + Shadow, ButtonHeight + Shadow + 1
local TextLeft, TextWidth = 72, ButtonWidth - 72 - 16
local function action(parent, name, x, color, key, icon, callback)
    local button = E.button(parent, "", callback, color, 0)
    button.Name, button.Position, button.Size = name, UDim2.fromOffset(x, 0), UDim2.fromOffset(ButtonWidth, ButtonHeight)
    button.AutoButtonColor = false
    button:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, 26)
    E.stroke(button, Theme.White, 5, 0)
    E.shadow(button, Shadow)
    local disc = E.box(button, "IconDisc", UDim2.fromOffset(12, 26), UDim2.fromOffset(50, 50), Theme.Cream, 25)
    Icons.make(disc, icon, 36, Theme.Ink, UDim2.fromOffset(7, 7))
    local title = E.label(button, "", 36, Theme.Ink)
    title.Name, title.Position, title.Size = "Title", UDim2.fromOffset(TextLeft, 20), UDim2.fromOffset(TextWidth, 34)
    title.Font, title.TextSize = Theme.Display, 23
    E.fit(title, 10, 23)
    local outline = E.textStroke(title, Theme.Ink, 2)
    outline.Enabled = false
    local detail = E.label(button, "", 18, Theme.Ink)
    detail.Name, detail.Position, detail.Size, detail.TextSize = "Detail", UDim2.fromOffset(TextLeft, 58), UDim2.fromOffset(TextWidth, 18), 12
    E.fit(detail, 8, 12)
    local shortcut = E.label(button, key, 18, Theme.Ink)
    shortcut.Name, shortcut.Position, shortcut.Size, shortcut.TextSize = "Key", UDim2.fromOffset(ButtonWidth - 26, 4), UDim2.fromOffset(18, 16), 11
    shortcut.TextXAlignment, shortcut.Font = Enum.TextXAlignment.Center, Theme.Display
    return button, title, detail, shortcut, outline
end
function HudView.new(parent, send)
    local self = setmetatable({ send = send, hovered = false }, HudView)
    local frame = Instance.new("Frame")
    frame.Name, frame.AnchorPoint = "Actions", Vector2.new(0.5, 1)
    frame.Position, frame.Size = UDim2.new(0.5, 0, 1, -22), UDim2.fromOffset(HudView.Width, HudView.Height)
    frame.BackgroundTransparency, frame.Parent = 1, parent
    self.frame = frame
    self.scale = Instance.new("UIScale")
    self.scale.Parent = frame
    self.pack, self.packTitle, self.packDetail, self.packKey = action(frame, "Click", 0, Theme.Gold, "F", "fries", nil)
    self.sell, self.sellTitle, self.sellDetail, self.sellKey, self.sellOutline =
        action(frame, "Sell", ButtonWidth + Gap, Theme.Cream, "R", "bag", function() self:sellBag() end)
    local track
    track, self.fill = E.bar(self.sell, Theme.Gold, 8)
    track.Name, track.Position, track.Size = "Progress", UDim2.fromOffset(TextLeft, 82), UDim2.fromOffset(TextWidth - 4, 8)
    local function hover(on)
        self.hovered = on
        if self.state then self:update(self.state) end
    end
    self.pack.MouseEnter:Connect(function() hover(true) end)
    self.pack.MouseLeave:Connect(function() hover(false) end)
    self.pack.SelectionGained:Connect(function() hover(true) end)
    self.pack.SelectionLost:Connect(function() hover(false) end)
    self.packTitle.Text, self.packDetail.Text = "LOADING", "YOUR RESTAURANT"
    self.sellTitle.Text, self.sellDetail.Text = "0 / 20", "FRIES IN BAG"
    self.pack.Active, self.sell.Active = false, false
    self.pack.Selectable, self.sell.Selectable = false, false
    return self
end
function HudView:sellBag()
    local state = self.state
    if state and state.hasStation and state.nearStation and state.profile.bag.fries &gt;= state.stats.capacity then self.send("Sell") end
end
function HudView:update(state)
    self.state = state
    local bag = state.profile.bag
    local capacity = state.stats.capacity
    local full = bag.fries &gt;= capacity
    local canPack = state.hasStation and state.nearStation and not full
    local canSell = state.hasStation and state.nearStation and full
    local perClick = state.stats.perClick
    local yieldText = "+" .. E.number(perClick) .. (if perClick == 1 then " fry/click" else " fries/click")
    self.pack.Active, self.pack.Selectable = canPack, canPack
    self.sell.Active, self.sell.Selectable = canSell, canSell
    self.pack.BackgroundColor3 = if not canPack then Theme.Disabled elseif self.hovered then Theme.GoldLight else Theme.Gold
    self.packTitle.Text = if not state.hasStation then "CLAIM FIRST" elseif full then "BAG FULL"
        elseif not state.nearStation then "AT COUNTER" elseif self.hovered then "CLICK" else yieldText
    self.packDetail.Text = if not state.hasStation then "CLAIM AT THE ENTRANCE" elseif full then "SELL TO KEEP PACKING"
        elseif not state.nearStation then "RETURN TO COUNTER" elseif self.hovered then string.upper(yieldText) else "TAP / HOLD TO PACK"
    self.sellTitle.Text = if full then "SELL BAG" else math.floor(bag.fries) .. " / " .. capacity
    self.sellDetail.Text = if not state.hasStation then "CLAIM A RESTAURANT"
        elseif full and not state.nearStation then "RETURN TO COUNTER"
        elseif full then "+" .. E.money(state.stats.saleValue) .. " CASH"
        else "FRIES IN BAG"
    -- Ready to sell: teal with white outlined text; otherwise cream with ink text.
    self.sell.BackgroundColor3 = if canSell then Theme.Green else Theme.Cream
    self.sellTitle.TextColor3 = if canSell then Theme.OnColor else Theme.Ink
    self.sellOutline.Enabled = canSell
    self.sellDetail.TextColor3 = if canSell then Theme.OnColor else Theme.Muted
    self.sellKey.TextColor3 = if canSell then Theme.OnColor else Theme.Muted
    self.fill.Parent.Visible = not full
    self.fill.BackgroundColor3 = Theme.Gold
    self.fill.Size = UDim2.fromScale(math.clamp(bag.fries / capacity, 0, 1), 1)
end
return HudView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00055">
            <Properties>
              <string name="Name">Icons</string>
              <ProtectedString name="Source">-- Icons: an uploaded image when shared/config/Icons has an asset ID, otherwise a simple
-- code-built fallback drawn in the same square. Drawings use scale units, so any size works.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Ids = require(Shared.config.Icons)
local Theme = require(script.Parent.Theme)
local Icons = {}
local function piece(parent, name, x, y, w, h, color, round, rotation)
    local frame = Instance.new("Frame")
    frame.Name, frame.BorderSizePixel = name, 0
    frame.Position, frame.Size = UDim2.fromScale(x, y), UDim2.fromScale(w, h)
    frame.BackgroundColor3, frame.Rotation = color, rotation or 0
    if round then
        local corner = Instance.new("UICorner")
        corner.CornerRadius, corner.Parent = if round == true then UDim.new(0.5, 0) else UDim.new(round, 0), frame
    end
    frame.Parent = parent
    return frame
end
local function ring(parent, name, x, y, w, h, color, thickness)
    local frame = piece(parent, name, x, y, w, h, color, true)
    frame.BackgroundTransparency = 1
    local stroke = Instance.new("UIStroke")
    stroke.Color, stroke.Thickness, stroke.Parent = color, thickness, frame
    return frame
end
local function glyph(parent, text, color)
    local label = Instance.new("TextLabel")
    label.Name, label.Text, label.TextColor3, label.Font = "Glyph", text, color, Theme.Display
    label.BackgroundTransparency, label.Size, label.TextScaled = 1, UDim2.fromScale(1, 1), true
    label.TextSize = 100
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.Parent = parent
    return label
end
-- Fallback drawings. `tint` is the main line colour (white on colour, ink on cream).
local Draw = {}
function Draw.cash(holder)
    piece(holder, "Coin", 0.05, 0.05, 0.9, 0.9, Theme.Gold, true)
    local mark = piece(holder, "Mark", 0.2, 0.18, 0.6, 0.64, Theme.Gold, true)
    mark.BackgroundTransparency = 1
    glyph(mark, "$", Theme.Ink)
end
function Draw.gem(holder)
    piece(holder, "Stone", 0.2, 0.2, 0.6, 0.6, Theme.Gem, 0.12, 45)
    piece(holder, "Shine", 0.36, 0.3, 0.2, 0.2, Theme.GemLight, 0.2, 45)
end
function Draw.fries(holder)
    for index, x in ipairs({ 0.27, 0.44, 0.61 }) do
        piece(holder, "Fry" .. index, x, 0.08 + (index % 2) * 0.06, 0.12, 0.5, Theme.GoldLight, 0.3)
    end
    piece(holder, "Box", 0.18, 0.46, 0.64, 0.46, Theme.Red, 0.18)
end
function Draw.bag(holder, tint)
    ring(holder, "Handle", 0.33, 0.08, 0.34, 0.34, tint, 3)
    piece(holder, "Body", 0.18, 0.3, 0.64, 0.62, Theme.Tan, 0.16)
    piece(holder, "Band", 0.18, 0.5, 0.64, 0.1, Theme.Red, 0)
end
function Draw.upgrades(holder, tint)
    piece(holder, "Head", 0.24, 0.1, 0.52, 0.52, tint, 0.1, 45)
    piece(holder, "Shaft", 0.38, 0.38, 0.24, 0.52, tint, 0.2)
end
function Draw.rebirth(holder, tint)
    ring(holder, "Loop", 0.16, 0.16, 0.68, 0.68, tint, 4)
    piece(holder, "Tip", 0.6, 0.06, 0.26, 0.26, tint, 0.1, 45)
end
function Draw.spin(holder, tint)
    piece(holder, "Egg", 0.24, 0.08, 0.52, 0.84, tint, 0.48)
    piece(holder, "Band", 0.24, 0.48, 0.52, 0.12, Theme.Gold, 0)
end
function Draw.pets(holder, tint)
    piece(holder, "Pad", 0.26, 0.46, 0.48, 0.42, tint, true)
    for index, spot in ipairs({ { 0.14, 0.26 }, { 0.32, 0.08 }, { 0.54, 0.08 }, { 0.72, 0.26 } }) do
        piece(holder, "Toe" .. index, spot[1], spot[2], 0.16, 0.2, tint, true)
    end
end
function Draw.settings(holder, tint)
    for index = 0, 3 do
        piece(holder, "Tooth" .. index, 0.42, 0.06, 0.16, 0.88, tint, 0.2, index * 45)
    end
    piece(holder, "Ring", 0.2, 0.2, 0.6, 0.6, tint, true)
    piece(holder, "Hole", 0.38, 0.38, 0.24, 0.24, Theme.Cream, true)
end
function Draw.home(holder, tint)
    piece(holder, "Roof", 0.2, 0.1, 0.6, 0.6, tint, 0.08, 45)
    piece(holder, "Walls", 0.24, 0.44, 0.52, 0.46, tint, 0.08)
    piece(holder, "Door", 0.42, 0.62, 0.16, 0.28, Theme.Red, 0.2)
end
function Draw.close(holder, tint)
    piece(holder, "BarA", 0.42, 0.1, 0.16, 0.8, tint, 0.4, 45)
    piece(holder, "BarB", 0.42, 0.1, 0.16, 0.8, tint, 0.4, -45)
end
function Draw.check(holder, tint)
    piece(holder, "Short", 0.24, 0.42, 0.14, 0.34, tint, 0.4, -45)
    piece(holder, "Long", 0.52, 0.16, 0.14, 0.66, tint, 0.4, 40)
end
function Draw.sparkle(holder)
    piece(holder, "Tall", 0.4, 0.06, 0.2, 0.88, Theme.Gold, 0.5, 0)
    piece(holder, "Wide", 0.06, 0.4, 0.88, 0.2, Theme.Gold, 0.5, 0)
    piece(holder, "Core", 0.3, 0.3, 0.4, 0.4, Theme.GoldLight, 0.1, 45)
end
function Draw.star(holder)
    piece(holder, "A", 0.2, 0.2, 0.6, 0.6, Theme.Gold, 0.1, 0)
    piece(holder, "B", 0.2, 0.2, 0.6, 0.6, Theme.Gold, 0.1, 45)
end
Draw["upgrade-fries-per-click"] = Draw.fries
Draw["upgrade-money-per-fry"] = Draw.cash
Draw["upgrade-bag-capacity"] = Draw.bag
Icons.Draw = Draw
function Icons.hasImage(name) return type(Ids[name]) == "string" and Ids[name] ~= "" end
-- Returns a square holder named "Icon" containing either the uploaded image or a fallback.
function Icons.make(parent, name, size, tint, position)
    local holder = Instance.new("Frame")
    holder.Name, holder.BackgroundTransparency = "Icon", 1
    holder.Size, holder.Position = UDim2.fromOffset(size, size), position or UDim2.new()
    holder:SetAttribute("Icon", name)
    if Icons.hasImage(name) then
        local image = Instance.new("ImageLabel")
        image.Name, image.Image, image.BackgroundTransparency = "Image", Ids[name], 1
        image.Size, image.ScaleType = UDim2.fromScale(1, 1), Enum.ScaleType.Fit
        image.Parent = holder
    else
        assert(Draw[name], "Unknown icon " .. tostring(name))
        Draw[name](holder, tint or Theme.Ink)
    end
    holder.Parent = parent
    return holder
end
return Icons
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00056">
            <Properties>
              <string name="Name">PetFollower</string>
              <ProtectedString name="Source">-- Draws every player's equipped pets locally, following and bobbing behind their character.
-- Reads the server's public "FollowPets" player attribute; no network traffic per frame.
local Players = game:GetService("Players")
local PetModels = require(script.Parent.PetModels)
local PetFollower = {}
PetFollower.__index = PetFollower
-- Slots behind the character, in its local space (studs; -Z is forward).
local Slots = { Vector3.new(-3, -1.2, 3.5), Vector3.new(3, -1.2, 3.5), Vector3.new(0, -0.8, 6) }
local Follow = 8 -- higher catches up faster
function PetFollower.new(localPlayer)
    local folder = Instance.new("Folder")
    folder.Name, folder.Parent = "FollowingPets", workspace
    return setmetatable({ folder = folder, localPlayer = localPlayer, entries = {}, clock = 0, showOthers = true }, PetFollower)
end
function PetFollower:setShowOthers(show) self.showOthers = show ~= false end
function PetFollower:clear(player)
    local entry = self.entries[player]
    if entry then
        for _, pet in ipairs(entry.pets) do pet.model:Destroy() end
        self.entries[player] = nil
    end
end
local function parse(text)
    local list = {}
    for item in string.gmatch(text or "", "[^,]+") do
        local golden = string.sub(item, -1) == "*"
        table.insert(list, { type = if golden then string.sub(item, 1, -2) else item, golden = golden })
        if #list &gt;= #Slots then break end
    end
    return list
end
function PetFollower:step(dt)
    self.clock += math.max(dt or 0, 0)
    local alpha = math.min(1, math.max(dt or 0, 0) * Follow)
    local present = {}
    for _, player in ipairs(Players:GetPlayers()) do
        present[player] = true
        local text = player:GetAttribute("FollowPets") or ""
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local visible = text ~= "" and root ~= nil and humanoid ~= nil and humanoid.Health &gt; 0
            and (player == self.localPlayer or self.showOthers)
        local entry = self.entries[player]
        if not visible then
            self:clear(player)
        else
            if not entry or entry.text ~= text then
                self:clear(player)
                entry = { text = text, pets = {} }
                for _, pet in ipairs(parse(text)) do
                    local model, pieces = PetModels.build(pet.type, pet.golden, self.folder)
                    table.insert(entry.pets, { model = model, pieces = pieces })
                end
                self.entries[player] = entry
            end
            local frame = root.CFrame or CFrame.new(root.Position)
            local forward = frame:PointToWorldSpace(Vector3.new(0, 0, -1)) - root.Position
            for index, pet in ipairs(entry.pets) do
                local bob = math.sin(self.clock * 3 + index * 1.7) * 0.25
                local target = frame:PointToWorldSpace(Slots[index]) + Vector3.new(0, bob, 0)
                -- The first frame snaps into place; later frames ease towards the target.
                pet.position = if pet.position then pet.position + (target - pet.position) * alpha else target
                local base = CFrame.lookAt(pet.position, pet.position + forward)
                PetModels.place(pet.pieces, base)
            end
        end
    end
    for player in pairs(self.entries) do if not present[player] then self:clear(player) end end
end
return PetFollower
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00057">
            <Properties>
              <string name="Name">PetModels</string>
              <ProtectedString name="Source">-- Code-built cartoon pet models (no uploaded assets). Each pet is a short recipe of smooth
-- parts plus a shared face: white eyes with dark pupils and a shine, blush cheeks, and a smile.
-- Pets face -Z. Models are about 2 studs tall. Golden pets get a gold body, a slight shine,
-- and two sparkles. Used by the following pets and by the UI portraits.
local PetModels = {}
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
local Ink, White, Blush = rgb(45, 30, 30), rgb(255, 255, 255), rgb(255, 150, 160)
local Gold = rgb(255, 204, 64)
local Upright = CFrame.Angles(0, 0, math.pi / 2) -- turns a Cylinder (X axis) to stand on Y

-- Builder: collects parts with their local offsets.
local function builder(model, golden)
    local pieces = {}
    local b = {}
    function b.add(shape, size, position, color, options)
        options = options or {}
        local part = Instance.new("Part")
        part.Shape = if shape == "Ball" then Enum.PartType.Ball elseif shape == "Cylinder" then Enum.PartType.Cylinder else Enum.PartType.Block
        part.Size = Vector3.new(size[1], size[2], size[3])
        part.Color = color
        part.Transparency = options.transparency or 0
        part.Material = if options.neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
        part.Reflectance = if golden and options.body then 0.3 else 0
        part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
        part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = true, false, false, false, false
        part.Name = options.name or shape
        part.Parent = model
        local offset = CFrame.new(Vector3.new(position[1], position[2], position[3]))
        if options.upright then offset = offset * Upright end
        if options.rotation then offset = offset * options.rotation end
        table.insert(pieces, { part = part, offset = offset })
        return part
    end
    -- Body pieces turn gold on Golden pets.
    function b.body(shape, size, position, color, options)
        options = options or {}
        options.body, options.name = true, options.name or "Body"
        return b.add(shape, size, position, if golden then Gold else color, options)
    end
    -- Eyes, blush, and a smile on the front surface at depth z (negative), centred at height y.
    function b.face(z, y, spread, eyeSize)
        spread, eyeSize = spread or 0.24, eyeSize or 0.34
        for _, side in ipairs({ -1, 1 }) do
            local x = side * spread
            b.add("Ball", { eyeSize, eyeSize, eyeSize }, { x, y, z - 0.02 }, White, { name = "Eye" })
            b.add("Ball", { eyeSize * 0.62, eyeSize * 0.62, eyeSize * 0.62 }, { x, y - 0.02, z - eyeSize * 0.3 }, Ink, { name = "Pupil" })
            b.add("Ball", { eyeSize * 0.22, eyeSize * 0.22, eyeSize * 0.22 }, { x + 0.04, y + 0.06, z - eyeSize * 0.48 }, White, { name = "Shine" })
            b.add("Ball", { 0.18, 0.18, 0.18 }, { side * (spread + 0.2), y - 0.22, z - 0.02 }, Blush, { name = "Blush", transparency = 0.15 })
        end
        b.add("Block", { 0.18, 0.05, 0.05 }, { 0, y - 0.26, z - 0.03 }, Ink, { name = "Smile" })
    end
    function b.feet(y, spread, color)
        for _, side in ipairs({ -1, 1 }) do
            b.add("Ball", { 0.36, 0.36, 0.36 }, { side * (spread or 0.28), y, -0.05 }, color or Ink, { name = "Foot" })
        end
    end
    function b.sparkles()
        if not golden then return end
        b.add("Ball", { 0.16, 0.16, 0.16 }, { 0.75, 0.9, -0.2 }, rgb(255, 245, 190), { name = "Sparkle", neon = true })
        b.add("Ball", { 0.12, 0.12, 0.12 }, { -0.7, 0.3, -0.25 }, rgb(255, 245, 190), { name = "Sparkle", neon = true })
    end
    return b, pieces
end

local Recipes = {}
function Recipes.CrinkleFry(b)
    b.body("Block", { 0.8, 1.9, 0.8 }, { 0, 0.1, 0 }, rgb(255, 214, 90))
    for index, y in ipairs({ -0.5, 0.05, 0.6 }) do
        b.add("Block", { 0.84, 0.1, 0.84 }, { 0, y, 0 }, rgb(236, 176, 52), { name = "Crinkle" .. index })
    end
    b.add("Block", { 0.82, 0.22, 0.82 }, { 0, 1.0, 0 }, rgb(214, 140, 40), { name = "Toast" })
    b.face(-0.41, 0.35, 0.18, 0.28)
    b.feet(-0.92, 0.22, rgb(214, 140, 40))
end
