    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX00029">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX00030">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX00031">
        <Properties>
          <string name="Name">FriesClient</string>
        </Properties>
        <Item class="LocalScript" referent="RBX00032">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source">-- Client composition root. Cash and sales are determined by the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local AppView = require(script.Parent.ui.AppView)
local RestaurantMarkers = require(script.Parent.ui.RestaurantMarkers)
local InputController = require(script.Parent.controllers.InputController)
local remotes = ReplicatedStorage:WaitForChild("FriesRemotes")
local action = remotes:WaitForChild("Action")
local stateRemote = remotes:WaitForChild("State")
local noticeRemote = remotes:WaitForChild("Notice")
local state = nil
local function send(name, argument) action:FireServer(name, argument) end
local app = AppView.new(Players.LocalPlayer:WaitForChild("PlayerGui"), send)
local markers = RestaurantMarkers.new(Players.LocalPlayer.PlayerGui, Players.LocalPlayer.UserId)
stateRemote.OnClientEvent:Connect(function(snapshot)
    state = snapshot
    app:update(snapshot)
    markers:update(snapshot.hasStation)
end)
noticeRemote.OnClientEvent:Connect(function(text, success) app:notice(text, success) end)
InputController(app.hud, send, function() return state end)
RunService.RenderStepped:Connect(function(dt)
    markers.guides:step(Players.LocalPlayer.Character, dt)
    local camera = workspace.CurrentCamera
    if camera then app:resize(camera.ViewportSize) end
end)
task.spawn(function()
    while not state do
        send("Sync")
        task.wait(2)
    end
end)
</ProtectedString>
          </Properties>
        </Item>
        <Item class="Folder" referent="RBX00033">
          <Properties>
            <string name="Name">controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX00034">
            <Properties>
              <string name="Name">InputController</string>
              <ProtectedString name="Source">local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Economy = require(Shared.config.Economy)
-- Holding and tapping both use the same rate-limited Pack request on the server.
return function(hud, send, getState)
    local heldInput = nil
    local holdingKey = false
    local nextPack = 0
    local function pack()
        local state = getState()
        if not state or not state.hasStation or not state.nearStation or state.profile.bag.fries &gt;= Economy.Capacity then return end
        local now = os.clock()
        if now &lt; nextPack then return end
        nextPack = now + 1 / Economy.ClicksPerSecond + 0.02
        send("Pack")
    end
    hud.pack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            heldInput = input
            pack()
        end
    end)
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or UserInputService:GetFocusedTextBox() then return end
        if input.KeyCode == Enum.KeyCode.F then holdingKey = true; pack()
        elseif input.KeyCode == Enum.KeyCode.R then hud:sellBag()
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input == heldInput or input.UserInputType == Enum.UserInputType.MouseButton1 then heldInput = nil end
        if input.KeyCode == Enum.KeyCode.F then holdingKey = false end
    end)
    UserInputService.WindowFocusReleased:Connect(function() heldInput = nil; holdingKey = false end)
    RunService.RenderStepped:Connect(function()
        if heldInput and not hud.frame.Visible then heldInput = nil end
        if heldInput or holdingKey then pack() end
    end)
end
</ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="RBX00035">
          <Properties>
            <string name="Name">ui</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX00036">
            <Properties>
              <string name="Name">AppView</string>
              <ProtectedString name="Source">local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local HudView = require(script.Parent.HudView)
local AppView = {}
AppView.__index = AppView
function AppView.new(playerGui, send)
    local self = setmetatable({}, AppView)
    local gui = Instance.new("ScreenGui")
    gui.Name, gui.ResetOnSpawn, gui.ZIndexBehavior = "FriesInterface", false, Enum.ZIndexBehavior.Sibling
    gui.Parent = playerGui
    self.cashCard = E.box(gui, "CashCard", UDim2.fromOffset(16, 16), UDim2.fromOffset(218, 76), Theme.Background, 18)
    self.cashCard.AnchorPoint = Vector2.new(0, 0.5)
    E.stroke(self.cashCard, Theme.Gold, 2, 0.12)
    local coin = E.box(self.cashCard, "Coin", UDim2.fromOffset(12, 17), UDim2.fromOffset(42, 42), Theme.Gold, 21)
    local symbol = E.label(coin, "$", 42, Theme.Ink)
    symbol.Size, symbol.TextSize, symbol.Font = UDim2.fromScale(1, 1), 29, Enum.Font.GothamBold
    symbol.TextXAlignment = Enum.TextXAlignment.Center
    local caption = E.label(self.cashCard, "CASH", 18, Theme.Muted)
    caption.Position, caption.Size, caption.TextSize = UDim2.fromOffset(65, 10), UDim2.fromOffset(140, 18), 11
    self.wallet = E.label(self.cashCard, "$0", 36, Theme.Text)
    self.wallet.Name, self.wallet.Position, self.wallet.Size = "Cash", UDim2.fromOffset(65, 29), UDim2.fromOffset(142, 36)
    self.wallet.Font, self.wallet.TextSize, self.wallet.TextWrapped = Enum.Font.GothamBold, 27, false
    self.wallet.TextScaled = true
    local cashTextSize = Instance.new("UITextSizeConstraint")
    cashTextSize.MinTextSize, cashTextSize.MaxTextSize, cashTextSize.Parent = 10, 27, self.wallet
    self.mode = E.label(gui, "", 20, Theme.Text)
    self.mode.Position, self.mode.Size, self.mode.TextSize = UDim2.fromOffset(16, 8), UDim2.fromOffset(220, 20), 10
    self.teleport = E.button(gui, "RETURN TO COUNTER", function()
        if self.hasStation then send("Return") end
    end, Theme.Background)
    self.teleport.TextColor3 = Theme.Text
    self.teleport.Name, self.teleport.AnchorPoint = "Teleport", Vector2.new(0.5, 0)
    self.teleport.Size, self.teleport.TextSize = UDim2.fromOffset(212, 44), 12
    E.stroke(self.teleport, Theme.Gold, 1.5, 0.3)
    self.guidance = E.label(gui, "", 44, Theme.Text)
    self.guidance.Name, self.guidance.AnchorPoint = "Guidance", Vector2.new(0.5, 0)
    self.guidance.TextXAlignment, self.guidance.TextSize = Enum.TextXAlignment.Center, 13
    self.guidance.BackgroundColor3, self.guidance.BackgroundTransparency = Theme.Background, 0.08
    E.corner(self.guidance, 12)
    self.hud = HudView.new(gui, send)
    self:resize(Vector2.new(1280, 720))
    return self
end
function AppView:update(state)
    self.hasStation = state.hasStation
    self.wallet.Text = E.money(state.profile.cash)
    self.wallet.TextSize = if #self.wallet.Text &gt; 12 then 14 elseif #self.wallet.Text &gt; 9 then 19 else 27
    self.mode.Text = if state.volatile then "STUDIO TEST / resets on stop" else ""
    self.teleport.Active, self.teleport.Selectable = state.hasStation, state.hasStation
    self.teleport.Text = if state.hasStation then "RETURN TO COUNTER" else "CHOOSE A RESTAURANT"
    self.teleport.AutoButtonColor = state.hasStation
    if not self.errorUntil or os.clock() &gt;= self.errorUntil then
        self.guidance.Visible = not state.hasStation
        self.guidance.Text = "Follow an AVAILABLE arrow. Press E or tap the entrance prompt to claim."
        self.guidance.TextColor3 = Theme.Text
    end
    self.hud:update(state)
end
function AppView:notice(text, success)
    -- Sales are acknowledged by the wallet and bag reset, without a bottom toast.
    if success then return end
    self.errorUntil = os.clock() + 4
    self.guidance.Visible, self.guidance.Text, self.guidance.TextColor3 = true, text, Theme.Red
end
function AppView:resize(viewport)
    if self.viewportX == viewport.X and self.viewportY == viewport.Y then return end
    self.viewportX, self.viewportY = viewport.X, viewport.Y
    local portrait = viewport.X &lt; 760 and viewport.Y &gt;= 500
    local compact = viewport.X &lt; 760 and not portrait
    local hudScale = math.min(1, (viewport.X - 24) / 392)
    local height = viewport.Y - 60
    local actionTop = height - 22 - 104 * hudScale
    -- Centre Cash on the left; lift it only when a short screen needs room for actions.
    local cashOffset = math.min(0, actionTop - 12 - 38 - height / 2)
    self.cashCard.Position = UDim2.new(0, 16, 0.5, cashOffset)
    self.cashCard.Size = UDim2.fromOffset(if compact then 172 else 218, 76)
    self.wallet.Size = UDim2.fromOffset(if compact then 105 else 142, 36)
    self.wallet.Position = UDim2.fromOffset(if compact then 58 else 65, 29)
    self.teleport.Position = UDim2.new(0.5, if compact then 22 else 0, 0, if portrait then 36 else 16)
    self.guidance.Position = UDim2.new(0.5, if compact then 22 else 0, 0, if portrait then 88 else 68)
    self.guidance.Size = UDim2.fromOffset(if compact then 230 else math.min(460, viewport.X - 32), 44)
    self.hud.scale.Scale = hudScale
end
return AppView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00037">
            <Properties>
              <string name="Name">Elements</string>
              <ProtectedString name="Source">local Theme = require(script.Parent.Theme)
local Elements = {}
function Elements.money(value)
    local grouped = string.reverse(string.format("%.0f", value)):gsub("(%d%d%d)", "%1,")
    local result = string.reverse(grouped):gsub("^,", "")
    return "$" .. result
end
function Elements.stroke(parent, color, thickness, transparency)
    local stroke = Instance.new("UIStroke")
    stroke.Color, stroke.Thickness, stroke.Transparency = color, thickness, transparency or 0
    stroke.ApplyStrokeMode, stroke.Parent = Enum.ApplyStrokeMode.Border, parent
    return stroke
end
function Elements.box(parent, name, position, size, color, radius)
    local frame = Instance.new("Frame")
    frame.Name, frame.Position, frame.Size = name, position, size
    frame.BackgroundColor3, frame.BorderSizePixel, frame.Parent = color, 0, parent
    Elements.corner(frame, radius)
    return frame
end
function Elements.corner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius, corner.Parent = UDim.new(0, radius or 10), parent
end
function Elements.label(parent, text, height, color)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, height or 42)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 15
    label.TextColor3 = color or Theme.Text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextWrapped = true
    label.Text = text
    label.Parent = parent
    return label
end
function Elements.button(parent, text, callback, color)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 43)
    button.BackgroundColor3 = color or Theme.Gold
    button.TextColor3 = Theme.Background
    button.Font = Enum.Font.GothamBold
    button.TextSize = 15
    button.TextWrapped = true
    button.Text = text
    button.BorderSizePixel = 0
    button.Parent = parent
    Elements.corner(button)
    if callback then button.Activated:Connect(callback) end
    return button
end
function Elements.column(parent, name)
    local frame = Instance.new("ScrollingFrame")
    frame.Name = name
    frame.Size = UDim2.fromScale(1, 1)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.ScrollBarThickness = 4
    frame.ScrollBarImageColor3 = Theme.Muted
    frame.CanvasSize = UDim2.new()
    frame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    frame.Parent = parent
    local padding = Instance.new("UIPadding")
    padding.PaddingRight = UDim.new(0, 9)
    padding.PaddingBottom = UDim.new(0, 12)
    padding.Parent = frame
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = frame
    return frame
end
function Elements.bar(parent, color, height)
    local outer = Instance.new("Frame")
    outer.Size = UDim2.new(1, 0, 0, height or 18)
    outer.BackgroundColor3 = Theme.Card
    outer.BorderSizePixel = 0
    outer.Parent = parent
    Elements.corner(outer, 5)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BackgroundColor3 = color or Theme.Gold
    fill.BorderSizePixel = 0
    fill.Parent = outer
    Elements.corner(fill, 5)
    return outer, fill
end
return Elements
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00038">
            <Properties>
              <string name="Name">HudView</string>
              <ProtectedString name="Source">local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Economy = require(Shared.config.Economy)
local Theme = require(script.Parent.Theme)
local E = require(script.Parent.Elements)
local HudView = {}
HudView.__index = HudView
local function action(parent, name, x, color, key, callback)
    local shadow = E.box(parent, name .. "Shadow", UDim2.fromOffset(x, 7), UDim2.fromOffset(190, 96), Theme.Shadow, 18)
    shadow.BackgroundTransparency = 0.18
    local button = E.button(parent, "", callback, color)
    button.Name, button.Position, button.Size = name, UDim2.fromOffset(x, 0), UDim2.fromOffset(190, 96)
    button.AutoButtonColor = false
    button:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0, 18)
    E.stroke(button, Theme.Text, 1.5, 0.65)
    local title = E.label(button, "", 34, Theme.Ink)
    title.Name, title.Position, title.Size = "Title", UDim2.fromOffset(48, 13), UDim2.fromOffset(136, 34)
    title.Font, title.TextSize = Enum.Font.GothamBold, 21
    local detail = E.label(button, "", 20, Theme.Ink)
    detail.Name, detail.Position, detail.Size, detail.TextSize = "Detail", UDim2.fromOffset(12, 50), UDim2.fromOffset(166, 20), 12
    local shortcut = E.label(button, key, 16, Theme.Ink)
    shortcut.Position, shortcut.Size, shortcut.TextSize = UDim2.fromOffset(168, 3), UDim2.fromOffset(18, 16), 10
    shortcut.TextXAlignment = Enum.TextXAlignment.Center
    return button, title, detail, shortcut
end
function HudView.new(parent, send)
    local self = setmetatable({ send = send, hovered = false }, HudView)
    local frame = Instance.new("Frame")
    frame.Name, frame.AnchorPoint = "Actions", Vector2.new(0.5, 1)
    frame.Position, frame.Size = UDim2.new(0.5, 0, 1, -22), UDim2.fromOffset(392, 104)
    frame.BackgroundTransparency, frame.Parent = 1, parent
    self.frame = frame
    self.scale = Instance.new("UIScale")
    self.scale.Parent = frame
    self.pack, self.packTitle, self.packDetail = action(frame, "Click", 0, Theme.Gold, "F", nil)
    self.sell, self.sellTitle, self.sellDetail, self.sellShortcut = action(frame, "Sell", 202, Theme.Card, "R", function() self:sellBag() end)
    -- Small code-built fry and bag symbols; no external texture assets.
    for n = 1, 3 do
        E.box(self.pack, "Fry" .. n, UDim2.fromOffset(14 + (n - 1) * 8, 15 - n % 2 * 3),
            UDim2.fromOffset(6, 27), Theme.Ink, 2)
    end
    E.box(self.sell, "BagIcon", UDim2.fromOffset(15, 18), UDim2.fromOffset(24, 28), Theme.Gold, 4)
    E.box(self.sell, "BagRim", UDim2.fromOffset(13, 16), UDim2.fromOffset(28, 5), Theme.GoldLight, 2)
    local track
    track, self.fill = E.bar(self.sell, Theme.Gold, 6)
    track.Position, track.Size, track.BackgroundColor3 = UDim2.fromOffset(12, 79), UDim2.fromOffset(166, 6), Theme.Background
    local hint = E.label(self.pack, "PACK FRIES", 14, Theme.Ink)
    hint.Position, hint.Size, hint.TextSize = UDim2.fromOffset(12, 76), UDim2.fromOffset(166, 14), 10
    local function hover(on)
        self.hovered = on
        if self.state then self:update(self.state) end
    end
    self.pack.MouseEnter:Connect(function() hover(true) end)
    self.pack.MouseLeave:Connect(function() hover(false) end)
    self.pack.SelectionGained:Connect(function() hover(true) end)
    self.pack.SelectionLost:Connect(function() hover(false) end)
    self.packTitle.Text, self.packDetail.Text = "LOADING", "YOUR RESTAURANT"
    self.sellTitle.Text, self.sellDetail.Text = "0 / 20", "FRIES IN BAG"
    self.sellTitle.TextColor3, self.sellDetail.TextColor3 = Theme.Text, Theme.Muted
    self.sellShortcut.TextColor3 = Theme.Muted
    self.pack.Active, self.sell.Active = false, false
    self.pack.Selectable, self.sell.Selectable = false, false
    return self
end
function HudView:sellBag()
    local state = self.state
    if state and state.hasStation and state.nearStation and state.profile.bag.fries &gt;= Economy.Capacity then self.send("Sell") end
end
function HudView:update(state)
    self.state = state
    local bag = state.profile.bag
    local full = bag.fries &gt;= Economy.Capacity
    local canPack = state.hasStation and state.nearStation and not full
    local canSell = state.hasStation and state.nearStation and full
    local perClick = state.stats.perClick
    local yieldText = "+" .. perClick .. (if perClick == 1 then " fry/click" else " fries/click")
    self.pack.Active, self.pack.Selectable = canPack, canPack
    self.sell.Active, self.sell.Selectable = canSell, canSell
    self.pack.BackgroundColor3 = if canPack and self.hovered then Theme.GoldLight else Theme.Gold
    self.packTitle.Text = if not state.hasStation then "CLAIM FIRST" elseif full then "BAG FULL"
        elseif not state.nearStation then "AT COUNTER" elseif self.hovered then "CLICK" else yieldText
    self.packTitle.TextSize = if not state.hasStation then 17 else 21
    self.packDetail.Text = if not state.hasStation then "CLAIM AT THE ENTRANCE" elseif full then "SELL TO KEEP PACKING"
        elseif not state.nearStation then "RETURN TO COUNTER" elseif self.hovered then string.upper(yieldText) else "TAP / HOLD TO PACK"
    self.sellTitle.Text = if full then "SELL BAG" else math.floor(bag.fries) .. " / " .. Economy.Capacity
    self.sellDetail.Text = if not state.hasStation then "CLAIM A RESTAURANT"
        elseif full and not state.nearStation then "RETURN TO COUNTER"
        elseif full then "+" .. E.money(state.stats.saleValue) .. " CASH"
        else "FRIES IN BAG"
    self.sell.BackgroundColor3 = if canSell then Theme.Green else Theme.Card
    self.sellTitle.TextColor3 = if canSell then Theme.Ink else Theme.Text
    self.sellDetail.TextColor3 = if canSell then Theme.Ink else Theme.Muted
    self.sellShortcut.TextColor3 = if canSell then Theme.Ink else Theme.Muted
    self.fill.BackgroundColor3 = if full then Theme.Green else Theme.Gold
    self.fill.Size = UDim2.fromScale(bag.fries / Economy.Capacity, 1)
end
return HudView
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00039">
            <Properties>
              <string name="Name">RestaurantGuides</string>
              <ProtectedString name="Source">local Theme = require(script.Parent.Theme)
local RestaurantGuides = {}
RestaurantGuides.__index = RestaurantGuides
local FLOW_CYCLES_PER_SECOND = 0.8
-- Reuse fade values rather than allocating a new sequence for every chevron each frame.
local fades = {}
for i = 0, 20 do fades[i] = NumberSequence.new(1 - 0.9 * i / 20) end

local function beam(parent, name, start, finish)
    local line = Instance.new("Beam")
    line.Name, line.Attachment0, line.Attachment1 = name, start, finish
    line.Width0, line.Width1, line.Segments = 0.22, 0.22, 1
    line.FaceCamera, line.LightInfluence, line.LightEmission = true, 0, 0.5
    line.Color, line.Transparency = ColorSequence.new(Theme.Gold), NumberSequence.new(0.1)
    line.Enabled, line.Parent = false, parent
    return line
end

local function chevron(parent, index)
    local points = {}
    for _, name in ipairs({"Left", "Tip", "Right"}) do
        local point = Instance.new("Attachment")
        point.Name, point.Parent = "Chevron" .. index .. name, parent
        points[name] = point
    end
    points.leftArm = beam(parent, "Chevron" .. index .. "LeftArm", points.Left, points.Tip)
    points.rightArm = beam(parent, "Chevron" .. index .. "RightArm", points.Right, points.Tip)
    return points
end

function RestaurantGuides.new()
    local folder = Instance.new("Folder")
    folder.Name, folder.Parent = "RestaurantGuides", workspace
    return setmetatable({ folder = folder, entries = {}, phase = 0 }, RestaurantGuides)
end

function RestaurantGuides:setTarget(index, entrance)
    local entry = self.entries[index]
    if entry and entry.entrance ~= entrance then
        entry.finish:Destroy()
        entry.base:Destroy()
        self.entries[index], entry = nil, nil
    end
    if not entrance or entry then return end
    local finish = Instance.new("Attachment")
    finish.Name, finish.Position, finish.Parent = "RestaurantGuideEnd", Vector3.new(0, 1, 0), entrance
    local base = Instance.new("Part")
    base.Name, base.Size = "ChevronGuide" .. index, Vector3.new(0.1, 0.1, 0.1)
    base.Anchored, base.Transparency = true, 1
    base.CanCollide, base.CanTouch, base.CanQuery, base.CastShadow = false, false, false, false
    base.Parent = self.folder
    self.entries[index] = { entrance = entrance, finish = finish, base = base, chevrons = {} }
end

function RestaurantGuides:step(character, dt)
    self.phase = (self.phase + math.max(dt or 0, 0) * FLOW_CYCLES_PER_SECOND) % 1
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local head = character and character:FindFirstChild("Head")
    if not humanoid or humanoid.Health &lt;= 0 or not next(self.entries) then head = nil end
    if self.head ~= head then
        if self.origin then self.origin:Destroy() end
        self.head, self.origin = head, nil
        if head then
            local origin = Instance.new("Attachment")
            origin.Name, origin.Position = "RestaurantGuideStart", Vector3.new(0, head.Size.Y / 2 + 1.5, 0)
            origin.Parent, self.origin = head, origin
        end
    end
    for _, entry in pairs(self.entries) do
        local count = 0
        if self.origin and entry.entrance.Parent then
            local finish = entry.finish.WorldPosition
            local delta = finish - self.origin.WorldPosition
            local length = delta.Magnitude
            if length &gt; 1 then
                entry.base.Position = self.origin.WorldPosition
                local direction = delta.Unit
                local camera = workspace.CurrentCamera
                local look = if camera and camera.CFrame then camera.CFrame.LookVector else Vector3.new(0, -1, 0)
                local side = direction:Cross(look)
                if side.Magnitude &lt; 0.001 then side = direction:Cross(Vector3.new(0, 1, 0)) end
                side = if side.Magnitude &lt; 0.001 then Vector3.new(1, 0, 0) else side.Unit
                count = math.clamp(math.floor(length / 6), 1, 24)
                local depth = math.min(1.8, length / 3)
                -- Reuse a bounded set of open &gt; shapes, with clear gaps and no connecting shaft.
                for i = 1, count do
                    local mark = entry.chevrons[i]
                    if not mark then mark = chevron(entry.base, i); entry.chevrons[i] = mark end
                    local distance = ((i - 0.5 + self.phase) % count) * length / count
                    local center = direction * distance
                    -- Fade and shrink at the ends so the looping pattern never jumps visibly
                    -- or extends beyond the player's head and the restaurant endpoint.
                    local edge = math.min(distance, length - distance)
                    local halfDepth = math.min(depth / 2, edge)
                    local rear = center - direction * halfDepth
                    mark.Tip.Position = center + direction * halfDepth
                    mark.Left.Position = rear + side * halfDepth
                    mark.Right.Position = rear - side * halfDepth
                    local fade = fades[math.floor(math.min(edge / depth, 1) * 20 + 0.5)]
                    mark.leftArm.Transparency, mark.rightArm.Transparency = fade, fade
                end
            end
        end
        for i, mark in ipairs(entry.chevrons) do
            mark.leftArm.Enabled, mark.rightArm.Enabled = i &lt;= count, i &lt;= count
        end
    end
end

return RestaurantGuides
</ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX00040">
            <Properties>
              <string name="Name">RestaurantMarkers</string>
              <ProtectedString name="Source">local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("FriesShared")
local Runtime = require(Shared.config.Runtime)
local E = require(script.Parent.Elements)
local Theme = require(script.Parent.Theme)
local RestaurantGuides = require(script.Parent.RestaurantGuides)
local RestaurantMarkers = {}
RestaurantMarkers.__index = RestaurantMarkers

function RestaurantMarkers.new(playerGui, userId)
    return setmetatable({ playerGui = playerGui, userId = userId, entries = {}, guides = RestaurantGuides.new() }, RestaurantMarkers)
end

function RestaurantMarkers:create(index, station)
    local gui = Instance.new("BillboardGui")
    gui.Name, gui.Size = "RestaurantMarker" .. index, UDim2.fromOffset(220, 104)
    gui.ResetOnSpawn, gui.AlwaysOnTop, gui.LightInfluence = false, true, 0
    gui.MaxDistance, gui.Enabled = 240, false
    gui.Parent = self.playerGui

    local available = E.box(gui, "Available", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), Theme.Background, 0)
    available.BackgroundTransparency = 1
    local caption = E.box(available, "Caption", UDim2.fromOffset(40, 0), UDim2.fromOffset(140, 28), Theme.Background, 10)
    E.stroke(caption, Theme.Gold, 1.5)
    local label = E.label(caption, "AVAILABLE", 28, Theme.Gold)
    label.Font, label.TextSize, label.TextXAlignment = Enum.Font.GothamBold, 13, Enum.TextXAlignment.Center

    local owner = E.box(gui, "Owner", UDim2.fromOffset(0, 14), UDim2.fromOffset(220, 76), Theme.Background, 16)
    E.stroke(owner, Theme.Gold, 2)
    local portrait = E.box(owner, "Portrait", UDim2.fromOffset(8, 8), UDim2.fromOffset(60, 60), Theme.Card, 30)
    local fallback = E.label(portrait, "?", 60, Theme.Gold)
    fallback.Name, fallback.TextSize, fallback.TextXAlignment = "Fallback", 30, Enum.TextXAlignment.Center
    local avatar = Instance.new("ImageLabel")
    avatar.Name, avatar.Size, avatar.BackgroundTransparency = "Avatar", UDim2.fromScale(1, 1), 1
    avatar.Image, avatar.Visible, avatar.Parent = "", false, portrait
    E.corner(avatar, 30)
    local title = E.label(owner, "RESTAURANT " .. index, 18, Theme.Muted)
    title.Position, title.Size, title.TextSize = UDim2.fromOffset(78, 14), UDim2.fromOffset(132, 18), 10
    local username = E.label(owner, "", 28, Theme.Text)
    username.Name, username.Position, username.Size = "Username", UDim2.fromOffset(78, 33), UDim2.fromOffset(132, 28)
    username.Font, username.TextScaled, username.TextWrapped = Enum.Font.GothamBold, true, false
    local limit = Instance.new("UITextSizeConstraint")
    limit.MinTextSize, limit.MaxTextSize, limit.Parent = 9, 15, username
    return { station = station, gui = gui, available = available, owner = owner,
        username = username, avatar = avatar, fallback = fallback, ownerId = 0, generation = 0, attempts = 0 }
end

function RestaurantMarkers:loadPortrait(entry)
    if entry.ownerId &lt;= 0 or entry.pending or entry.avatar.Visible or entry.attempts &gt;= 3
        or os.clock() &lt; (entry.nextAttempt or 0) then return end
    entry.pending, entry.attempts = true, entry.attempts + 1
    local ownerId, generation = entry.ownerId, entry.generation
    -- Thumbnail requests yield and can fail; they must never delay claiming or the HUD.
    task.spawn(function()
        local ok, content, ready = pcall(function()
            return Players:GetUserThumbnailAsync(ownerId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
        end)
        if not entry.gui.Parent or entry.generation ~= generation then return end
        entry.pending, entry.nextAttempt = false, os.clock() + 5
        if ok and ready and type(content) == "string" and content ~= "" then
            entry.avatar.Image, entry.avatar.Visible = content, true
            entry.fallback.Visible = false
        end
    end)
end

function RestaurantMarkers:update(hasStation)
    local world = workspace:FindFirstChild("FriesRestaurant")
    local ownsRestaurant = hasStation
    -- Replicated ownership also hides guidance while the private claim snapshot is in flight.
    for index = 1, Runtime.StationCount do
        local station = world and world:FindFirstChild("Station" .. index)
        if station and station:GetAttribute("OwnerUserId") == self.userId then ownsRestaurant = true end
    end
    for index = 1, Runtime.StationCount do
        local station = world and world:FindFirstChild("Station" .. index)
        local entry = self.entries[index]
        if entry and entry.station ~= station then
            entry.gui:Destroy()
            self.entries[index], entry = nil, nil
        end
        local entrance = station and station:FindFirstChild("ClaimPoint")
        local roof = station and station:FindFirstChild("RoofCap")
        local target = nil
        if entrance and roof then
            if not entry then entry = self:create(index, station); self.entries[index] = entry end
            local ownerId = station:GetAttribute("OwnerUserId") or 0
            if entry.ownerId ~= ownerId then
                entry.ownerId, entry.generation = ownerId, entry.generation + 1
                entry.pending, entry.attempts, entry.nextAttempt = false, 0, 0
                entry.avatar.Image, entry.avatar.Visible, entry.fallback.Visible = "", false, true
            end
            local claimed = ownerId ~= 0
            entry.owner.Visible, entry.available.Visible = claimed, not claimed and not ownsRestaurant
            if not claimed and not ownsRestaurant then target = entrance end
            entry.gui.Enabled = claimed or not ownsRestaurant
            entry.gui.Adornee = if claimed then roof else entrance
            entry.gui.StudsOffsetWorldSpace = Vector3.new(0, if claimed then 4 else 3, 0)
            if claimed then
                local username = station:GetAttribute("OwnerUsername") or "Player"
                entry.username.Text = "@" .. username
                entry.fallback.Text = string.upper(string.sub(username, 1, 1))
                self:loadPortrait(entry)
            end
        elseif entry then
            entry.gui.Enabled = false
        end
        self.guides:setTarget(index, target)
    end
end

return RestaurantMarkers
</ProtectedString>
            </Properties>
          </Item>
